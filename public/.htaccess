# ============================================
# USTADI Foundation — Production .htaccess
# ============================================

# Prevent directory browsing and set default index
Options -Indexes +SymLinksIfOwnerMatch
DirectoryIndex index.html

# Fallback error page for LiteSpeed/Apache Web Server
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Direct file requests (e.g., CSS, JS, images, PDFs) serve normally
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Existing directories with index.html serve directly
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 3. Clean URLs: Map /about to /about/index.html (Astro folder structure)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 4. Serve custom Astro /404.html for all non-existent paths
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteRule ^ /404.html [L]
</IfModule>