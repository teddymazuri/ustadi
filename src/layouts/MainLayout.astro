---
// MainLayout.astro — Site-wide page chrome
// Composes BaseLayout with SkipLink, Navbar, Footer, BackToTop
// Contains site-wide business content: nav links, footer links, social URLs
// Pages use this layout and inject only their page-specific content
import BaseLayout from './BaseLayout.astro';
import SkipLink from '../components/global/SkipLink.astro';
import Navbar from '../components/global/Navbar.astro';
import Footer from '../components/global/Footer.astro';
import BackToTop from '../components/global/BackToTop.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
  currentPage?: string;
}

const { title, description, image, noIndex, currentPage } = Astro.props;

// Helper function to build clean base-aware internal URLs
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;

interface NavLink {
  label: string;
  href: string;
  key: string;
}

const navLinks: NavLink[] = [
  { label: 'About', href: getUrl('/about'), key: 'about' },
  { label: 'Programs', href: getUrl('/programs'), key: 'programs' },
  { label: 'Projects', href: getUrl('/projects'), key: 'projects' },
  { label: 'Impact', href: getUrl('/impact'), key: 'impact' },
  { label: 'News', href: getUrl('/news'), key: 'news' },
  { label: 'Contact', href: getUrl('/contact'), key: 'contact' },
];

function isActive(key: string): boolean {
  if (!currentPage) return false;
  return currentPage === key;
}

function navLinkClass(active: boolean): string {
  const baseClass = 'relative px-3 py-2 text-sm font-medium rounded-lg no-underline';
  const state = active
    ? 'text-primary bg-primary/5'
    : 'text-dark/70 hover:text-primary hover:bg-gray-light/50';
  return `${baseClass} ${state}`;
}

function mobileNavLinkClass(active: boolean): string {
  const baseClass = 'block px-4 py-3 text-base font-medium rounded-lg no-underline';
  const state = active
    ? 'text-primary bg-primary/5'
    : 'text-dark/70 hover:text-primary hover:bg-gray-light/50';
  return `${baseClass} ${state}`;
}

const logoUrl = getUrl('/images/logo/ustadi-logo.svg');
---

<BaseLayout title={title} description={description} image={image} noIndex={noIndex}>
  <SkipLink />

  <Navbar>
    <!-- Logo -->
    <a
      slot="logo"
      href={getUrl('/')}
      class="flex items-center no-underline"
      aria-label="USTADI Foundation — Return to homepage"
    >
      <img
        src={logoUrl}
        alt="USTADI Foundation"
        class="h-10 md:h-12 w-auto"
      />
    </a>

    <!-- Desktop nav links -->
    <slot slot="nav-links" name="nav-links">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={navLinkClass(isActive(link.key))}
          aria-current={isActive(link.key) ? 'page' : undefined}
        >
          {link.label}
          {isActive(link.key) && (
            <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-6 h-0.5 bg-accent rounded-full" aria-hidden="true" />
          )}
        </a>
      ))}
    </slot>

    <!-- Desktop CTA -->
    <a
      slot="cta"
      href={getUrl('/donate')}
      class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-accent rounded-lg hover:bg-accent/90 no-underline shadow-sm hover:shadow-md"
    >
      Donate
    </a>

    <!-- Mobile nav links -->
    <slot slot="mobile-links" name="mobile-links">
      {navLinks.map((link) => (
        <a
          href={link.href}
          class={mobileNavLinkClass(isActive(link.key))}
          aria-current={isActive(link.key) ? 'page' : undefined}
        >
          {link.label}
        </a>
      ))}
    </slot>

    <!-- Mobile CTA -->
    <a
      slot="mobile-cta"
      href={getUrl('/donate')}
      class="flex items-center justify-center w-full px-6 py-3 text-base font-semibold text-white bg-accent rounded-lg hover:bg-accent/90 no-underline"
    >
      Donate
    </a>
  </Navbar>

  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <Footer>
    <!-- Brand Column -->
    <div slot="columns" class="lg:col-span-4">
      <a href={getUrl('/')} class="inline-block mb-6 no-underline" aria-label="USTADI Foundation — Home">
        <img
          src={logoUrl}
          alt="USTADI Foundation"
          class="h-12 w-auto"
        />
      </a>
      <p class="text-sm text-dark/60 mb-6 max-w-xs" style="line-height: var(--text-body-sm--line-height);">
        Promoting transformation and growth of youth and women enterprises through demand-driven professional capacity development across Kenya.
      </p>
      <div class="flex gap-3" aria-label="Social media">
        {[
          {
            label: 'Facebook',
            href: 'https://facebook.com/USTADIFoundation',
            path: 'M22 12c0-5.523-4.477-10-10-10S2 6.477 2 12c0 4.991 3.657 9.128 8.438 9.878v-6.987h-2.54V12h2.54V9.797c0-2.506 1.492-3.89 3.777-3.89 1.094 0 2.238.195 2.238.195v2.46h-1.26c-1.243 0-1.63.771-1.63 1.562V12h2.773l-.443 2.89h-2.33v6.988C18.343 21.128 22 16.991 22 12z',
          },
          {
            label: 'Twitter',
            href: 'https://twitter.com/USTADI_Fdn',
            path: 'M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84',
          },
          {
            label: 'YouTube',
            href: 'https://youtube.com/@USTADIFoundation',
            path: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
          },
          {
            label: 'LinkedIn',
            href: 'https://linkedin.com/company/ustadi-foundation',
            path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
          },
        ].map(({ label, href, path }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center rounded-full bg-dark/5 text-dark/50 hover:bg-primary hover:text-white no-underline"
            aria-label={label}
          >
            <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d={path} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Quick Links -->
    <div slot="columns" class="lg:col-span-2">
      <h3 class="font-heading text-lg font-semibold mb-5 text-dark">Quick Links</h3>
      <ul class="space-y-2.5" role="list">
        <li><a href={getUrl('/about')} class="text-sm text-dark/60 hover:text-primary no-underline">About Us</a></li>
        <li><a href={getUrl('/programs')} class="text-sm text-dark/60 hover:text-primary no-underline">Programs</a></li>
        <li><a href={getUrl('/projects')} class="text-sm text-dark/60 hover:text-primary no-underline">Projects</a></li>
        <li><a href={getUrl('/impact')} class="text-sm text-dark/60 hover:text-primary no-underline">Our Impact</a></li>
        <li><a href={getUrl('/partners')} class="text-sm text-dark/60 hover:text-primary no-underline">Partners</a></li>
        <li><a href={getUrl('/news')} class="text-sm text-dark/60 hover:text-primary no-underline">News</a></li>
      </ul>
    </div>

    <!-- Get Involved -->
    <div slot="columns" class="lg:col-span-2">
      <h3 class="font-heading text-lg font-semibold mb-5 text-dark">Get Involved</h3>
      <ul class="space-y-2.5" role="list">
        <li><a href={getUrl('/donate')} class="text-sm text-dark/60 hover:text-primary no-underline">Donate</a></li>
        <li><a href={getUrl('/get-involved')} class="text-sm text-dark/60 hover:text-primary no-underline">Volunteer</a></li>
        <li><a href={getUrl('/partners')} class="text-sm text-dark/60 hover:text-primary no-underline">Partner With Us</a></li>
        <li><a href={getUrl('/contact')} class="text-sm text-dark/60 hover:text-primary no-underline">Contact</a></li>
      </ul>
    </div>

    <!-- Newsletter & Contact -->
    <div slot="columns" class="lg:col-span-4">
      <h3 class="font-heading text-lg font-semibold mb-5 text-dark">Stay Connected</h3>
      <p class="text-sm text-dark/60 mb-4" style="line-height: var(--text-body-sm--line-height);">
        Subscribe to receive updates on our work, impact stories, and opportunities.
      </p>

      <form class="flex flex-col sm:flex-row gap-2 mb-6" action="https://formspree.io/f/your-form-id" method="POST">
        <label for="footer-email" class="sr-only">Your email address</label>
        <input
          type="email"
          name="email"
          id="footer-email"
          placeholder="your@email.com"
          required
          autocomplete="email"
          class="flex-1 px-4 py-2.5 bg-white border border-dark/10 rounded-lg text-dark placeholder:text-dark/30 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
        />
        <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
        <button
          type="submit"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-light shrink-0"
        >
          Subscribe
        </button>
      </form>

      <div class="space-y-2">
        <p class="text-sm text-dark/60 flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-dark/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          info@ustadi.org
        </p>
        <p class="text-sm text-dark/60 flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-dark/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Nairobi, Kenya
        </p>
      </div>
    </div>

    <!-- Legal Links -->
    <a slot="legal-links" href={getUrl('/privacy-policy')} class="text-sm text-dark/50 hover:text-primary no-underline">Privacy Policy</a>
    <a slot="legal-links" href={getUrl('/terms')} class="text-sm text-dark/50 hover:text-primary no-underline">Terms of Service</a>
  </Footer>

  <BackToTop />
</BaseLayout>