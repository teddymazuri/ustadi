---
// MainLayout.astro — Site-wide page chrome
// Composes BaseLayout with SkipLink, Navbar, Footer, BackToTop
// Contains site-wide business content: nav links, footer links, social URLs
// Pages use this layout and inject only their page-specific content
import BaseLayout from './BaseLayout.astro';
import SkipLink from '../components/global/SkipLink.astro';
import Navbar from '../components/global/Navbar.astro';
import NavDropdown from '../components/global/NavDropdown.astro';
import MobileAccordion from '../components/global/MobileAccordion.astro';
import Footer from '../components/global/Footer.astro';
import BackToTop from '../components/global/BackToTop.astro';

export interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
  currentPage?: string;
}

const { title, description, image, noIndex, currentPage } = Astro.props;

// Helper function to build clean base-aware internal URLs
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;

function isActive(key: string): boolean {
  if (!currentPage) return false;
  if (key === 'about') return currentPage.startsWith('about');
  if (key === 'what-we-do') return currentPage === 'programs' || currentPage === 'projects';
  if (key === 'news') return currentPage === 'news';
  if (key === 'stories') return currentPage === 'success-stories';
  if (key === 'resources') return currentPage === 'resources';
  return currentPage === key;
}

function navLinkClass(active: boolean): string {
  const baseClass = 'relative px-3 py-2 text-sm font-medium rounded-lg no-underline';
  const state = active
    ? 'text-primary bg-primary/5'
    : 'text-dark/70 hover:text-primary hover:bg-gray-light/50';
  return `${baseClass} ${state}`;
}

function mobileNavLinkClass(active: boolean): string {
  const baseClass = 'block px-4 py-3 text-base font-medium rounded-lg no-underline';
  const state = active
    ? 'text-primary bg-primary/5'
    : 'text-dark/70 hover:text-primary hover:bg-gray-light/50';
  return `${baseClass} ${state}`;
}

const logoUrl = getUrl('/images/logo/ustadi-logo.svg');
---

<BaseLayout title={title} description={description} image={image} noIndex={noIndex}>
  <SkipLink />

  <Navbar>
    <!-- Logo -->
    <a
      slot="logo"
      href={getUrl('/')}
      class="flex items-center no-underline"
      aria-label="USTADI Foundation — Return to homepage"
    >
      <img
        src={logoUrl}
        alt="USTADI Foundation"
        class="h-10 md:h-12 w-auto"
      />
    </a>

    <!-- Desktop nav links -->
    <slot slot="nav-links" name="nav-links">
      <!-- About Us dropdown -->
      <NavDropdown
        id="about"
        label="About Us"
        intro={{
          description: 'A Kenyan organization promoting transformation and growth of youth and women enterprises since 2011.',
        }}
        columns={[
          {
            title: 'History & Impact',
            links: [
              { label: 'Mission & Vision', href: getUrl('/about/mission-vision') },
              { label: 'History', href: getUrl('/about/history') },
              { label: 'Impact', href: getUrl('/impact') },
            ],
          },
          {
            title: 'Personnel & Offices',
            links: [
              { label: 'Governance & Management', href: getUrl('/about/governance') },
              { label: 'Offices', href: getUrl('/about/offices') },
            ],
          },
          {
            title: 'Work With Us',
            links: [
              { label: 'Careers', href: getUrl('/about/careers') },
              { label: 'Volunteer', href: getUrl('/get-involved') },
              { label: 'Partner With Us', href: getUrl('/partners') },
            ],
          },
        ]}
      />

      <!-- What We Do dropdown -->
      <NavDropdown
        id="what-we-do"
        label="What We Do"
        intro={{
          description: 'Driving youth employment, value chain expansion, and enterprise growth through demand driven capacity development across Kenya.',
        }}
        columns={[
          {
            title: 'What We Support',
            links: [
              { label: 'Programs', href: getUrl('/programs') },
              { label: 'Projects', href: getUrl('/projects') },
            ],
          },
          {
            title: 'Focus Areas',
            links: [
              { label: 'Value Chains', href: getUrl('/value-chains') },
            ],
          },
        ]}
      />

      <!-- Resources dropdown -->
      <NavDropdown
        id="resources"
        label="Resources"
        intro={{
          description: 'We capture, document, and share practical insights to bridge critical knowledge gaps in youth employment and enterprise growth. Access our field tested toolkits, rigorous evaluations and project publications.',
        }}
        columns={[
          {
            title: 'Resources',
            links: [
              { label: 'Reports', href: getUrl('/resources/reports') },
              { label: 'Media', href: getUrl('/resources/media') },
            ],
          },
        ]}
      />

      <!-- News dropdown -->
      <NavDropdown
        id="news"
        label="News"
        intro={{
          description: 'Read press releases and organization updates.',
        }}
        columns={[
          {
            title: 'News',
            links: [
              { label: 'Latest News', href: getUrl('/news') },
            ],
          },
        ]}
      />

      <!-- Stories dropdown -->
      <NavDropdown
        id="stories"
        label="Stories"
        intro={{
          description: 'Read real stories from youth and women entrepreneurs whose lives have been transformed through USTADI\'s programmes.',
        }}
        columns={[
          {
            title: 'Stories',
            links: [
              { label: 'Success Stories', href: getUrl('/success-stories') },
            ],
          },
        ]}
      />

      <!-- Contact direct link -->
      <a
        href={getUrl('/contact')}
        class={navLinkClass(isActive('contact'))}
        aria-current={isActive('contact') ? 'page' : undefined}
      >
        Contact
        {isActive('contact') && (
          <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-6 h-0.5 bg-accent rounded-full" aria-hidden="true" />
        )}
      </a>
    </slot>

    <!-- Desktop CTA -->
    <a
      slot="cta"
      href={getUrl('/donate')}
      class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-accent rounded-lg hover:bg-accent/90 no-underline shadow-sm hover:shadow-md"
    >
      Donate
    </a>

    <!-- Mobile nav links -->
    <slot slot="mobile-links" name="mobile-links">
      <MobileAccordion
        id="mobile-about"
        label="About Us"
        items={[
          { label: 'Mission & Vision', href: getUrl('/about/mission-vision') },
          { label: 'History', href: getUrl('/about/history') },
          { label: 'Impact', href: getUrl('/impact') },
          { label: 'Governance & Management', href: getUrl('/about/governance') },
          { label: 'Offices', href: getUrl('/about/offices') },
          { label: 'Careers', href: getUrl('/about/careers') },
          { label: 'Volunteer', href: getUrl('/get-involved') },
          { label: 'Partner With Us', href: getUrl('/partners') },
        ]}
      />

      <MobileAccordion
        id="mobile-what-we-do"
        label="What We Do"
        items={[
          { label: 'Programs', href: getUrl('/programs') },
          { label: 'Projects', href: getUrl('/projects') },
          { label: 'Value Chains', href: getUrl('/value-chains') },
        ]}
      />

      <MobileAccordion
        id="mobile-resources"
        label="Resources"
        items={[
          { label: 'Reports', href: getUrl('/resources/reports') },
          { label: 'Media', href: getUrl('/resources/media') },
        ]}
      />

      <MobileAccordion
        id="mobile-news"
        label="News"
        items={[
          { label: 'Latest News', href: getUrl('/news') },
        ]}
      />

      <MobileAccordion
        id="mobile-stories"
        label="Stories"
        items={[
          { label: 'Success Stories', href: getUrl('/success-stories') },
        ]}
      />

      <a
        href={getUrl('/contact')}
        class={mobileNavLinkClass(isActive('contact'))}
        aria-current={isActive('contact') ? 'page' : undefined}
      >
        Contact
      </a>
    </slot>

    <!-- Mobile CTA -->
    <a
      slot="mobile-cta"
      href={getUrl('/donate')}
      class="flex items-center justify-center w-full px-6 py-3 text-base font-semibold text-white bg-accent rounded-lg hover:bg-accent/90 no-underline"
    >
      Donate
    </a>
  </Navbar>

  <main id="main-content" class="flex-1">
    <slot />
  </main>

  <Footer>
    <!-- Brand Column -->
    <div slot="columns" class="lg:col-span-4">
      <a href={getUrl('/')} class="inline-block mb-6 no-underline" aria-label="USTADI Foundation — Home">
        <img
          src={logoUrl}
          alt="USTADI Foundation"
          class="h-12 w-auto"
        />
      </a>
      <p class="text-sm text-dark/60 mb-6 max-w-xs" style="line-height: var(--text-body-sm--line-height);">
        Promoting transformation and growth of youth and women enterprises through demand-driven professional capacity development across Kenya.
      </p>
      <div class="flex gap-3" aria-label="Social media">
        {[
          {
            label: 'Facebook',
            href: 'https://facebook.com/USTADIfoundation/',
            path: 'M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z',
          },
          {
            label: 'X (Twitter)',
            href: 'https://x.com/USTADI_Fndtn',
            path: 'M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z',
          },
          {
            label: 'LinkedIn',
            href: 'https://linkedin.com/company/ustadifoundation/',
            path: 'M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z',
          },
          {
            label: 'Instagram',
            href: 'https://instagram.com/ustadifoundation/',
            path: 'M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z',
          },
          {
            label: 'YouTube',
            href: 'https://youtube.com/@ustadifdtn',
            path: 'M23.498 6.186a3.016 3.016 0 00-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 00.502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 002.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 002.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z',
          },
          ].map(({ label, href, path }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            class="w-10 h-10 flex items-center justify-center rounded-full bg-dark/5 text-dark/50 hover:bg-primary hover:text-white no-underline transition-colors duration-200"
            aria-label={label}
          >
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d={path} />
            </svg>
          </a>
        ))}
      </div>
    </div>

    <!-- Resources -->
    <div slot="columns" class="lg:col-span-2">
      <h3 class="font-heading text-lg font-semibold mb-5 text-dark">Resources</h3>
      <ul class="space-y-2.5" role="list">
        <li><a href={getUrl('/resources/reports')} class="text-sm text-dark/60 hover:text-primary no-underline">Reports</a></li>
        <li><a href={getUrl('/resources/media')} class="text-sm text-dark/60 hover:text-primary no-underline">Media</a></li>
        <li><a href={getUrl('/news')} class="text-sm text-dark/60 hover:text-primary no-underline">Latest News</a></li>
        <li><a href={getUrl('/success-stories')} class="text-sm text-dark/60 hover:text-primary no-underline">Success Stories</a></li>
      </ul>
    </div>

    <!-- Get Involved -->
    <div slot="columns" class="lg:col-span-2">
      <h3 class="font-heading text-lg font-semibold mb-5 text-dark">Get Involved</h3>
      <ul class="space-y-2.5" role="list">
        <li><a href={getUrl('/donate')} class="text-sm text-dark/60 hover:text-primary no-underline">Donate</a></li>
        <li><a href={getUrl('/get-involved')} class="text-sm text-dark/60 hover:text-primary no-underline">Volunteer</a></li>
        <li><a href={getUrl('/partners')} class="text-sm text-dark/60 hover:text-primary no-underline">Partner With Us</a></li>
        <li><a href={getUrl('/contact')} class="text-sm text-dark/60 hover:text-primary no-underline">Contact</a></li>
      </ul>
    </div>

    <!-- Newsletter & Contact -->
    <div slot="columns" class="lg:col-span-4">
      <h3 class="font-heading text-lg font-semibold mb-5 text-dark">Stay Connected</h3>
      <p class="text-sm text-dark/60 mb-4" style="line-height: var(--text-body-sm--line-height);">
        Subscribe to receive updates on our work, impact stories, and opportunities.
      </p>

      <!-- Footer newsletter success -->
      <div id="footer-newsletter-success" class="hidden mb-4 bg-green-50 border-2 border-green-200 rounded-xl px-4 py-2.5">
        <p class="text-green-700 font-semibold text-sm">Subscribed! You're on the list.</p>
      </div>

      <!-- Footer newsletter error -->
      <div id="footer-newsletter-error" class="hidden mb-4 bg-red-50 border-2 border-red-200 rounded-xl px-4 py-2.5">
        <p class="text-red-700 font-semibold text-sm">Something went wrong. Please try again.</p>
      </div>

      <form class="flex flex-col sm:flex-row gap-2 mb-6" action="https://formspree.io/f/xeajyvvp" method="POST" id="footer-newsletter-form">
        <label for="footer-email" class="sr-only">Your email address</label>
        <input
          type="email"
          name="email"
          id="footer-email"
          placeholder="your@email.com"
          required
          autocomplete="email"
          class="flex-1 px-4 py-2.5 bg-white border border-dark/10 rounded-lg text-dark placeholder:text-dark/30 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
        />
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
        <button
          type="submit"
          id="footer-newsletter-submit-btn"
          class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-primary rounded-lg hover:bg-primary-light shrink-0"
        >
          Subscribe
        </button>
      </form>

      <div class="space-y-2">
        <p class="text-sm text-dark/60 flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-dark/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          info@ustadi.org
        </p>
        <p class="text-sm text-dark/60 flex items-center gap-2">
          <svg class="w-4 h-4 shrink-0 text-dark/30" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          Nairobi, Kenya
        </p>
      </div>
    </div>

    <!-- Legal Links -->
    <a slot="legal-links" href={getUrl('/privacy-policy')} class="text-sm text-dark/50 hover:text-primary no-underline">Privacy Policy</a>
    <a slot="legal-links" href={getUrl('/terms')} class="text-sm text-dark/50 hover:text-primary no-underline">Terms of Service</a>
  </Footer>

  <BackToTop />
</BaseLayout>

<script>
  const footerForm = document.getElementById('footer-newsletter-form');
  const footerSuccessMsg = document.getElementById('footer-newsletter-success');
  const footerErrorMsg = document.getElementById('footer-newsletter-error');
  const footerSubmitBtn = document.getElementById('footer-newsletter-submit-btn');

  footerForm?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    footerSuccessMsg?.classList.add('hidden');
    footerErrorMsg?.classList.add('hidden');
    
    const originalText = footerSubmitBtn?.textContent;
    footerSubmitBtn!.textContent = 'Subscribing...';
    footerSubmitBtn!.disabled = true;

    const formData = new FormData(footerForm);

    try {
      const response = await fetch('https://formspree.io/f/xeajyvvp', {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        footerForm.reset();
        footerSuccessMsg?.classList.remove('hidden');
      } else {
        footerErrorMsg?.classList.remove('hidden');
      }
    } catch (err) {
      footerErrorMsg?.classList.remove('hidden');
    } finally {
      footerSubmitBtn!.textContent = originalText;
      footerSubmitBtn!.disabled = false;
    }
  });
</script>