---
// BaseLayout.astro — Pure HTML/SEO shell
// No business content. No page chrome. No components.
// Provides: doctype, <head>, SEO metadata, fonts, <body> with slot
export interface Props {
  title: string;
  description: string;
  image?: string;
  noIndex?: boolean;
}

const {
  title,
  description,
  image = '/images/ustadi-og-default.jpg',
  noIndex = false,
} = Astro.props;

const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site).href : '';
const ogImageURL = Astro.site ? new URL(image, Astro.site).href : '';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>{title} | Ustadi Foundation</title>
    <meta name="description" content={description} />

    {canonicalURL && <link rel="canonical" href={canonicalURL} />}

    {noIndex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}

    <meta property="og:title" content={`${title} | Ustadi Foundation`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonicalURL && <meta property="og:url" content={canonicalURL} />}
    {ogImageURL && <meta property="og:image" content={ogImageURL} />}
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="Ustadi Foundation" />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Ustadi Foundation`} />
    <meta name="twitter:description" content={description} />
    {ogImageURL && <meta name="twitter:image" content={ogImageURL} />}

    {Astro.site && (
      <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "NGO",
        "name": "Ustadi Foundation",
        "url": Astro.site,
        "description": description,
        "email": "info@ustadi.org",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Nairobi",
          "addressCountry": "KE"
        }
      })}>
      </script>
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400..700&family=Playfair+Display:wght@400..800&display=swap"
      rel="stylesheet"
    />

    <link rel="stylesheet" href="/src/styles/global.css" />
  </head>

  <body class="min-h-screen flex flex-col antialiased">
    <slot />
  </body>
</html>