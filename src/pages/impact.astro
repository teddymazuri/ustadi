---
// Impact page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024)
import MainLayout from '../layouts/MainLayout.astro';
import ImpactHero from '../components/impact/ImpactHero.astro';
import ImpactStatsGrid from '../components/impact/ImpactStatsGrid.astro';
import ProjectOutcomes from '../components/impact/ProjectOutcomes.astro';
import ApproachToImpact from '../components/impact/ApproachToImpact.astro';
import ImpactCTA from '../components/impact/ImpactCTA.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="Our Impact"
  description="USTADI Foundation has reached over 350,000 rural households and 300+ youth groups across 20+ counties in Kenya through demand-driven capacity development projects."
  currentPage="impact"
>
  <!-- 1. Hero with highlight stat -->
  <ImpactHero
    headline="Measuring what matters: sustainable change for rural communities"
    subheadline="USTADI builds strong monitoring and evaluation into every project. The knowledge gap for what works and why in youth employment is large — contributing to filling this gap is a main objective of our work."
    highlightStat={{
      value: '350,000+',
      label: 'Rural households reached with crucial capacity development support',
    }}
  />

  <!-- 2. Key Statistics Grid -->
  <ImpactStatsGrid
    heading="Impact in Numbers"
    stats={[
      { value: '350,000+', label: 'Rural households reached' },
      { value: '300+', label: 'Youth groups, CSOs, and self-help groups engaged' },
      { value: '20+', label: 'Counties with active programming' },
      { value: '12', label: 'Implementing partners and hosts' },
      { value: '10+', label: 'Funding partners' },
      { value: '20', label: 'County government partners' },
      { value: '1,171', label: 'Jobs created through Y2YF alone' },
      { value: '10,000+', label: 'Smallholder farmers trained in cassava value chain' },
    ]}
  />

  <!-- 3. Project Outcomes -->
  <ProjectOutcomes
    heading="Project Outcomes"
    subheading="Verified results from USTADI's major initiatives."
    outcomes={[
      {
        project: 'VIJABIZ Project',
        metric: '173 youth groups supported',
        description: 'Over 1,550 direct participants across Kilifi and Nakuru counties, with 30% female participation. 72 agri-enterprises received grants to improve their businesses in cereals, dairy, and fisheries value chains.',
      },
      {
        project: 'Y2YF Project',
        metric: '1,171 jobs created',
        description: '34 youth-led organisations received grants from 486 proposals nationwide. Reached 2,558 direct and over 10,000 indirect beneficiaries across 11 counties in sectors from agriculture to renewable energy.',
      },
      {
        project: 'Cassava Value Chain Project',
        metric: '10,000+ farmers reached',
        description: '450 farmer business groups established with at least 60% women participation. 9,500 farmers trained on sustainable agricultural practices, post-harvest handling, and farming as a business. 100 aggregation centres created.',
      },
      {
        project: 'JOY Project',
        metric: '3 counties, multiple hubs',
        description: 'Establishing integrated agribusiness hubs in Kilifi, Kakamega, and Nakuru counties. Building youth capacity through training of trainers programmes, technical support, and access to land, water, and technologies.',
      },
      {
        project: 'K-SALES Project',
        metric: 'Improved livestock value chains',
        description: 'Enhanced the competitiveness of cattle, sheep, and goat meat value chains in Kenya\'s semi-arid regions, strengthening market linkages and improving livestock management practices.',
      },
      {
        project: 'Afya Pwani Project',
        metric: 'Improved WaSH in Kilifi',
        description: 'Increased access to clean water, sanitation facilities, and hygiene promotion in Kilifi County communities.',
      },
    ]}
  />

  <!-- 4. Approach to Impact Measurement -->
  <ApproachToImpact
    heading="How We Measure Impact"
    body="USTADI has strong expertise and specialized knowledge in designing and conducting rigorous impact evaluations. Every project is built on strong monitoring bases and incorporates best practices from the youth development community."
    pillars={[
      {
        title: 'Organisational Capacity Assessments',
        description: 'We carry out OCAs for partner organisations to establish baselines and track institutional growth over time.',
      },
      {
        title: 'Knowledge Capitalisation',
        description: 'Best practices and innovations are identified, documented, and shared to fill the knowledge gap on what works in youth employment.',
      },
      {
        title: 'Impact Evaluation',
        description: 'Rigorous evaluations measure outcomes against baselines, ensuring accountability and continuous learning across all projects.',
      },
    ]}
  />

  <!-- 5. CTA -->
  <ImpactCTA
    heading="Help us create more impact"
    body="Every contribution supports demand-driven capacity development that transforms livelihoods for rural youth and women across Kenya."
    primaryCta={{ label: 'Make a donation', href: getUrl('/donate') }}
    secondaryCta={{ label: 'Partner with us', href: getUrl('/contact') }}
  />
</MainLayout>