---
// Impact page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024)
import MainLayout from '../layouts/MainLayout.astro';
import ImpactHero from '../components/impact/ImpactHero.astro';
import ImpactStatsGrid from '../components/impact/ImpactStatsGrid.astro';
import ProjectOutcomes from '../components/impact/ProjectOutcomes.astro';
import ApproachToImpact from '../components/impact/ApproachToImpact.astro';
import ImpactCTA from '../components/impact/ImpactCTA.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="Our Impact"
  description="USTADI Foundation has reached over 350,000 rural households and 300+ youth groups across 20+ counties in Kenya through demand-driven capacity development projects."
  currentPage="impact"
>
  <!-- 1. Hero with highlight stat -->
  <ImpactHero
    headline="Measuring what matters: sustainable change for rural communities"
    subheadline="USTADI embeds rigorous monitoring and evaluation across every initiative. A primary goal of our work is bridging the critical knowledge gap around what drives long term success in youth employment."
    highlightStat={{
      value: '500,000+',
      label: 'Rural households reached with crucial capacity development support',
    }}
  />

  <!-- 2. Key Statistics Grid -->
  <ImpactStatsGrid
    heading="Impact in Numbers"
    stats={[
      { value: '500,000+', label: 'Rural households reached with crucial capacity development support' },
      { value: '300+', label: 'Youth groups, CSOs, and self-help groups engaged' },
      { value: '20+', label: 'Counties with active programming' },
      { value: '12', label: 'Implementing partners and hosts' },
      { value: '10+', label: 'Funding partners' },
      { value: '20', label: 'County government partners' },
      { value: '1,171', label: 'Jobs created through Y2YF alone' },
      { value: '10,000+', label: 'Smallholder farmers trained in cassava value chain' },
    ]}
  />

  <!-- 3. Project Outcomes -->
  <ProjectOutcomes
    heading="Project Outcomes"
    subheading="Verified results from USTADI donor funded initiatives."
    outcomes={[
      {
        project: 'VIJABIZ Project',
        metric: '173 youth groups supported',
        description: 'Engaged over 1,550 direct participants across Kilifi and Nakuru counties, achieving 30% female participation. Awarded direct growth grants to 72 agri-enterprises across the cereals, dairy, and fisheries value chains.',
      },
      {
        project: 'Y2YF Project',
        metric: '1,171 jobs created',
        description: 'Awarded grants to 34 youth led organizations selected from 486 nationwide proposals. Reached 2,558 direct and over 10,000 indirect beneficiaries across 11 counties in sectors ranging from agriculture to renewable energy.',
      },
      {
        project: 'Cassava Value Chain Project',
        metric: '10,000+ farmers reached',
        description: 'Established 450 farmer business groups with at least 60% women participation. Trained 9,500 farmers on sustainable agricultural practices, post harvest handling, and farming as a business while creating 100 aggregation centres.',
      },
      {
        project: 'JOY Project',
        metric: '3 counties, multiple hubs',
        description: 'Establishing integrated agribusiness hubs across Kilifi, Kakamega, and Nakuru counties to build youth capacity through training of trainers programs, technical support, and access to land, water, and modern technologies',
      },
      {
        project: 'K-SALES Project',
        metric: 'Improved livestock value chains',
        description: 'Enhanced the competitiveness of cattle, sheep, and goat meat value chains in semi arid regions of Kenya, strengthening market linkages and improving livestock management practices.',
      },
      {
        project: 'Afya Pwani Project',
        metric: 'Improved WaSH in Kilifi',
        description: 'Expanded access to clean water, sanitation facilities, and hygiene promotion across local communities in Kilifi County.',
      },
    ]}
  />

  <!-- 4. Approach to Impact Measurement -->
  <ApproachToImpact
    heading="How We Measure Impact"
    body="USTADI applies specialized expertise in designing and conducting rigorous impact evaluations. Every project builds on a solid monitoring foundation and integrates proven best practices from the global youth development sector."
    pillars={[
      {
        title: 'Organisational Capacity Assessments',
        description: 'We conduct OCAs for partner organizations to establish initial baselines and track institutional growth over time.',
      },
      {
        title: 'Knowledge Capitalisation',
        description: 'We capture, document, and share best practices and innovations to bridge critical knowledge gaps on what drives sustainable youth employment.',
      },
      {
        title: 'Impact Evaluation',
        description: 'Rigorous evaluations measure long term outcomes against baselines, ensuring complete accountability and continuous learning across all initiatives.',
      },
    ]}
  />

  <!-- 5. CTA -->
  <ImpactCTA
    heading="Help us create more impact"
    body="Every partnership supports demand driven capacity development that transforms livelihoods for rural youth and women across Kenya."
    primaryCta={{ label: 'Make a donation', href: getUrl('/donate') }}
    secondaryCta={{ label: 'Partner with us', href: getUrl('/contact') }}
  />
</MainLayout>