const getSlug = (name: string) => name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');

const typeColors: Record<string, string> = {
  'Baseline': 'bg-blue-50 text-blue-600 border-blue-200',
  'Review': 'bg-purple-50 text-purple-600 border-purple-200',
  'Report': 'bg-gray-50 text-gray-600 border-gray-200',
  'Study': 'bg-green-50 text-green-600 border-green-200',
  'Impact': 'bg-orange-50 text-orange-600 border-orange-200',
  'Case Study': 'bg-pink-50 text-pink-600 border-pink-200',
  'Best Practice': 'bg-emerald-50 text-emerald-600 border-emerald-200',
  'Manual': 'bg-yellow-50 text-yellow-600 border-yellow-200',
  'Framework': 'bg-indigo-50 text-indigo-600 border-indigo-200',
};
---

<MainLayout
  title="Reports"
  description="Download USTADI Foundation's project reports, impact evaluations, case studies, and knowledge products from our work across Kenya."
  currentPage="resources"
>
  <section class="section-padding bg-white" aria-labelledby="reports-heading">
    <div class="container-wide relative">
      
      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="text-center mb-12 relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Resources
        </p>
        <h1
          id="reports-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
        >
          Reports & Publications
        </h1>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-6 text-dark/70 max-w-2xl mx-auto"
          style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
        >
          Download project reports, impact evaluations, case studies, and knowledge products from our programmes across Kenya.
        </p>
      </div>

      {/* Search and Filters */}
      <div class="max-w-3xl mx-auto mb-12 relative z-10">
        
        {/* Search input — full width */}
        <div class="relative mb-4">
          <label for="report-search" class="sr-only">Search reports</label>
          <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-dark/30 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input
            type="text"
            id="report-search"
            placeholder="Search by project, donor, or report type..."
            class="w-full pl-12 pr-4 py-3.5 bg-cream border-2 border-dark/10 rounded-xl text-dark placeholder:text-dark/30 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
          />
        </div>

        {/* Donor filter buttons */}
        <div class="flex flex-wrap justify-center gap-2" role="group" aria-label="Filter reports by donor">
          <button type="button" data-filter="All" class="px-4 py-2.5 text-sm font-semibold bg-primary text-white rounded-lg hover:bg-primary-light transition-colors">All</button>
          <button type="button" data-filter="IFAD" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">IFAD</button>
          <button type="button" data-filter="EU" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">EU</button>
          <button type="button" data-filter="FAO" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">FAO</button>
          <button type="button" data-filter="Safaricom" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">Safaricom</button>
          <button type="button" data-filter="USAID" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">USAID</button>
          <button type="button" data-filter="GIZ" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">GIZ</button>
          <button type="button" data-filter="ILO" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">ILO</button>
        </div>

      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10" data-report-grid>
        {reports.map((report) => (
          <div
            id={`report-${getSlug(report.project)}`}
            class="group bg-cream rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col scroll-mt-24"
            data-donor={report.donor}
            data-searchable={`${report.project} ${report.fullName} ${report.donor} ${report.downloads.map((d) => `${d.label} ${d.type}`).join(' ')}`.toLowerCase()}
          >
            
            <div class="relative h-48 overflow-hidden">
              <img
                src={report.image}
                alt={report.fullName}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent" aria-hidden="true"></div>
              <div class="absolute bottom-4 left-4 right-4">
                <p class="text-white/70 text-xs font-medium tracking-wider uppercase">{report.duration}</p>
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <h2 class="font-heading font-bold text-dark group-hover:text-primary transition-colors" style="font-size: 1.125rem; line-height: 1.4;">
                {report.project}
              </h2>
              <p class="mt-1 text-dark/50 text-sm">{report.fullName}</p>
              <p class="mt-2 text-dark/40 text-xs font-medium tracking-wide uppercase">{report.donor}</p>

              <div class="mt-4 pt-4 border-t border-dark/10 flex flex-wrap gap-1.5">
                {report.downloads.map((download) => (
                  <a
                    href={download.href}
                    class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-primary bg-white rounded-[5px] hover:bg-primary hover:text-white transition-colors no-underline border border-dark/5"
                    download
                  >
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    {download.label}
                    <span class={`ml-1 px-1.5 py-0.5 text-[10px] font-semibold rounded-full border ${typeColors[download.type] || 'bg-gray-50 text-gray-600 border-gray-200'}`}>
                      {download.type}
                    </span>
                  </a>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>

      <div id="no-results" class="hidden text-center py-12 relative z-10">
        <p class="text-dark/40">No reports found matching your search.</p>
      </div>

    </div>
  </section>
</MainLayout>

<script>
  function initReportFilters() {
    const searchInput = document.getElementById('report-search') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('[data-filter]');
    const grid = document.querySelector('[data-report-grid]');
    const cards = grid?.querySelectorAll('[data-searchable]');
    const noResults = document.getElementById('no-results');
    
    let activeFilter = 'All';
    let searchTerm = '';

    function applyFilters() {
      let visibleCount = 0;

      cards?.forEach((card) => {
        const searchable = card.getAttribute('data-searchable') || '';
        const donor = card.getAttribute('data-donor') || '';
        
        const matchesSearch = searchTerm === '' || searchable.includes(searchTerm.toLowerCase());
        const matchesFilter = activeFilter === 'All' || donor.includes(activeFilter);
        
        const shouldShow = matchesSearch && matchesFilter;
        (card as HTMLElement).classList.toggle('hidden', !shouldShow);
        
        if (shouldShow) visibleCount++;
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = (btn as HTMLElement).getAttribute('data-filter') || 'All';
        
        filterButtons.forEach((other) => {
          const isActive = other === btn;
          (other as HTMLElement).classList.toggle('bg-primary', isActive);
          (other as HTMLElement).classList.toggle('text-white', isActive);
          (other as HTMLElement).classList.toggle('bg-cream', !isActive);
          (other as HTMLElement).classList.toggle('text-dark/60', !isActive);
        });

        applyFilters();
      });
    });
  }

  initReportFilters();
  document.addEventListener('astro:page-load', initReportFilters);
</script>