---
// Reports page — USTADI Foundation
import MainLayout from '../../layouts/MainLayout.astro';
import ScribbleCircle from '../../components/shared/ScribbleCircle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const reports = [
  {
    project: 'JOY Project',
    fullName: 'Boosting Rural Youth Employment through Integrated Agribusiness Hubs',
    duration: '2021–2025',
    donor: 'IFAD, Visa Foundation, ILO, Procasur',
    image: getUrl('/images/projects/joy-project.jpg'),
    downloads: [
      { label: 'Baseline Assessment', href: '/downloads/joy-baseline-report.pdf' },
      { label: 'Mid-term Review', href: '/downloads/joy-midterm-review.pdf' },
      { label: 'Annual Progress Report', href: '/downloads/joy-annual-report.pdf' },
    ],
  },
  {
    project: 'Emajic',
    fullName: 'Environmental Management, Jobs and Income for Youth and Women',
    duration: '2022–2024',
    donor: 'GIZ, ChildFund',
    image: getUrl('/images/projects/emajic-project.jpg'),
    downloads: [
      { label: 'Inception Report', href: '/downloads/emajic-inception-report.pdf' },
      { label: 'Phase 1 Progress Report', href: '/downloads/emajic-progress-report.pdf' },
    ],
  },
  {
    project: 'SOYPAM',
    fullName: 'Soy Production and Marketing Project',
    duration: '2021–2022',
    donor: 'EU, AGRIFI',
    image: getUrl('/images/projects/soypam-project.jpg'),
    downloads: [
      { label: 'Final Project Report', href: '/downloads/soypam-final-report.pdf' },
      { label: 'Market Assessment Study', href: '/downloads/soypam-market-assessment.pdf' },
    ],
  },
  {
    project: 'COVID-19 Resilience',
    fullName: 'Increasing Resilience for Youth Enterprises Affected by COVID-19',
    duration: '2020–2022',
    donor: 'USADF',
    image: getUrl('/images/projects/covid-resilience.jpg'),
    downloads: [
      { label: 'Project Completion Report', href: '/downloads/covid-resilience-final-report.pdf' },
      { label: 'Impact Assessment', href: '/downloads/covid-resilience-impact.pdf' },
    ],
  },
  {
    project: 'KALRO Ag Tech',
    fullName: 'Upscaling Agricultural Technologies for Smallholder Farmers',
    duration: '2020–2022',
    donor: 'EU, KALRO',
    image: getUrl('/images/projects/kalro-project.jpg'),
    downloads: [
      { label: 'Technical Report', href: '/downloads/kalro-technical-report.pdf' },
      { label: 'Productivity Study', href: '/downloads/kalro-productivity-study.pdf' },
    ],
  },
  {
    project: 'VIJABIZ',
    fullName: 'Youth Economic Empowerment through Agribusiness',
    duration: '2018–2020',
    donor: 'IFAD, CTA',
    image: getUrl('/images/projects/vijabiz-project.jpg'),
    downloads: [
      { label: 'Final Project Report', href: '/downloads/vijabiz-final-report.pdf' },
      { label: 'Case Study', href: '/downloads/vijabiz-case-study.pdf' },
      { label: 'Best Practices', href: '/downloads/vijabiz-best-practices.pdf' },
    ],
  },
  {
    project: 'Cassava Value Chain',
    fullName: 'Strengthening the Competitiveness of the Cassava Value Chain',
    duration: '2017–2022',
    donor: 'EU, Self Help Africa',
    image: getUrl('/images/projects/cassava-project.jpg'),
    downloads: [
      { label: 'Final Project Report', href: '/downloads/cassava-final-report.pdf' },
      { label: 'Impact Assessment', href: '/downloads/cassava-impact-assessment.pdf' },
      { label: 'Training Manual', href: '/downloads/cassava-training-manual.pdf' },
    ],
  },
  {
    project: 'Afya Pwani',
    fullName: 'WaSH Project in Kilifi',
    duration: '2017–2020',
    donor: 'Pathfinder International',
    image: getUrl('/images/projects/afya-pwani.jpg'),
    downloads: [
      { label: 'Project Completion Report', href: '/downloads/afya-pwani-final-report.pdf' },
    ],
  },
  {
    project: 'K-SALES',
    fullName: 'Kenya Semi-Arid Livestock Enhancement Support',
    duration: '2015–2016',
    donor: 'Land O\'Lakes',
    image: getUrl('/images/projects/ksales-project.jpg'),
    downloads: [
      { label: 'Final Project Report', href: '/downloads/ksales-final-report.pdf' },
      { label: 'Value Chain Analysis', href: '/downloads/ksales-value-chain-analysis.pdf' },
    ],
  },
  {
    project: 'KICCAP',
    fullName: 'Kilifi Integrated Climate Change Project',
    duration: '2014–2015',
    donor: 'DFID, Act!',
    image: getUrl('/images/projects/kiccap-project.jpg'),
    downloads: [
      { label: 'Project Completion Report', href: '/downloads/kiccap-final-report.pdf' },
    ],
  },
  {
    project: 'Y2YF',
    fullName: 'Youth-to-Youth Fund for Entrepreneurship Promotion',
    duration: '2014–2015',
    donor: 'ILO',
    image: getUrl('/images/projects/y2yf-project.jpg'),
    downloads: [
      { label: 'Programme Completion Report', href: '/downloads/y2yf-final-report.pdf' },
      { label: 'Impact Evaluation', href: '/downloads/y2yf-impact-evaluation.pdf' },
      { label: 'Innovation Case Studies', href: '/downloads/y2yf-case-studies.pdf' },
    ],
  },
  {
    project: 'SNV Localization',
    fullName: 'Localization of Demand-Driven Professional Capacity Development',
    duration: '2010–2014',
    donor: 'SNV',
    image: getUrl('/images/projects/snv-project.jpg'),
    downloads: [
      { label: 'Programme Report', href: '/downloads/snv-localization-report.pdf' },
      { label: 'CD Framework', href: '/downloads/snv-cd-framework.pdf' },
    ],
  },
];
---

<MainLayout
  title="Reports"
  description="Download USTADI Foundation's project reports, impact evaluations, case studies, and knowledge products from our work across Kenya."
  currentPage="resources"
>
  <section class="section-padding bg-white" aria-labelledby="reports-heading">
    <div class="container-wide relative">
      
      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="text-center mb-16 relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Resources
        </p>
        <h1
          id="reports-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
        >
          Reports & Publications
        </h1>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-6 text-dark/70 max-w-2xl mx-auto"
          style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
        >
          Download project reports, impact evaluations, case studies, and knowledge products from our programmes across Kenya.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10">
        {reports.map((report) => (
          <div class="group bg-cream rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col">
            
            <div class="relative h-48 overflow-hidden">
              <img
                src={report.image}
                alt={report.fullName}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent" aria-hidden="true"></div>
              <div class="absolute bottom-4 left-4 right-4">
                <p class="text-white/70 text-xs font-medium tracking-wider uppercase">{report.duration}</p>
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <h2 class="font-heading font-bold text-dark group-hover:text-primary transition-colors" style="font-size: 1.125rem; line-height: 1.4;">
                {report.project}
              </h2>
              <p class="mt-1 text-dark/50 text-sm">{report.fullName}</p>
              <p class="mt-2 text-dark/40 text-xs font-medium tracking-wide uppercase">{report.donor}</p>

              <div class="mt-4 pt-4 border-t border-dark/10 flex flex-wrap gap-1.5">
                {report.downloads.map((download) => (
                  <a
                    href={download.href}
                    class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-primary bg-white rounded-[5px] hover:bg-primary hover:text-white transition-colors no-underline"
                    download
                  >
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                    </svg>
                    {download.label}
                  </a>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
</MainLayout>