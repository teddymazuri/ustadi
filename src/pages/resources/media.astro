---
// Media page — USTADI Foundation
import MainLayout from '../../layouts/MainLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const mediaProjects = [
  {
    project: 'JOY Project',
    fullName: 'Boosting Rural Youth Employment through Integrated Agribusiness Hubs',
    duration: '2021–2025',
    donor: 'IFAD, Visa Foundation, ILO, Procasur',
    image: getUrl('/images/projects/joy-project.jpg'),
    items: [
      { label: 'Hub Launch Photos', href: '/media/joy-launch', type: 'photo' },
      { label: 'Training Documentary', href: 'https://youtube.com/@USTADIFoundation', type: 'video' },
    ],
  },
  {
    project: 'Emajic',
    fullName: 'Environmental Management, Jobs and Income for Youth and Women',
    duration: '2022–2024',
    donor: 'GIZ, ChildFund',
    image: getUrl('/images/projects/emajic-project.jpg'),
    items: [
      { label: 'Project Activity Photos', href: '/media/emajic-photos', type: 'photo' },
    ],
  },
  {
    project: 'SOYPAM',
    fullName: 'Soy Production and Marketing Project',
    duration: '2021–2022',
    donor: 'EU, AGRIFI',
    image: getUrl('/images/projects/soypam-project.jpg'),
    items: [
      { label: 'Soy Value Chain Photos', href: '/media/soypam-photos', type: 'photo' },
    ],
  },
  {
    project: 'COVID-19 Resilience',
    fullName: 'Increasing Resilience for Youth Enterprises Affected by COVID-19',
    duration: '2020–2022',
    donor: 'USADF',
    image: getUrl('/images/projects/covid-resilience.jpg'),
    items: [
      { label: 'Youth Enterprise Stories', href: '/media/covid-resilience-stories', type: 'photo' },
    ],
  },
  {
    project: 'KALRO Ag Tech',
    fullName: 'Upscaling Agricultural Technologies for Smallholder Farmers',
    duration: '2020–2022',
    donor: 'EU, KALRO',
    image: getUrl('/images/projects/kalro-project.jpg'),
    items: [
      { label: 'Farmer Training Photos', href: '/media/kalro-training-photos', type: 'photo' },
    ],
  },
  {
    project: 'VIJABIZ',
    fullName: 'Youth Economic Empowerment through Agribusiness',
    duration: '2018–2020',
    donor: 'IFAD, CTA',
    image: getUrl('/images/projects/vijabiz-project.jpg'),
    items: [
      { label: 'Youth Group Portraits', href: '/media/vijabiz-portraits', type: 'photo' },
      { label: 'Agribusiness Training Videos', href: 'https://youtube.com/@USTADIFoundation', type: 'video' },
      { label: 'Design Clinic Photos', href: '/media/vijabiz-design-clinic', type: 'photo' },
    ],
  },
  {
    project: 'Cassava Value Chain',
    fullName: 'Strengthening the Competitiveness of the Cassava Value Chain',
    duration: '2017–2022',
    donor: 'EU, Self Help Africa',
    image: getUrl('/images/projects/cassava-project.jpg'),
    items: [
      { label: 'Farmer Field Photos', href: '/media/cassava-farmer-photos', type: 'photo' },
      { label: 'Processing Documentary', href: 'https://youtube.com/@USTADIFoundation', type: 'video' },
    ],
  },
  {
    project: 'Afya Pwani',
    fullName: 'WaSH Project in Kilifi',
    duration: '2017–2020',
    donor: 'Pathfinder International',
    image: getUrl('/images/projects/afya-pwani.jpg'),
    items: [
      { label: 'WaSH Facility Photos', href: '/media/afya-pwani-photos', type: 'photo' },
    ],
  },
  {
    project: 'K-SALES',
    fullName: 'Kenya Semi-Arid Livestock Enhancement Support',
    duration: '2015–2016',
    donor: 'Land O\'Lakes',
    image: getUrl('/images/projects/ksales-project.jpg'),
    items: [
      { label: 'Livestock Market Photos', href: '/media/ksales-photos', type: 'photo' },
    ],
  },
  {
    project: 'KICCAP',
    fullName: 'Kilifi Integrated Climate Change Project',
    duration: '2014–2015',
    donor: 'DFID, Act!',
    image: getUrl('/images/projects/kiccap-project.jpg'),
    items: [
      { label: 'Climate Adaptation Photos', href: '/media/kiccap-photos', type: 'photo' },
    ],
  },
  {
    project: 'Y2YF',
    fullName: 'Youth-to-Youth Fund for Entrepreneurship Promotion',
    duration: '2014–2015',
    donor: 'ILO',
    image: getUrl('/images/projects/y2yf-project.jpg'),
    items: [
      { label: 'Grantee Business Portraits', href: '/media/y2yf-portraits', type: 'photo' },
      { label: 'Project Videos', href: 'https://youtube.com/@USTADIFoundation', type: 'video' },
    ],
  },
  {
    project: 'SNV Localization',
    fullName: 'Localization of Demand-Driven Professional Capacity Development',
    duration: '2010–2014',
    donor: 'SNV',
    image: getUrl('/images/projects/snv-project.jpg'),
    items: [
      { label: 'Programme Photos', href: '/media/snv-localization-photos', type: 'photo' },
    ],
  },
];
---

<MainLayout
  title="Media"
  description="Explore photos, videos, and multimedia stories from USTADI Foundation's programmes across Kenya."
  currentPage="resources"
>
  <section class="section-padding bg-white" aria-labelledby="media-heading">
    <div class="container-wide">
      
      <div class="text-center mb-16">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Resources
        </p>
        <h1
          id="media-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
        >
          Media Gallery
        </h1>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-6 text-dark/70 max-w-2xl mx-auto"
          style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
        >
          Explore our work through photos, videos, and multimedia stories from the communities we serve across Kenya.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
        {mediaProjects.map((project) => (
          <div class="group bg-cream rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col">
            
            {/* Thumbnail */}
            <div class="relative h-48 overflow-hidden">
              <img
                src={project.image}
                alt={project.fullName}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent" aria-hidden="true"></div>
              <div class="absolute bottom-4 left-4 right-4 flex items-center gap-2">
                <p class="text-white/70 text-xs font-medium tracking-wider uppercase">{project.duration}</p>
                {project.items.some(i => i.type === 'video') && (
                  <span class="ml-auto flex items-center gap-1 text-white/80 text-xs bg-dark/30 px-2 py-0.5 rounded-full">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    Video
                  </span>
                )}
              </div>
            </div>

            {/* Content */}
            <div class="p-6 flex flex-col flex-1">
              <h2 class="font-heading font-bold text-dark group-hover:text-primary transition-colors" style="font-size: 1.125rem; line-height: 1.4;">
                {project.project}
              </h2>
              <p class="mt-1 text-dark/50 text-sm">{project.fullName}</p>
              <p class="mt-2 text-dark/40 text-xs font-medium tracking-wide uppercase">{project.donor}</p>

              {/* Media links */}
              <div class="mt-4 pt-4 border-t border-dark/10 flex flex-wrap gap-1.5">
                {project.items.map((item) => (
                  <a
                    href={item.href}
                    class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-primary bg-white rounded-[5px] hover:bg-primary hover:text-white transition-colors no-underline"
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {item.type === 'video' ? (
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    ) : (
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    )}
                    {item.label}
                  </a>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>

    </div>
  </section>
</MainLayout>