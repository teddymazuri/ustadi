---

<MainLayout
  title="Media"
  description="Explore photos, videos, and multimedia stories from USTADI Foundation's programmes across Kenya."
  currentPage="resources"
>
  <section class="section-padding bg-white" aria-labelledby="media-heading">
    <div class="container-wide relative">
      
      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="text-center mb-12 relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Resources
        </p>
        <h1
          id="media-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
        >
          Media Gallery
        </h1>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-6 text-dark/70 max-w-2xl mx-auto"
          style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
        >
          Explore our work through photos, videos, and multimedia stories from the communities we serve across Kenya.
        </p>
      </div>

      {/* Search and Filters */}
      <div class="max-w-2xl mx-auto mb-12 relative z-10">
        <div class="flex flex-col sm:flex-row gap-4">
          
          <div class="flex-1 relative">
            <label for="media-search" class="sr-only">Search media</label>
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-dark/30 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
            <input
              type="text"
              id="media-search"
              placeholder="Search by project, donor, or media type..."
              class="w-full pl-12 pr-4 py-3 bg-cream border-2 border-dark/10 rounded-xl text-dark placeholder:text-dark/30 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
            />
          </div>

          <div class="flex flex-wrap gap-2" role="group" aria-label="Filter media by type">
            <button type="button" data-media-filter="All" class="px-4 py-2.5 text-sm font-semibold bg-primary text-white rounded-lg hover:bg-primary-light transition-colors">All</button>
            <button type="button" data-media-filter="photo" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">Photos</button>
            <button type="button" data-media-filter="video" class="px-4 py-2.5 text-sm font-medium bg-cream text-dark/60 rounded-lg hover:bg-primary hover:text-white transition-colors border-2 border-dark/10">Videos</button>
          </div>

        </div>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 relative z-10" data-media-grid>
        {mediaProjects.map((project) => (
          <div
            class="group bg-cream rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col"
            data-media-types={project.items.map((i) => i.type).join(',')}
            data-media-searchable={`${project.project} ${project.fullName} ${project.donor} ${project.items.map((i) => `${i.label} ${i.type}`).join(' ')}`.toLowerCase()}
          >
            
            <div class="relative h-48 overflow-hidden">
              <img
                src={project.image}
                alt={project.fullName}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent" aria-hidden="true"></div>
              <div class="absolute bottom-4 left-4 right-4 flex items-center gap-2">
                <p class="text-white/70 text-xs font-medium tracking-wider uppercase">{project.duration}</p>
                {project.items.some(i => i.type === 'video') && (
                  <span class="ml-auto flex items-center gap-1 text-white/80 text-xs bg-dark/30 px-2 py-0.5 rounded-full">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
                    </svg>
                    Video
                  </span>
                )}
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <h2 class="font-heading font-bold text-dark group-hover:text-primary transition-colors" style="font-size: 1.125rem; line-height: 1.4;">
                {project.project}
              </h2>
              <p class="mt-1 text-dark/50 text-sm">{project.fullName}</p>
              <p class="mt-2 text-dark/40 text-xs font-medium tracking-wide uppercase">{project.donor}</p>

              <div class="mt-4 pt-4 border-t border-dark/10 flex flex-wrap gap-1.5">
                {project.items.map((item) => (
                  <a
                    href={item.href}
                    class="inline-flex items-center gap-1 px-2.5 py-1 text-xs font-medium text-primary bg-white rounded-[5px] hover:bg-primary hover:text-white transition-colors no-underline border border-dark/5"
                    target={item.href.startsWith('http') ? '_blank' : undefined}
                    rel={item.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                  >
                    {item.type === 'video' ? (
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                      </svg>
                    ) : (
                      <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    )}
                    {item.label}
                  </a>
                ))}
              </div>
            </div>

          </div>
        ))}
      </div>

      <div id="media-no-results" class="hidden text-center py-12 relative z-10">
        <p class="text-dark/40">No media found matching your search.</p>
      </div>

    </div>
  </section>
</MainLayout>

<script>
  function initMediaFilters() {
    const searchInput = document.getElementById('media-search') as HTMLInputElement;
    const filterButtons = document.querySelectorAll('[data-media-filter]');
    const grid = document.querySelector('[data-media-grid]');
    const cards = grid?.querySelectorAll('[data-media-searchable]');
    const noResults = document.getElementById('media-no-results');
    
    let activeFilter = 'All';
    let searchTerm = '';

    function applyFilters() {
      let visibleCount = 0;

      cards?.forEach((card) => {
        const searchable = card.getAttribute('data-media-searchable') || '';
        const types = card.getAttribute('data-media-types') || '';
        
        const matchesSearch = searchTerm === '' || searchable.includes(searchTerm.toLowerCase());
        const matchesFilter = activeFilter === 'All' || types.includes(activeFilter);
        
        const shouldShow = matchesSearch && matchesFilter;
        (card as HTMLElement).classList.toggle('hidden', !shouldShow);
        
        if (shouldShow) visibleCount++;
      });

      if (noResults) {
        noResults.classList.toggle('hidden', visibleCount > 0);
      }
    }

    searchInput?.addEventListener('input', (e) => {
      searchTerm = (e.target as HTMLInputElement).value;
      applyFilters();
    });

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        activeFilter = (btn as HTMLElement).getAttribute('data-media-filter') || 'All';
        
        filterButtons.forEach((other) => {
          const isActive = other === btn;
          (other as HTMLElement).classList.toggle('bg-primary', isActive);
          (other as HTMLElement).classList.toggle('text-white', isActive);
          (other as HTMLElement).classList.toggle('bg-cream', !isActive);
          (other as HTMLElement).classList.toggle('text-dark/60', !isActive);
        });

        applyFilters();
      });
    });
  }

  initMediaFilters();
  document.addEventListener('astro:page-load', initMediaFilters);
</script>