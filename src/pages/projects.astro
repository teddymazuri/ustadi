---
// Projects page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024) + FAO Fisheries, GSMESKILL, Wezesha III, BlueBiz
import MainLayout from '../layouts/MainLayout.astro';
import ProjectsHero from '../components/projects/ProjectsHero.astro';
import ProjectsList from '../components/projects/ProjectsList.astro';
import ProjectsCTA from '../components/projects/ProjectsCTA.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const getSlug = (name: string) => name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
const getReportAnchor = (projectName: string) => getUrl(`/resources/reports#report-${getSlug(projectName)}`);
const getStartYear = (duration: string) => duration.split('–')[0].trim();
---

