---
// Programs page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024)
import MainLayout from '../layouts/MainLayout.astro';
import ProgramsHero from '../components/programs/ProgramsHero.astro';
import ThematicAreas from '../components/programs/ThematicAreas.astro';
import KeyProjects from '../components/programs/KeyProjects.astro';
import ApproachSection from '../components/programs/ApproachSection.astro';
import ProgramsCTA from '../components/programs/ProgramsCTA.astro';

// Helper function to build clean base-aware internal URLs
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="Programs"
  description="USTADI Foundation promotes demand-driven professional capacity development across youth employment, value chain facilitation, climate solutions, and enterprise development in Kenya."
  currentPage="programs"
>
  <!-- 1. Hero -->
  <ProgramsHero
    headline="Capacity Development at the Core, Not an Add-On"
    subheadline="We build sustainable local markets by linking rural entrepreneurs directly to verified trainers,
                    financial services, and commercial buyers. Our approach is community driven, practical, and
                    designed to keep businesses growing long after a project ends."
    image={{
      src: getUrl('/images/programs/programs-hero.jpg'),
      alt: 'USTADI Foundation capacity development training session with youth and women entrepreneurs',
    }}
  />

  <!-- 2. Thematic Areas -->
  <ThematicAreas
    heading="Our Thematic Focus"
    subheading="Our work spans 8 interconnected areas that together promote sustainable enterprise development
                    for youth and women."
    areas={[
      {
        title: 'Youth Employment',
        description: 'We create sustainable job opportunities for rural young people through agribusiness, entrepreneurship, and market driven skills training.',
        icon: 'users',
      },
      {
        title: 'Value Chain Facilitation',
        description: 'We strengthen agricultural value chains like cereals, dairy, fisheries, livestock, cassava, and soy to improve market connections and boost local incomes.',
        icon: 'chart',
      },
      {
        title: 'Youth Inclusion',
        description: 'We ensure young people, particularly young women, actively participate in economic opportunities and local leadership decisions.',
        icon: 'heart',
      },
      {
        title: 'Rural Youth and Women Enterprise Development',
        description: 'We equip rural entrepreneurs with practical business skills through practical training, mentorship, coaching, and incubation programs.',
        icon: 'briefcase',
      },
      {
        title: 'Climate Solutions and Green Jobs',
        description: 'We promote eco friendly farming, renewable energy, and environmental management to build sustainable businesses and green jobs for youth.',
        icon: 'leaf',
      },
      {
        title: 'Demand-Driven Professional Capacity Development',
        description: 'We deliver affordable professional services at the local level based on real market demand and client needs.',
        icon: 'academic',
      },
      {
        title: 'Mentorship and Coaching',
        description: 'We provide continuous support to young entrepreneurs through structured mentorship programs and practical business coaching.',
        icon: 'lightbulb',
      },
      {
        title: 'Innovative Financing',
        description: 'We connect entrepreneurs to finance through technical assistance grants, crowdfunding, and direct linkages to financial institutions.',
        icon: 'cash',
      },
    ]}
  />

  <!-- 3. Key Projects -->
  <KeyProjects
    heading="Key Projects"
    subheading="Selected initiatives that showcase our practical approach to capacity development in action."
    projects={[
      {
        title: 'JOY Project: Boosting Rural Youth Employment Through Integrated Agribusiness Hubs',
        description: 'A 4 year initiative establishing agribusiness hubs and training programs across Kilifi, Kakamega, and Nakuru counties. The project equips young people with technical, managerial, and business skills for self employment and job placement. Delivered in partnership with IFAD, Visa Foundation, ILO, and Procasur.',
        image: { src: getUrl('/images/projects/joy-project.jpg'), alt: 'JOY Project agribusiness hub training session' },
        href: getUrl('/projects'),
      },
      {
        title: 'VIJABIZ: Youth Economic Empowerment Through Agribusiness',
        description: 'An IFAD funded initiative that built business skills, created market connections, and added value for 173 rural youth groups across Kilifi and Nakuru counties. Focusing on cereals, dairy, and fisheries, the project reached over 1,550 direct participants, with 72 youth businesses receiving grants to grow.',
        image: { src: getUrl('/images/projects/vijabiz-project.jpg'), alt: 'VIJABIZ youth agribusiness training in Kenya' },
        href: getUrl('/projects'),
      },
      {
        title: 'Y2YF: Youth to Youth Fund for Entrepreneurship Promotion',
        description: 'USTADI was competitively selected by ILO to implement the Youth to Youth Fund in Kenya. Out of 486 proposals received nationwide, 34 youth led organizations received grant support, creating 1,171 jobs and reaching over 10,000 indirect beneficiaries across 11 counties.',
        image: { src: getUrl('/images/projects/y2yf-project.jpg'), alt: 'Y2YF grantee showcasing their enterprise' },
        href: getUrl('/projects'),
      },
    ]}
  />

  <!-- 4. Our Approach -->
  <ApproachSection
    heading="Our Approach"
    subheading="Our model revolves around 3 complementary pillars that place capacity development at the core,
                not as an add on."
    pillars={[
      {
        number: '01',
        title: 'Market Facilitation Services',
        description: 'In person market matchmaking events, trade fairs, and connections that link youth and women entrepreneurs to buyers, suppliers, and commercial opportunities at the national and local level.',
      },
      {
        number: '02',
        title: 'Technical Assistance Grants and Investments',
        description: 'Direct financial support, procurement and grant management, and creative funding tools like crowdfunding to help rural enterprises scale sustainably.',
      },
      {
        number: '03',
        title: 'Learning and Sharing Platform',
        description: 'Knowledge generation through documented best practices, quality assurance, policy advocacy, and affordably priced professional services at the local level.',
      },
    ]}
  />

  <!-- 5. CTA -->
  <ProgramsCTA
    heading="Partner with us to scale capacity development"
    body="We work with county governments, development partners, and the private sector to deliver sustainable impact across Kenya. Explore our projects or get in touch to discuss collaboration."
    primaryCta={{ label: 'View our projects', href: getUrl('/projects') }}
    secondaryCta={{ label: 'Get in touch', href: getUrl('/contact') }}
  />
</MainLayout>