---
// Get Involved page — USTADI Foundation
import MainLayout from '../layouts/MainLayout.astro';
import ScribbleCircle from '../components/shared/ScribbleCircle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="Get Involved"
  description="Volunteer with USTADI Foundation. Share your expertise in enterprise development, value chain facilitation, mentorship, or capacity development with youth and women across Kenya."
  currentPage="get-involved"
>
  <!-- Hero -->
  <section class="section-padding bg-white" aria-labelledby="involved-heading">
    <div class="container-tight text-center relative">
      
      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Get Involved
        </p>
        <h1
          id="involved-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
        >
          Volunteer With Us
        </h1>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-6 text-dark/70 max-w-2xl mx-auto"
          style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
        >
          USTADI collaborates with a widespread network of skilled associates, including ILO certified trainers
          across Kenya. Whether contributing a few hours monthly or committing to an extended partnership,
          your expertise creates immediate impact for local communities.
        </p>
      </div>
    </div>
  </section>

  <!-- Ways to volunteer -->
  <section class="pb-16 bg-white" aria-labelledby="opportunities-heading">
    <div class="container-wide">
      
      <div class="text-center mb-12">
        <h2
          id="opportunities-heading"
          class="font-heading font-bold text-dark"
          style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
        >
          How You Can Help
        </h2>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6 max-w-5xl mx-auto">
        {[
          {
            icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222',
            title: 'Training & Facilitation',
            description: 'Lead practical workshops covering entrepreneurship, business strategy, financial management, and vocational skills.',
          },
          {
            icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
            title: 'Mentorship',
            description: 'Direct youth entrepreneurs through targeted one on one coaching, enterprise incubation, and strategic career guidance.',
          },
          {
            icon: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
            title: 'Technical Expertise',
            description: 'Provide specialized insights in agribusiness, value chain optimization, renewable energy solutions, and digital innovation.',
          },
          {
            icon: 'M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z',
            title: 'Proposal Writing',
            description: 'Assist youth groups and local civil society organizations in crafting viable business plans and competitive funding proposals.',
          },
        ].map((item) => (
          <div class="bg-cream rounded-3xl p-6 text-center shadow-card hover:shadow-card-hover transition-all duration-300 group">
            <div class="w-12 h-12 mx-auto flex items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={item.icon} />
              </svg>
            </div>
            <h3 class="font-heading font-bold text-dark" style="font-size: 1.125rem;">
              {item.title}
            </h3>
            <p class="mt-3 text-dark/50 text-sm leading-relaxed">{item.description}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  <!-- Associate Model -->
  <section class="section-padding bg-cream" aria-labelledby="associate-heading">
    <div class="container-tight text-center relative">
      
      <ScribbleCircle
        size={180}
        opacity={0.4}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Our Model
        </p>
        <h2
          id="associate-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
        >
          Work With Us as an Associate
        </h2>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-6 text-dark/60 max-w-2xl mx-auto"
          style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
        >
          USTADI relies on a trusted network of technical associates and ILO certified trainers throughout Kenya. 
          We deploy associates according to specific program requirements and domain expertise,
          building lasting partnerships with leaders dedicated to expanding youth and women enterprises.
        </p>
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section-padding bg-white" aria-labelledby="form-heading">
    <div class="container-tight">
      
      <div class="bg-cream rounded-3xl p-8 md:p-12 shadow-card max-w-2xl mx-auto relative overflow-hidden">
        
        <ScribbleCircle
          size={160}
          opacity={0.3}
          rotation={-15}
          class="absolute -top-6 left-1/2 -translate-x-1/2 z-0"
        />

        <div class="relative z-10">
          <h2
            id="form-heading"
            class="font-heading font-bold text-dark text-center"
            style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
          >
            Express Your Interest
          </h2>
          <div class="mt-2 w-12 h-0.5 bg-accent rounded-full mx-auto" aria-hidden="true"></div>

          <!-- Success message -->
          <div id="form-success" class="hidden mt-8 bg-green-50 border-2 border-green-200 rounded-xl px-6 py-4 text-center">
            <svg class="w-10 h-10 mx-auto text-green-500 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            <p class="text-green-700 font-semibold text-sm">Thank you! Your expression of interest has been submitted.</p>
            <p class="text-green-600 text-xs mt-1">We will review your details and get back to you.</p>
          </div>

          <!-- Error message -->
          <div id="form-error" class="hidden mt-8 bg-red-50 border-2 border-red-200 rounded-xl px-6 py-4 text-center">
            <p class="text-red-700 font-semibold text-sm">Something went wrong. Please try again.</p>
          </div>
          
          <form action="https://formspree.io/f/xqpzrwwb" method="POST" class="mt-10" id="volunteer-form">
            <div class="space-y-6">
              <div class="grid sm:grid-cols-2 gap-6">
                <div>
                  <label for="name" class="block text-sm font-medium text-dark/60 mb-2">Full Name *</label>
                  <input
                    type="text"
                    name="name"
                    id="name"
                    required
                    placeholder="Your full name"
                    class="w-full px-4 py-3 bg-white border border-dark/10 rounded-xl text-dark placeholder:text-dark/25 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                  />
                </div>
                <div>
                  <label for="email" class="block text-sm font-medium text-dark/60 mb-2">Email Address *</label>
                  <input
                    type="email"
                    name="email"
                    id="email"
                    required
                    placeholder="your@email.com"
                    class="w-full px-4 py-3 bg-white border border-dark/10 rounded-xl text-dark placeholder:text-dark/25 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
                  />
                </div>
              </div>

              <div>
                <label for="expertise" class="block text-sm font-medium text-dark/60 mb-2">Area of Expertise *</label>
                <select
                  name="expertise"
                  id="expertise"
                  required
                  class="w-full px-4 py-3 bg-white border border-dark/10 rounded-xl text-dark/60 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent appearance-none"
                >
                  <option value="" disabled selected>Select your area of expertise</option>
                  <option value="training">Training & Facilitation</option>
                  <option value="mentorship">Mentorship & Coaching</option>
                  <option value="technical">Technical Expertise (Agribusiness, Value Chains, etc.)</option>
                  <option value="proposal">Proposal Writing & Fundraising</option>
                  <option value="monitoring">Monitoring & Evaluation</option>
                  <option value="other">Other</option>
                </select>
              </div>

              <div>
                <label for="message" class="block text-sm font-medium text-dark/60 mb-2">Tell Us About Yourself *</label>
                <textarea
                  name="message"
                  id="message"
                  rows="4"
                  required
                  placeholder="Briefly describe your background, experience, and how you would like to contribute..."
                  class="w-full px-4 py-3 bg-white border border-dark/10 rounded-xl text-dark placeholder:text-dark/25 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent resize-none"
                ></textarea>
              </div>

              <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

              <button
                type="submit"
                id="submit-btn"
                class="w-full inline-flex items-center justify-center px-6 py-4 font-semibold text-white bg-primary rounded-xl hover:bg-primary-light transition-colors"
                style="font-size: var(--text-body-base);"
              >
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Submit Expression of Interest
              </button>
            </div>
          </form>
        </div>
      </div>

    </div>
  </section>

  <script>
    const form = document.getElementById('volunteer-form');
    const successMsg = document.getElementById('form-success');
    const errorMsg = document.getElementById('form-error');
    const submitBtn = document.getElementById('submit-btn');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      
      successMsg?.classList.add('hidden');
      errorMsg?.classList.add('hidden');
      
      const originalText = submitBtn?.innerHTML;
      submitBtn!.innerHTML = 'Sending...';
      submitBtn!.disabled = true;

      const formData = new FormData(form);

      try {
        const response = await fetch('https://formspree.io/f/xqpzrwwb', {
          method: 'POST',
          body: formData,
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          form.reset();
          successMsg?.classList.remove('hidden');
          successMsg?.scrollIntoView({ behavior: 'smooth', block: 'center' });
        } else {
          errorMsg?.classList.remove('hidden');
        }
      } catch (err) {
        errorMsg?.classList.remove('hidden');
      } finally {
        submitBtn!.innerHTML = originalText;
        submitBtn!.disabled = false;
      }
    });
  </script>
</MainLayout>