---
// News page — USTADI Foundation
import MainLayout from '../layouts/MainLayout.astro';
import ScribbleCircle from '../components/shared/ScribbleCircle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const newsArticles = [
  {
    title: 'USTADI Foundation Expands Digital Skills Program to Three New Counties',
    excerpt: 'The JOY Project continues to scale, bringing agribusiness hub training to more youth across Kilifi, Kakamega, and Nakuru counties through partnerships with county governments and TVET institutions.',
    fullStory: 'The JOY Project continues to scale, bringing agribusiness hub training to more youth across Kilifi, Kakamega, and Nakuru counties through partnerships with county governments and TVET institutions.\n\nThis expansion phase builds on the success of the first cohort, which established integrated training programmes that combine technical agricultural skills with business management. Youth participants receive hands-on training at the agribusiness hubs, access to demonstration plots, and direct linkages to input suppliers and commodity buyers.\n\nThrough partnerships with county governments, TVET institutions, and private-sector actors, the project ensures that training aligns with real labour market demand. The expansion is expected to reach over 1,000 additional youth in the next phase.',
    date: 'July 2026',
    image: getUrl('/images/projects/joy-project.jpg'),
    category: 'Project Update',
  },
  {
    title: 'Emajic Project Launches Green Jobs Initiative in Nairobi',
    excerpt: 'In partnership with GIZ and ChildFund, the Emajic project is creating environmental management opportunities that generate jobs and income for youth and women in Kasarani, Nairobi.',
    fullStory: 'The Emajic project has launched a green jobs initiative in Kasarani, Nairobi, creating environmental management opportunities that generate jobs and income for youth and women.\n\nImplemented in partnership with GIZ and ChildFund, the project focuses on improving efficiency in solid waste management while creating employment in the waste recycling sector. The initiative targets 700 beneficiaries, with 60% youth and 40% women, who are unemployed and socially and economically disadvantaged.\n\nParticipants receive training on waste segregation, recycling techniques, and enterprise development, enabling them to build sustainable livelihoods while contributing to a cleaner urban environment.',
    date: 'March 2026',
    image: getUrl('/images/projects/emajic-project.jpg'),
    category: 'Project Launch',
  },
  {
    title: 'VIJABIZ Legacy: 173 Youth Groups Transformed Through Agribusiness',
    excerpt: 'A look back at the impact of the VIJABIZ project, which reached over 1,550 direct participants and provided grants to 72 agri-enterprises across Kilifi and Nakuru counties.',
    fullStory: 'The VIJABIZ project, funded by IFAD and CTA, created sustainable employment for rural youth through agribusiness in cereals, dairy, and fisheries value chains across Kilifi and Nakuru counties.\n\nThe project reached 173 youth groups, engaging over 1,550 direct participants — 30% of them young women — through enterprise training, design clinics, boot camps, mentorship, and incubation. Seventy-two agri-enterprises received direct grants to scale their operations.\n\nBest practices and innovations were identified and documented, providing a knowledge base that continues to inform USTADI\'s youth employment programming today.',
    date: 'January 2026',
    image: getUrl('/images/projects/vijabiz-project.jpg'),
    category: 'Impact Story',
  },
  {
    title: 'Cassava Value Chain Project Concludes After 4.5 Years of Impact',
    excerpt: 'The EU-funded cassava project reached over 10,000 smallholder farmers, established 450 farmer business groups, and created 100 aggregation centres across Kilifi and Kitui Counties.',
    fullStory: 'The 4.5-year cassava value chain project, funded by the European Union through Self Help Africa, has concluded after reaching over 10,000 smallholder farmers across Kilifi and Kitui counties.\n\nThe project established 450 farmer business groups, trained 9,500 farmers on sustainable agricultural practices, post-harvest handling, and farming as a business, and created 100 aggregation centres. At least 60% of participants were women.\n\nA key achievement was the distribution of the Tajirika cassava variety and its widespread adoption by farmers. The project also supported value addition activities, including cassava flour production with KEBS certification, enabling farmers to access higher-value markets.',
    date: 'October 2025',
    image: getUrl('/images/projects/cassava-project.jpg'),
    category: 'Project Milestone',
  },
  {
    title: 'SOYPAM Project Strengthens Soy Value Chain for Smallholder Farmers',
    excerpt: 'The Soy Production and Marketing project, funded by the EU and AGRIFI, connected smallholder farmers to processors and developed sustainable marketing channels.',
    fullStory: 'The SOYPAM project, funded by the EU and AGRIFI, has strengthened the soy value chain in Kenya by improving production techniques and creating market linkages for smallholder farmers.\n\nThe project connected producers directly to processors, developed sustainable marketing channels, and provided training on good agricultural practices. Farmers received support on meeting commercial grain specifications, enabling them to command better prices for their harvests.\n\nThrough structured off-take agreements, the project built long-term income stability for participating households.',
    date: 'June 2025',
    image: getUrl('/images/projects/soypam-project.jpg'),
    category: 'Project Update',
  },
  {
    title: 'Youth Enterprises Show Resilience After COVID-19 Recovery Programme',
    excerpt: 'USADF-funded post-VIJABIZ support helped youth entrepreneurs recover from pandemic disruptions. The programme provided targeted assistance to rebuild and adapt businesses.',
    fullStory: 'The USADF-funded post-VIJABIZ resilience programme helped youth enterprises recover from the disruptions caused by the COVID-19 pandemic.\n\nBuilding on the VIJABIZ network, the programme provided targeted support to help young entrepreneurs recover, adapt, and build resilience against future shocks. Participants received business coaching, resilience grants, and technical assistance to pivot their enterprises to new market realities.\n\nMany youth businesses successfully adapted their models — including shifting to day-old chick sales and diversified agribusiness operations — demonstrating the resilience of well-supported enterprises.',
    date: 'February 2025',
    image: getUrl('/images/projects/covid-resilience.jpg'),
    category: 'Impact Story',
  },
];

const categories = ['All', 'Project Update', 'Impact Story', 'Project Launch', 'Project Milestone'];

const articlesJson = JSON.stringify(newsArticles);
---

<MainLayout
  title="News"
  description="Latest news, project updates, impact stories, and announcements from USTADI Foundation's work across Kenya."
  currentPage="news"
>
  <!-- Same as before, but cards use buttons with onclick -->
  <section class="section-padding bg-white" aria-labelledby="news-heading">
    <div class="container-wide relative">
      
      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="text-center mb-12 relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Stay Updated
        </p>
        <h1
          id="news-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
        >
          Latest News
        </h1>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-6 text-dark/70 max-w-2xl mx-auto"
          style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
        >
          Project updates, impact stories, and announcements from our programmes across Kenya.
        </p>
      </div>

      {/* Category Filters */}
      <div class="flex flex-wrap justify-center gap-2 mb-12 relative z-10" role="group" aria-label="Filter news by category">
        {categories.map((category) => (
          <button
            type="button"
            data-news-filter={category}
            class={`px-4 py-2.5 text-sm font-medium rounded-lg border-2 border-dark/10 transition-colors ${category === 'All' ? 'bg-primary text-white border-primary' : 'bg-cream text-dark/60 hover:bg-primary hover:text-white hover:border-primary'}`}
          >
            {category}
          </button>
        ))}
      </div>

      <div class="relative z-10" data-news-grid>
        
        {/* Featured article */}
        {newsArticles.length > 0 && (
          <div class="mb-12" data-news-category={newsArticles[0].category}>
            <button
              type="button"
              class="group block bg-cream rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 no-underline w-full text-left cursor-pointer"
              onclick="window.openNewsStory && window.openNewsStory(0)"
            >
              <div class="grid md:grid-cols-2">
                <div class="relative h-64 md:h-full overflow-hidden">
                  <img
                    src={newsArticles[0].image}
                    alt={newsArticles[0].title}
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="eager"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent md:bg-gradient-to-r" aria-hidden="true"></div>
                </div>
                <div class="p-8 lg:p-10 flex flex-col justify-center">
                  <span class="inline-flex items-center gap-1.5 text-accent text-xs font-semibold tracking-wider uppercase">
                    <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M11 7h2v6h-2zM11 15h2v2h-2z" />
                    </svg>
                    {newsArticles[0].category}
                  </span>
                  <h2 class="mt-3 font-heading font-bold text-dark group-hover:text-primary transition-colors" style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);">
                    {newsArticles[0].title}
                  </h2>
                  <p class="mt-4 text-dark/60 leading-relaxed" style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);">
                    {newsArticles[0].excerpt}
                  </p>
                  <div class="mt-6 flex items-center gap-3">
                    <span class="text-dark/40 text-sm">{newsArticles[0].date}</span>
                    <span class="text-primary font-semibold text-sm group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                      Read more
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                      </svg>
                    </span>
                  </div>
                </div>
              </div>
            </button>
          </div>
        )}

        {/* Article grid */}
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
          {newsArticles.slice(1).map((article, index) => (
            <button
              type="button"
              class="group bg-cream rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 flex flex-col no-underline w-full text-left cursor-pointer"
              data-news-category={article.category}
              onclick={`window.openNewsStory && window.openNewsStory(${index + 1})`}
            >
              <div class="relative h-48 overflow-hidden">
                <img
                  src={article.image}
                  alt={article.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                  loading="lazy"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent" aria-hidden="true"></div>
                <div class="absolute top-4 left-4">
                  <span class="text-white/90 text-xs font-semibold bg-dark/30 px-2.5 py-1 rounded-full tracking-wider uppercase">
                    {article.category}
                  </span>
                </div>
              </div>

              <div class="p-6 flex flex-col flex-1">
                <h2 class="font-heading font-bold text-dark group-hover:text-primary transition-colors" style="font-size: 1.125rem; line-height: 1.4;">
                  {article.title}
                </h2>
                <p class="mt-3 text-dark/50 text-sm leading-relaxed flex-1">{article.excerpt}</p>
                <div class="mt-4 pt-4 border-t border-dark/10 flex items-center justify-between">
                  <span class="text-dark/40 text-xs">{article.date}</span>
                  <span class="text-primary font-semibold text-xs group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">
                    Read more
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                    </svg>
                  </span>
                </div>
              </div>
            </button>
          ))}
        </div>

        {/* No results */}
        <div id="news-no-results" class="hidden text-center py-12">
          <p class="text-dark/40">No news found in this category.</p>
        </div>

        {/* Newsletter CTA */}
        <div class="mt-16 text-center">
          <div class="bg-cream rounded-3xl p-10 max-w-lg mx-auto">
            <div class="w-12 h-12 mx-auto flex items-center justify-center rounded-2xl bg-primary/10 text-primary mb-4">
              <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
              </svg>
            </div>
            <h2 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);">
              Stay informed
            </h2>
            <p class="mt-2 text-dark/60 text-sm">Subscribe to receive updates on our work, impact stories, and opportunities.</p>
            <form class="mt-6 flex flex-col sm:flex-row gap-2" data-netlify="true" action="/newsletter" method="POST">
              <label for="news-email" class="sr-only">Your email address</label>
              <input
                type="email"
                name="email"
                id="news-email"
                placeholder="your@email.com"
                required
                autocomplete="email"
                class="flex-1 px-4 py-2.5 bg-white border border-dark/10 rounded-[5px] text-dark placeholder:text-dark/30 text-sm focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
              />
              <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />
              <button
                type="submit"
                class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-white bg-primary rounded-[5px] hover:bg-primary-light shrink-0"
              >
                Subscribe
              </button>
            </form>
          </div>
        </div>
      </div>

    </div>
  </section>

  {/* News modal */}
  <dialog
    id="news-modal"
    class="fixed inset-0 z-50 w-full h-full max-w-none max-h-none m-0 p-0 bg-dark/95 backdrop-blur-sm"
    aria-label="News story"
  >
    <div class="flex flex-col h-full relative">
      <div class="flex items-center justify-between px-6 py-4 bg-dark/50 shrink-0">
        <p id="news-modal-category" class="text-accent text-xs font-semibold tracking-wider uppercase"></p>
        <button
          type="button"
          id="news-modal-close"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
          aria-label="Close story"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>
      <div class="flex-1 overflow-y-auto">
        <div class="max-w-3xl mx-auto px-6 py-8 md:py-12">
          <img id="news-modal-image" src="" alt="" class="w-full rounded-2xl shadow-2xl object-cover aspect-[16/9] mb-8" />
          <h2 id="news-modal-title" class="font-heading font-bold text-white" style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"></h2>
          <p id="news-modal-date" class="mt-3 text-white/50 text-sm"></p>
          <div id="news-modal-body" class="mt-6 text-white/70 leading-relaxed space-y-4" style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"></div>
        </div>
      </div>
    </div>
  </dialog>

  <script set:html={`window.__newsArticles = ${articlesJson};`} />

  <script>
    const articles = window.__newsArticles;

    function openNewsStory(index: number) {
      const article = articles[index];
      if (!article) return;

      document.getElementById('news-modal-category').textContent = article.category;
      document.getElementById('news-modal-title').textContent = article.title;
      document.getElementById('news-modal-date').textContent = article.date;
      document.getElementById('news-modal-image').src = article.image;
      document.getElementById('news-modal-image').alt = article.title;

      const bodyEl = document.getElementById('news-modal-body');
      bodyEl.innerHTML = '';
      article.fullStory.split('\\n\\n').forEach((paragraph) => {
        const p = document.createElement('p');
        p.textContent = paragraph;
        bodyEl.appendChild(p);
      });

      document.getElementById('news-modal').showModal();
      document.body.style.overflow = 'hidden';
    }

    function closeNewsModal() {
      document.getElementById('news-modal').close();
      document.body.style.overflow = '';
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('news-modal-close').addEventListener('click', closeNewsModal);

      document.addEventListener('keydown', (e) => {
        const dialog = document.getElementById('news-modal');
        if (!dialog || !dialog.open) return;
        if (e.key === 'Escape') closeNewsModal();
      });

      document.getElementById('news-modal').addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closeNewsModal();
      });

      window.openNewsStory = openNewsStory;
    });

    function initNewsFilters() {
      const filterButtons = document.querySelectorAll('[data-news-filter]');
      const cards = document.querySelectorAll('[data-news-category]');
      const noResults = document.getElementById('news-no-results');
      
      let activeFilter = 'All';

      function applyFilters() {
        let visibleCount = 0;

        cards.forEach((card) => {
          const category = card.getAttribute('data-news-category') || '';
          const shouldShow = activeFilter === 'All' || category === activeFilter;
          card.classList.toggle('hidden', !shouldShow);
          if (shouldShow) visibleCount++;
        });

        if (noResults) {
          noResults.classList.toggle('hidden', visibleCount > 0);
        }
      }

      filterButtons.forEach((btn) => {
        btn.addEventListener('click', () => {
          activeFilter = btn.getAttribute('data-news-filter') || 'All';
          
          filterButtons.forEach((other) => {
            const isActive = other === btn;
            other.classList.toggle('bg-primary', isActive);
            other.classList.toggle('text-white', isActive);
            other.classList.toggle('border-primary', isActive);
            other.classList.toggle('bg-cream', !isActive);
            other.classList.toggle('text-dark/60', !isActive);
          });

          applyFilters();
        });
      });
    }

    initNewsFilters();
    document.addEventListener('astro:page-load', initNewsFilters);
  </script>
</MainLayout>