---
// About page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024)
import MainLayout from '../layouts/MainLayout.astro';
import AboutHero from '../components/about/AboutHero.astro';
import OurStory from '../components/about/OurStory.astro';
import MissionVision from '../components/about/MissionVision.astro';
import CoreValues from '../components/about/CoreValues.astro';
import OurModel from '../components/about/OurModel.astro';
import GovernanceSection from '../components/about/GovernanceSection.astro';
import WhereWeWork from '../components/about/WhereWeWork.astro';
import TargetGroups from '../components/about/TargetGroups.astro';
import DonorRecognition from '../components/about/DonorRecognition.astro';
import AboutCTA from '../components/about/AboutCTA.astro';

// Helper function to build clean base-aware internal URLs
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="About Us"
  description="USTADI Foundation is a registered Kenyan organisation promoting transformation and growth of youth and women enterprises through demand-driven professional capacity development since 2010."
  currentPage="about"
>
  <!-- 1. Hero -->
  <AboutHero
    headline="Promoting transformation and growth of youth and women enterprises since 2010"
    subheadline="USTADI is a registered Kenyan organisation that was started by a consortium of 21 organisations led by SNV and HIVOs, promoting capacity development initiatives across Kenya. Formally registered in 2012, we work through a market facilitation model that strengthens both the demand and supply sides of capacity development services."
    image={{
      src: getUrl('/images/about/about-hero.jpg'),
      alt: 'USTADI Foundation team working with youth and women entrepreneurs in rural Kenya',
    }}
  />

  <!-- 2. Our Story -->
  <OurStory
    heading="Our Story"
    milestones={[
      {
        year: '2010',
        title: 'Founded by a consortium of 21 organisations',
        description: 'USTADI began as a capacity development initiative led by SNV and HIVOs, bringing together 21 organisations to promote professional capacity development services across Kenya.',
      },
      {
        year: '2012',
        title: 'Formally registered as a Company Limited by Guarantee',
        description: 'USTADI received its certificate of registration (CPR/2012/70718), establishing its legal identity as a Kenyan organisation focused on enterprise development.',
      },
      {
        year: '2014',
        title: 'First major youth programme launched',
        description: 'Selected by the ILO as the implementing partner for the Youth-to-Youth Fund in Kenya, supporting 34 youth-led organisations and creating over 1,100 jobs.',
      },
      {
        year: '2018',
        title: 'VIJABIZ: Scaling youth agribusiness',
        description: 'Launched the Youth Economic Empowerment through Agribusiness project with IFAD and CTA, reaching 173 youth groups and over 1,550 direct participants.',
      },
      {
        year: '2021',
        title: 'JOY Project: Integrated agribusiness hubs',
        description: 'Began a 4-year partnership with IFAD, Visa Foundation, ILO, and Procasur to establish agribusiness hubs across Kilifi, Kakamega, and Nakuru counties.',
      },
    ]}
  />

  <!-- 3. Vision & Mission (verbatim from profile) -->
  <MissionVision
    vision={{
      heading: 'Our Vision',
      body: 'Vibrant and self-sustaining markets delivering improved income and livelihoods for rural communities.',
    }}
    mission={{
      heading: 'Our Mission',
      body: 'To promote transformation and growth of youth and women enterprises and their related institutions, in Food Security and Nutrition, WaSH, Climate solutions and the SME sectors, by stimulating demand driven professional capacity development, investments, innovative financing and market systems development to deliver sustainable economic, social and environmental development to target communities.',
    }}
  />

  <!-- 4. Core Values — EQUIP -->
  <CoreValues
    heading="Our Core Values"
    subheading="The EQUIP framework guides everything we do."
    values={[
      {
        letter: 'E',
        title: 'Empowering',
        description: 'Equipping youth and women with the skills and confidence to lead their own development.',
      },
      {
        letter: 'Q',
        title: 'Quality',
        description: 'Pursuing excellence in all our capacity development services and programmes.',
      },
      {
        letter: 'U',
        title: 'Uniting',
        description: 'Connecting stakeholders across sectors to create lasting partnerships.',
      },
      {
        letter: 'I',
        title: 'Innovation',
        description: 'Developing creative solutions to enterprise and market challenges.',
      },
      {
        letter: 'P',
        title: 'Partnership',
        description: 'Working collaboratively with communities, governments, and funders.',
      },
    ]}
  />

  <!-- 5. Our Model — Three pillars -->
  <OurModel
    heading="Our Model"
    subheading="USTADI's strategy revolves around three complementary pillars that promote capacity development as the core — not as an add-on."
    pillars={[
      {
        number: '01',
        title: 'Market Facilitation Services',
        description: 'Face-to-face market matchmaking events, trade fairs, and linkages that connect youth and women entrepreneurs to buyers, suppliers, and business opportunities.',
      },
      {
        number: '02',
        title: 'Technical Assistance Grants and Investments',
        description: 'Providing financial support, procurement and grant management, and innovative financing solutions including crowdfunding to help enterprises grow sustainably.',
      },
      {
        number: '03',
        title: 'Learning and Sharing Platform',
        description: 'Knowledge development through best practice documentation, quality assurance, policy advocacy, and competitively priced professional services at the local level.',
      },
    ]}
  />

  <!-- 6. Governance -->
  <GovernanceSection
    heading="Governance and Management"
    board={{
      heading: 'Board of Directors',
      description: 'The Board of Directors is the key governance body providing leadership and guidance to management. The Board delegates responsibility for day-to-day management to the Chief Executive Officer.',
      members: 'Currently composed of 5 Directors.',
    }}
    management={{
      heading: 'Management Team',
      description: 'The management team comprises senior professionals who oversee the organisation\'s programmes, finance, grants, and monitoring functions under the leadership of the CEO.',
      roles: [
        'Chief Executive Officer and Team Leader',
        'Finance, Grants, and Administration Manager',
        'Head of Programmes (Business Development Services)',
        'Head of Monitoring and Evaluation',
        'Several staff supporting various departments',
      ],
    }}
  />

  <!-- 7. Where We Work -->
  <WhereWeWork
    heading="Where We Work"
    description="USTADI's head office is situated in Nairobi, Kenya, with field offices in Kilifi and Nakuru Counties. Our footprint extends across over 20 counties, reaching rural communities with demand-driven capacity development services."
    stats={[
      { value: '20+', label: 'Counties reached' },
      { value: '2', label: 'Field offices' },
    ]}
    locations={['Nairobi (HQ)', 'Kilifi', 'Nakuru']}
  />

  <!-- 8. Target Groups -->
  <TargetGroups
    heading="Who We Serve"
    groups={[
      { title: 'Rural businesses', icon: 'briefcase' },
      { title: 'Youth and women entrepreneurs', icon: 'users' },
      { title: 'Business Development Services providers', icon: 'building' },
      { title: 'Non-profit organisations', icon: 'heart' },
      { title: 'Farmer groups and associations', icon: 'globe' },
      { title: 'Self-help groups', icon: 'users' },
      { title: 'TVETs and vocational training institutions', icon: 'academic' },
      { title: 'NGOs and other CSOs', icon: 'office' },
      { title: 'County governments', icon: 'building' },
    ]}
  />

  <!-- 9. Donor Recognition -->
  <DonorRecognition
    heading="Our Funding Partners"
    subheading="We are grateful to the organisations that support our work across Kenya."
    donors={[
      { name: 'SNV', logo: getUrl('/images/donors/snv.svg') },
      { name: 'IFAD', logo: getUrl('/images/donors/ifad.svg') },
      { name: 'ILO', logo: getUrl('/images/donors/ilo.svg') },
      { name: 'European Union', logo: getUrl('/images/donors/eu.svg') },
      { name: 'USAID', logo: getUrl('/images/donors/usaid.svg') },
      { name: 'Visa Foundation', logo: getUrl('/images/donors/visa-foundation.svg') },
      { name: 'Mastercard Foundation', logo: getUrl('/images/donors/mastercard-foundation.svg') },
      { name: "Land O'Lakes", logo: getUrl('/images/donors/landolakes.svg') },
      { name: 'USADF', logo: getUrl('/images/donors/usadf.svg') },
      { name: 'KALRO', logo: getUrl('/images/donors/kalro.svg') },
      { name: 'Pathfinder International', logo: getUrl('/images/donors/pathfinder.svg') },
      { name: 'GIZ', logo: getUrl('/images/donors/giz.svg') },
      { name: 'ChildFund', logo: getUrl('/images/donors/childfund.svg') },
      { name: 'Self Help Africa', logo: getUrl('/images/donors/self-help-africa.svg') },
      { name: 'Procasur', logo: getUrl('/images/donors/procasur.svg') },
      { name: 'CTA', logo: getUrl('/images/donors/cta.svg') },
      { name: 'HIVOS', logo: getUrl('/images/donors/hivos.svg') },
      { name: 'Safaricom Foundation', logo: getUrl('/images/donors/safaricom-foundation.svg') },
      { name: 'CoELIB', logo: getUrl('/images/donors/coelib.svg') },
      { name: 'TechnoServe', logo: getUrl('/images/donors/technoserve.svg') },
      { name: 'ACT (Act Change Transform)', logo: getUrl('/images/donors/act.svg') },
    ]}
  />

  <!-- 10. CTA -->
  <AboutCTA
    heading="Partner with us to transform rural livelihoods"
    body="We work with county governments, the private sector, and development partners to deliver sustainable impact. Explore our programmes or get in touch to discuss collaboration."
    primaryCta={{ label: 'Our programmes', href: getUrl('/programs') }}
    secondaryCta={{ label: 'Contact us', href: getUrl('/contact') }}
  />
</MainLayout>