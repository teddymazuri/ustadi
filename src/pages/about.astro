---
// Redirect from /about to /about/mission-vision
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const redirectUrl = `${base}/about/mission-vision`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta http-equiv="refresh" content={`0;url=${redirectUrl}`} />
    <link rel="canonical" href={redirectUrl} />
    <title>Redirecting...</title>
  </head>
  <body>
    <p>Redirecting to <a href={redirectUrl}>Mission & Vision</a>...</p>
  </body>
</html>