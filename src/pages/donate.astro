---
// Donate page — USTADI Foundation
import MainLayout from '../layouts/MainLayout.astro';
import ScribbleCircle from '../components/shared/ScribbleCircle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="Donate"
  description="Support USTADI Foundation's mission to promote transformation and growth of youth and women enterprises across Kenya through demand-driven capacity development."
  currentPage="donate"
>
  <!-- Hero -->
  <section class="section-padding bg-white" aria-labelledby="donate-heading">
    <div class="container-tight text-center relative">
      
      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Support Our Work
        </p>
        <h1
          id="donate-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
        >
          Make a Donation
        </h1>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-6 text-dark/70 max-w-2xl mx-auto"
          style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
        >
          Your contribution directly supports capacity development programmes that equip youth and women entrepreneurs with the skills, resources, and opportunities they need to build sustainable livelihoods.
        </p>
      </div>
    </div>
  </section>

  <!-- Impact reminder -->
  <section class="pb-16 bg-white" aria-label="Your impact">
    <div class="container-wide">
      <div class="grid sm:grid-cols-3 gap-6 max-w-4xl mx-auto">
        {[
          { value: '500,000+', label: 'Rural households reached' },
          { value: '300+', label: 'Youth groups supported' },
          { value: '20+', label: 'Counties across Kenya' },
        ].map((stat) => (
          <div class="bg-cream rounded-3xl p-6 text-center">
            <p class="font-heading font-bold text-primary" style="font-size: var(--text-heading-md); line-height: 1;">
              {stat.value}
            </p>
            <p class="mt-2 text-dark/50 text-sm">{stat.label}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Donation Options -->
  <section class="section-padding bg-cream" aria-labelledby="ways-heading">
    <div class="container-tight">
      
      <div class="text-center mb-12">
        <h2
          id="ways-heading"
          class="font-heading font-bold text-dark"
          style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
        >
          Ways to Give
        </h2>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
      </div>

      <div class="grid md:grid-cols-2 gap-6 max-w-3xl mx-auto">
        
        <div class="bg-white rounded-3xl p-8 shadow-card">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-primary/10 text-primary mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);">
            Bank Transfer
          </h3>
          <p class="mt-3 text-dark/60 text-sm leading-relaxed">
            Make a direct deposit to our account. Please contact us for our banking details and to let us know about your contribution.
          </p>
          <a
            href="mailto:info@ustadi.org"
            class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-primary hover:text-primary-light no-underline"
          >
            Request banking details
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

        <div class="bg-white rounded-3xl p-8 shadow-card">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-accent/10 text-accent mb-5">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z" />
            </svg>
          </div>
          <h3 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);">
            M-Pesa
          </h3>
          <p class="mt-3 text-dark/60 text-sm leading-relaxed">
            Send your donation via M-Pesa. Please contact us for our paybill number and to receive a receipt for your contribution.
          </p>
          <a
            href="tel:+254707387313"
            class="inline-flex items-center gap-1.5 mt-5 text-sm font-semibold text-primary hover:text-primary-light no-underline"
          >
            Call for details
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
        </div>

      </div>

      <p class="mt-8 text-center text-dark/40 text-sm max-w-md mx-auto leading-relaxed">
        USTADI Foundation is a registered Kenyan organisation. All contributions go directly to supporting our programmes. Contact us at <a href="mailto:info@ustadi.org" class="text-primary font-semibold hover:text-primary-light no-underline">info@ustadi.org</a> for any questions about donating.
      </p>

    </div>
  </section>

  <!-- Quote CTA -->
  <section class="section-padding bg-primary relative overflow-hidden" aria-labelledby="cta-heading">
    <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/5" aria-hidden="true"></div>
    <div class="absolute -bottom-8 -left-8 w-32 h-32 rounded-full bg-accent/10" aria-hidden="true"></div>
    
    <div class="container-tight text-center relative">
      <div class="w-16 h-16 mx-auto flex items-center justify-center rounded-2xl bg-accent text-dark mb-6 shadow-lg">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />
        </svg>
      </div>
      <h2
        id="cta-heading"
        class="font-heading font-bold text-white"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        Every contribution creates opportunity
      </h2>
      <p
        class="mt-5 text-white/70 max-w-lg mx-auto"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        Your support helps us provide technical assistance grants, business training, mentorship, and market linkages to youth and women entrepreneurs across Kenya.
      </p>
      <a
        href={getUrl('/contact')}
        class="inline-flex items-center justify-center px-8 py-4 mt-8 font-semibold text-dark bg-accent rounded-xl hover:bg-accent/90 no-underline shadow-lg"
        style="font-size: var(--text-body-base);"
      >
        Get in touch to donate
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>
</MainLayout>