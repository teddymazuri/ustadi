---
// History page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024) + FAO Fisheries, GSMESKILL, Wezesha III, BlueBiz
import MainLayout from '../../layouts/MainLayout.astro';
import HistoryIntro from '../../components/about/HistoryIntro.astro';
import OurStory from '../../components/about/OurStory.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="History"
  description="USTADI Foundation was founded in 2011 by a consortium of 21 organisations led by SNV and HIVOS. Formally registered in 2012, USTADI has grown to reach over 500,000 rural households across Kenya."
  currentPage="about"
>
  <OurStory
    heading="Our History"
    subheading="A legacy of localising capacity development"
    intro="USTADI Foundation (from the Swahili word USTADI, meaning 'skilful') was established to promote professional capacity development as the core of enterprise growth rather than an add-on. Since 2011, we have evolved from a multi-institutional consortium into a Company Limited by Guarantee and a Trust, reaching over 500,000 rural households across Kenya."
    milestones={[]}
  />

  <HistoryIntro
    heading="Our Origins & Legal Evolution"
    content={[
      {
        year: '2011',
        title: 'Establishment',
        description: 'USTADI was established in 2011 by the Netherlands Development Organisation (SNV), HIVOS, and a consortium of 21 local capacity development institutions. The initiative set out to build a coalition of change across the private sector, civil society, government, and financial service providers to strengthen sub-national (rural) capacity development markets.',
      },
      {
        year: '2012–2014',
        title: 'Registration',
        description: 'To solidify its long-term national mandate, USTADI was registered as a Company Limited by Guarantee in 2012 and formally registered as a Trust in 2014. This established USTADI\'s two-pronged governance structure, led by a Board of Trustees and a Board of Directors.',
      },
    ]}
  />

  <OurStory
    heading="Key Milestones & Project Portfolio"
    milestones={[
      {
        year: '2011–2014',
        title: 'Founding Facility',
        description: 'Launched the Localization of Demand-Driven Professional Capacity Development project with SNV and HIVOS, laying the foundation for USTADI\'s market facilitation model.',
        href: getUrl('/projects#project-snv-localization'),
      },
      {
        year: '2013',
        title: 'Agro-Enterprise Expansion',
        description: 'Implemented HIVOS-funded capacity development and market facilitation across Migori (pineapples), Homa Bay (pineapples), Kilifi (chilli farming with Equator Kenya Limited), and Kwale (seaweed production and marketing) counties.',
        href: getUrl('/projects#project-agro-enterprise-expansion'),
      },
      {
        year: '2014–2015',
        title: 'Seaweed & Fish Farming',
        description: 'Upscaled seaweed farming and fresh marine fish marketing in Kwale and Kilifi.',
        href: getUrl('/projects#project-seaweed-fish-farming'),
      },
      {
        year: '2014–2015',
        title: 'Climate Change & Adaptation',
        description: 'Implemented the Kilifi Integrated Climate Change and Adaptation Project (KICCAP).',
        href: getUrl('/projects#project-kiccap'),
      },
      {
        year: '2014–2015',
        title: 'Youth-to-Youth Fund (Y2YF)',
        description: 'Selected by the ILO to manage the Y2Y Fund in Kenya. The programme supported 34 youth-led organisations, creating 1,171 jobs and 681 new businesses nationwide.',
        href: getUrl('/projects#project-y2yf'),
      },
      {
        year: '2015–2016',
        title: 'Kenya Semi-Arid Livestock Enhancement Support (K-SALES)',
        description: 'Partnered with Land O\'Lakes on the K-SALES project to boost semi-arid livestock value chains in Machakos, Kitui, Makueni, and Embu counties.',
        href: getUrl('/projects#project-ksales'),
      },
      {
        year: '2015–2017',
        title: 'Cashew Production & Marketing',
        description: 'Supported by the Walmart Foundation through Self Help Africa to expand cashew production and increase women\'s income in Kilifi.',
        href: getUrl('/projects#project-cashew-production'),
      },
      {
        year: '2016–2017',
        title: 'Civil Society Capacity Development',
        description: 'Led the Global South pilot programme supported by ORGUT Consulting, providing capacity building, advocacy, and grant management support to 23 CSOs across Nairobi, Mombasa, and Nyanza.',
        href: getUrl('/projects#project-civil-society-capacity'),
      },
      {
        year: '2017–2020',
        title: 'Water & Sanitation Initiatives',
        description: 'Implemented low-cost water and sanitation initiatives at the community level through the Afya Pwani WaSH project in Kilifi, funded by Pathfinder International.',
        href: getUrl('/projects#project-afya-pwani'),
      },
      {
        year: '2017–2022',
        title: 'Cassava Value Chain Competitiveness',
        description: 'Implemented a 4.5-year cassava value chain project reaching over 10,000 smallholder farmers in Kilifi and Kitui counties, funded by the European Union through Self Help Africa.',
        href: getUrl('/projects#project-cassava-value-chain'),
      },
      {
        year: '2018–2020',
        title: 'Youth Economic Empowerment Through Agribusiness (VIJABIZ)',
        description: 'Secured $2.1 million from IFAD and CTA to launch VIJABIZ, supporting 173 youth agribusiness groups (48 in Kilifi and 125 in Nakuru) and awarding direct grants to 72 agri-enterprises.',
        href: getUrl('/projects#project-vijabiz'),
      },
      {
        year: '2020–2022',
        title: 'Post-COVID Resilience',
        description: 'Partnered with USADF to build resilience and cushion enterprises supported during the VIJABIZ project against the COVID-19 pandemic.',
        href: getUrl('/projects#project-covid-resilience'),
      },
      {
        year: '2020–2022',
        title: 'Technology Upscaling',
        description: 'Partnered with EU and KALRO to scale up agricultural technologies for smallholder farmers in the mango, cashew, and fish (aquaculture and mariculture) value chains in Kilifi County.',
        href: getUrl('/projects#project-kalro-ag-tech'),
      },
      {
        year: '2021–2022',
        title: 'Soy Production',
        description: 'Partnered with EU and AGRIFI on the SOYPAM project to strengthen soy production.',
        href: getUrl('/projects#project-soypam'),
      },
      {
        year: '2021–2023',
        title: 'Environmental Management for Jobs & Income (EMAJIC)',
        description: 'Implemented in partnership with ChildFund Kenya and funded by BMZ Germany. The project contributed to more effective and efficient waste management, a healthier natural environment, and improved livelihoods for women and youth working in the waste recycling sector in Kasarani Sub-County, Nairobi County. The objective was to improve efficiency in solid waste management, hygiene, health, and livelihoods for 700 beneficiaries (60% youth and 40% women) who are unemployed and socially and economically disadvantaged.',
        href: getUrl('/projects#project-emajic'),
      },
      {
        year: '2021–2025',
        title: 'Integrated Agribusiness Hubs (JOY Project)',
        description: 'Launched the IFAD, Procasur, ILO, and USTADI-funded JOY (Jobs Open For The Youth) Project Phase 1 ($1.25M), establishing integrated agribusiness hubs in Kilifi, Kakamega, and Nakuru counties.',
        href: getUrl('/projects#project-joy-project'),
      },
      {
        year: '2021–2024',
        title: 'BlueBiz',
        description: 'Funded by the Mastercard Foundation through TechnoServe. The project enhances the socio-economic sustenance of youth by supporting specific Blue Economy value chains. It targets marine and aquatic development through tilapia and shrimp farming, fish feed creation, and seaweed cultivation, while also promoting artisanal craft sales and environmental conservation through mangrove restoration. Additionally, it incorporates land-based production ventures including livestock farming, honey production, mango drying, and the cultivation of cashew, coconut, and cassava.',
        href: getUrl('/projects#project-bluebiz'),
      },
      {
        year: '2023–2025',
        title: 'GSMESKILL — VET Entrepreneurial Green Mindset',
        description: 'Launched a 36-month Erasmus+ Capacity Building in VET project strengthening links between VET systems and labour markets in Kenya, Nigeria, and South Africa. USTADI led Kenya-focused research, policy advisory groups, and Awareness Days on inclusive VET policy recommendations.',
        href: getUrl('/projects#project-gsmeskill'),
      },
      {
        year: '2024–2027',
        title: 'WEZESHA 3',
        description: 'A transformative youth empowerment initiative funded by the Safaricom Foundation in partnership with USTADI Foundation and the Lake Basin Development Authority (LBDA), designed to promote agribusiness, innovation, and sustainability in Busia County.',
        href: getUrl('/projects#project-wezesha-iii'),
      },
      {
        year: '2026',
        title: 'FAO Fisheries Technical Assistance',
        description: 'Commenced technical assistance to improve the functional capacity of small-scale fishers and the profitability of targeted fisher communities in Kwale and Lamu counties. Funded by FAO through AFRACA, with USTADI as implementing partner.',
        href: getUrl('/projects#project-fao-fisheries'),
      },
    ]}
  />

  <section class="section-padding bg-primary relative overflow-hidden">
    <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/5" aria-hidden="true"></div>
    <div class="absolute -bottom-8 -left-8 w-32 h-32 rounded-full bg-accent/10" aria-hidden="true"></div>
    
    <div class="container-tight text-center relative">
      <div class="w-16 h-16 mx-auto flex items-center justify-center rounded-2xl bg-accent text-dark mb-6 shadow-lg">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h2 class="font-heading font-bold text-white" style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);">
        Be Part of Our Next Chapter
      </h2>
      <p class="mt-5 text-white/70 max-w-lg mx-auto" style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);">
        We continuously partner with county governments, international development agencies, and local communities to scale sustainable solutions across Kenya.
      </p>
      <a
        href={getUrl('/contact')}
        class="inline-flex items-center justify-center px-8 py-4 mt-8 font-semibold text-dark bg-accent rounded-lg hover:bg-accent/90 no-underline shadow-lg"
        style="font-size: var(--text-body-base);"
      >
        Partner with us
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

</MainLayout>