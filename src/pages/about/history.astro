---
// History page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024) + FAO Fisheries & GSMESKILL
import MainLayout from '../../layouts/MainLayout.astro';
import HistoryIntro from '../../components/about/HistoryIntro.astro';
import OurStory from '../../components/about/OurStory.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="History"
  description="USTADI Foundation was founded in 2011 by a consortium of 21 organisations led by SNV and HIVOs. Formally registered in 2012, USTADI has grown to reach over 500,000 rural households across Kenya."
  currentPage="about"
>
  <OurStory
    heading="Our History"
    subheading="A legacy of localizing capacity development"
    intro="USTADI Foundation (from the Swahili word USTADI, meaning 'skillful') was established to promote professional capacity development as the core of enterprise growth rather than an add-on. Since 2011, we have evolved from a multi-institutional consortium into a Company Limited by Guarantee and a Trust, reaching over 500,000 rural households across Kenya."
    milestones={[]}
  />

  <HistoryIntro
    heading="Our Origins & Legal Evolution"
    content={[
      {
        year: '2011',
        title: 'Establishment',
        description: 'USTADI was established in 2011 by the Netherlands Development Organisation (SNV), HIVOS, and a consortium of 21 local capacity development institutions. The initiative set out to build a coalition of change across the private sector, civil society, government, and financial service providers to strengthen sub-national (rural) capacity development markets.',
      },
      {
        year: '2012–2014',
        title: 'Registration',
        description: 'To solidify its long-term national mandate, USTADI was registered as a Company Limited by Guarantee in 2012 and formally registered as a Trust in 2014. This established USTADI\'s two-pronged governance structure, led by a Board of Trustees and a Board of Directors.',
      },
    ]}
  />

  <OurStory
    heading="Key Milestones & Project Portfolio"
    milestones={[
      {
        year: '2011-2014',
        title: 'Localization of Demand-Driven Professional Capacity Development project',
        description: 'Launched the Localization of Demand-Driven Professional Capacity Development project with SNV and HIVOS, laying the foundation for USTADI\'s market facilitation model.',
      },
      {
        year: '2013',
        title: 'Agro-Enterprise Expansion',
        description: 'Implemented HIVOS-funded capacity development and market facilitation across Migori(Pineapples), Homa Bay(Pineapples), Kilifi(Chillie Farming with Equator Kenya Limited), and Kwale(Seaweed Production and Marketing) counties.',
      },
      {
        year:'2014-2015',
        title: 'Seaweed farming & fish farming, and marketing in Kwale and Kilifi',
        description: 'Upscaling Seaweed farming and Fresh Marine fish marketing in Kwale and Kilifi.',
      },
      {
        year:'2014-2015',
        title:'Climate change and adaptation',
        description:'Kilifi Integrated climate change and adaptation project(KICCAP).',
      },
      {
        year: '2014-2015',
        title: 'Youth-to-Youth Fund (Y2YF)',
        description: 'Selected by the ILO to manage the Y2Y Fund in Kenya. The program supported 34 youth-led organizations, creating 1,171 jobs and 681 new businesses nationwide.',
      },
      {
        year: '2015-2016',
        title: 'Kenya Semi-Arid Livestock Enhancement Support (K-SALES) Project',
        description: 'Partnered with Land O\'Lakes on the K-SALES project to boost semi-arid livestock value chains in the counties of Machakos, Kitui, Makueni, Embu.',
      },
      {
        year: '2015-2017',
        title: 'Increasing Women\'s Income through cashew production and marketing in Kilifi',
        description: 'Supported by the Walmart Foundation through Self Help Africa to expand cashew production for women in Kilifi.',
      },
      {
        year: '2016-2017',
        title: 'Civil Society Capacity Development',
        description: 'Led the Global South pilot program supported by ORGUT Consulting, providing capacity building, advocacy, and grant management support to 23 CSOs across Nairobi, Mombasa, and Nyanza.',
      },
      {
        year: '2017-2020',
        title: 'Water and Sanitation Initiatives',
        description: 'Implemented low-cost and water sanitation initiatives at the community level(Afya Pwani WaSH project in Kilifi), funded by Pathfinder International.',
      },
      {
        year: '2017-2022',
        title: 'Strengthening the competitiveness of the cassava value-chain in Kilifi and Kitui Counties',
        description: 'Implemented a 4.5-year cassava value chain project reaching over 10,000 smallholder farmers, funded by the European Union through Self Help Africa.',
      },
      {
        year: '2018-2020',
        title: 'Youth Economic Empowerment Through Agribusiness in Kenya (VIJABIZ)',
        description: 'Secured $2.1 million from IFAD and CTA to launch VIJABIZ, supporting 173 youth agribusiness groups( 48 in Kilifi & 125 in Nakuru) and awarding direct grants to 72 agri-enterprises In Kilifi and Nakuru Counties',
      },
      {
        year: '2020-2022',
        title: 'Post-COVID Resilience',
        description: 'Partnered with USADF to build resilience and cushion enterprises supported during the VIJABIZ project against the COVID-19 pandemic. ',
      },
      {
        year: '2020–2022',
        title: 'Tech Upscaling',
        description: 'Partnered with EU/KALRO to scale up agricultural technologies for smallholders famers in the Mango,Cashew, and Fish(Aquaculture & Mariculture) value-chains in Kilifi County.',
      },
      {
        year: '2021-2022',
        title: 'Soy Production',
        description: 'Partnered with EU/AGRIFI on the SOYPAM project to strengthen soy production.',
      },
      {
        year: '2021–2023',
        title: 'Environmental Management for Jobs & Income Creation for Youth and Women (EMAJIC)',
        description: 'Implemented by USTADI Foundation in partnership with ChildFund Kenya, funded by BMZ Germany, To contribute to a more effective and efficient waste management, a healthy natural environment, and improved livelihood situation of women and youth working in the wste recycling sector in Kasarani Sub-county in Nairobi County. Specifically the objective was to improve efficiency in solid waste management for clean environment, improved hygiene, health, and livelihoods trageting 700 beneficiaries(60% youth and 40% women) who are unemployed and are socially and economically disadvantaged.',
      },
      {
        year: '2021-2025',
        title: 'Integrated Agribusiness Hubs Projects',
        description: 'Launched the IFAD/Procasur/ILO/USTADI-funded JOY(Jobs Open For The Youth) Project (Phase-1 2021-2025) ($1.25M), establishing integrated agribusiness hubs in Kilifi, Kakamega, and Nakuru counties.',
      },
      {
        year: '2021–2024',
        title: 'BlueBiz',
        description: 'Funded by the Mastercard Foundation through Technoserve. To enhance the socio-economic sustenance of youth by supporting specific Blue Economy value chains. It targets marine and aquatic development through tilapia and shrimp farming, fish feed creation, and seaweed cultivation, while also promoting artisanal craft sales and environmental conservation via mangrove restoration. Additionally, it incorporates land-based production ventures including livestock farming, honey production, mango drying, and the cultivation of cashew, coconut, and cassava.',
      },
      {
        year: '2023–2025',
        title: 'GSMESKILL — VET Entrepreneurial Green Mindset',
        description: 'Launched a 36-month Erasmus+ Capacity Building in VET project strengthening links between VET systems and labour markets in Kenya, Nigeria, and South Africa. USTADI led Kenya-focused research, policy advisory groups, and Awareness Days on inclusive VET policy recommendations.',
      },
      {
        year: '2024-2027',
        title: 'WEZESHA 3',
        description: 'A transformative youth empowerment initiative funded by the Safaricom Foundation/USTADI Foundation/Lake Basin Development Authority(LBDA), designed to promote agribusiness, innovation, and sustainability in Busia County.',
      },
      {
        year: '2026',
        title: 'FAO Fisheries Technical Assistance',
        description: 'Commenced technical assistance to improve the functional capacity of small-scale fishers and profitability of targeted fisher communities in Kwale and Lamu Counties. Funded by FAO through AFRACA, with USTADI as implementing partner.',
      },
    ]}
  />

  <section class="section-padding bg-primary relative overflow-hidden">
    <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/5" aria-hidden="true"></div>
    <div class="absolute -bottom-8 -left-8 w-32 h-32 rounded-full bg-accent/10" aria-hidden="true"></div>
    
    <div class="container-tight text-center relative">
      <div class="w-16 h-16 mx-auto flex items-center justify-center rounded-2xl bg-accent text-dark mb-6 shadow-lg">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
        </svg>
      </div>
      <h2 class="font-heading font-bold text-white" style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);">
        Be Part of Our Next Chapter
      </h2>
      <p class="mt-5 text-white/70 max-w-lg mx-auto" style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);">
        We continuously partner with county governments, international development agencies, and local communities to scale sustainable solutions across Kenya.
      </p>
      <a
        href={getUrl('/contact')}
        class="inline-flex items-center justify-center px-8 py-4 mt-8 font-semibold text-dark bg-accent rounded-lg hover:bg-accent/90 no-underline shadow-lg"
        style="font-size: var(--text-body-base);"
      >
        Partner with us
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </section>

</MainLayout>