---
// Governance & Management page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024)
import MainLayout from '../../layouts/MainLayout.astro';
import GovernanceSection from '../../components/about/GovernanceSection.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="Governance & Management"
  description="USTADI Foundation is governed by a Board of 5 Directors and managed by a team led by the Chief Executive Officer, overseeing programmes, finance, grants, and monitoring and evaluation."
  currentPage="about"
>
  <GovernanceSection
    heading="Governance and Management"
    board={{
      heading: 'Board of Directors',
      description: 'The Board of Directors serves as the primary governance body providing strategic leadership and policy oversight to executive management. The Board delegates authority for day to day operations and strategic execution to the Chief Executive Officer.',
      members: 'Composed of five independent Directors bringing diverse expertise across international development, finance, enterprise strategy, and governance.',
    }}
    management={{
      heading: 'Management Team',
      description: 'The executive management team comprises experienced professionals overseeing USTADI programs, finance, grants, and monitoring functions under the leadership of the CEO.',
      roles: [
        'Chief Executive Officer and Team Leader',
        'Finance, Grants, and Administration Manager',
        'Head of Programmes (Business Development Services)',
        'Head of Monitoring and Evaluation',
        'Programmatic and Departmental Support Staff',
      ],
    }}
  />
</MainLayout>