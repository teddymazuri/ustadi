---
// Governance & Management page — USTADI Foundation
// All content sourced from USTADI Institutional Profile (February 2024)
import MainLayout from '../../layouts/MainLayout.astro';
import GovernanceSection from '../../components/about/GovernanceSection.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;
---

<MainLayout
  title="Governance & Management"
  description="USTADI Foundation is governed by a Board of 5 Directors and managed by a team led by the Chief Executive Officer, overseeing programmes, finance, grants, and monitoring and evaluation."
  currentPage="about"
>
    <GovernanceSection
    heading="Governance and Management"
    board={{
      heading: 'Board of Directors',
      description: 'The Board of Directors is the key governance body providing leadership and guidance to management.',
      members: [
        { name: "Professor Ruth Oniang'o", title: 'Board Chair' },
        { name: 'Doctor Anthony Getambu', title: 'Board Member' },
        { name: 'Daniel Chai Baya', title: 'Board Member' },
        { name: 'Rahab Ngumba Njoroge', title: 'Board Member' },
      ],
    }}
    management={{
      heading: 'Management Team',
      description: 'The management team comprises senior professionals overseeing programmes, finance, grants, and monitoring functions under the leadership of the CEO.',
      ceo: {
        name: 'George Yaa Mazuri',
      },
      heads: [
        { title: 'Finance, Grants, and Administration Manager', name: 'Nancy Mwengi Nzoka' },
        { title: 'Head of Programmes (BDS)', name: 'Eric Bororio Bosire' },
        { title: 'Head of Monitoring and Evaluation', name: 'Justus Musau' },
        { title: 'Regional Coordinator (Nairobi, Eastern & Coast)', name: 'Johnson Moyo Malingi' },
        { title: 'Regional Coordinator (Rift Valley, Luo Nyanza & Western)', name: 'Morgan Siguda' },
      ],
    }}
  />
</MainLayout>