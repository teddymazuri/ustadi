---
// Partners page — USTADI Foundation
import MainLayout from '../layouts/MainLayout.astro';
import ScribbleCircle from '../components/shared/ScribbleCircle.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const getUrl = (path: string) => `${base}/${path.replace(/^\//, '')}`;

const implementingPartners = [
  { name: 'CoELIB — Egerton University', logo: getUrl('/images/partners/coelib.svg'), description: 'Centre of Excellence for Livestock Innovation and Business' },
  { name: 'ICT4Development', logo: getUrl('/images/partners/ict4d.svg'), description: 'Technology for development partner' },
  { name: 'Pwani University', logo: getUrl('/images/partners/pwani-university.svg'), description: 'Higher education and research partner' },
  { name: 'TechnoServe', logo: getUrl('/images/partners/technoserve.svg'), description: 'Business solutions to poverty' },
  { name: 'ACT (Act Change Transform)', logo: getUrl('/images/partners/act.svg'), description: 'Community transformation partner' },
];

const countyPartners = [
  { name: 'Kilifi', region: 'Coast' },
  { name: 'Nakuru', region: 'Rift Valley' },
  { name: 'Kakamega', region: 'Western' },
  { name: 'Kitui', region: 'Eastern' },
  { name: 'Nairobi', region: 'Nairobi' },
  { name: 'Mombasa', region: 'Coast' },
  { name: 'Kisumu', region: 'Nyanza' },
  { name: 'Siaya', region: 'Nyanza' },
  { name: 'Machakos', region: 'Eastern' },
  { name: 'Busia', region: 'Western' },
  { name: 'Bungoma', region: 'Western' },
  { name: 'Kwale', region: 'Coast' },
];

const privateSectorPartners = [
  { name: 'East African Grain Council', logo: getUrl('/images/partners/eagc.svg') },
  { name: 'Agricultural Finance Corporation', logo: getUrl('/images/partners/afc.svg') },
];
---

<MainLayout
  title="Partners"
  description="USTADI Foundation works with over 300 youth groups, 12 implementing partners, 18 funding partners, 20 county governments, and private sector allies across Kenya."
  currentPage="partners"
>
  <!-- Hero -->
  <section class="section-padding bg-white" aria-labelledby="partners-hero-heading">
    <div class="container-wide">
      <div class="grid md:grid-cols-2 gap-12 lg:gap-16 items-center">
        
        {/* Text */}
        <div class="relative">
          <ScribbleCircle
            size={200}
            opacity={0.45}
            rotation={-10}
            class="absolute -top-10 left-0 z-0"
          />
          <div class="relative z-10">
            <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
              Our Network
            </p>
            <h1
              id="partners-hero-heading"
              class="mt-4 font-heading font-bold text-dark text-balance"
              style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
            >
              Partners & Collaborators
            </h1>
            <div class="mt-6 w-16 h-1 bg-accent rounded-full" aria-hidden="true"></div>
            <p
              class="mt-6 text-dark/70 leading-relaxed max-w-lg"
              style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
            >
              USTADI's market facilitation model thrives on collaboration. We bring together funding partners, implementing organisations, academic institutions, county governments, and the private sector to deliver lasting impact.
            </p>

            {/* Mini stats */}
            <div class="mt-8 grid grid-cols-3 gap-4 max-w-md">
              {[
                { value: '18', label: 'Funders' },
                { value: '12', label: 'Implementers' },
                { value: '20', label: 'Counties' },
              ].map((stat) => (
                <div class="bg-cream rounded-xl p-4 text-center">
                  <span class="block font-heading font-bold text-primary" style="font-size: 1.5rem; line-height: 1;">{stat.value}</span>
                  <span class="block mt-1 text-dark/50 text-xs uppercase tracking-wider">{stat.label}</span>
                </div>
              ))}
            </div>
          </div>
        </div>

        {/* Network visual */}
        <div class="relative">
          <div class="relative aspect-square max-w-md mx-auto">
            
            {/* Center hub */}
            <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 bg-primary rounded-full flex items-center justify-center z-10 shadow-xl">
              <p class="text-white font-heading font-bold text-sm text-center px-4">USTADI</p>
            </div>

            {/* Orbiting nodes */}
            {[
              { label: 'Funding', x: 50, y: 10 },
              { label: 'Counties', x: 85, y: 30 },
              { label: 'NGOs', x: 85, y: 70 },
              { label: 'Private', x: 50, y: 90 },
              { label: 'Academic', x: 15, y: 70 },
              { label: 'Youth Groups', x: 15, y: 30 },
            ].map((node) => (
              <div
                class="absolute -translate-x-1/2 -translate-y-1/2 bg-cream rounded-full px-4 py-2 shadow-card z-10"
                style={`top: ${node.y}%; left: ${node.x}%;`}
              >
                <p class="text-xs font-semibold text-dark/70 whitespace-nowrap">{node.label}</p>
              </div>
            ))}

            {/* Connecting lines */}
            <svg class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true">
              {[
                { x: 50, y: 10 },
                { x: 85, y: 30 },
                { x: 85, y: 70 },
                { x: 50, y: 90 },
                { x: 15, y: 70 },
                { x: 15, y: 30 },
              ].map((node) => (
                <line
                  x1="50%"
                  y1="50%"
                  x2={`${node.x}%`}
                  y2={`${node.y}%`}
                  stroke="#5A6267"
                  stroke-width="1"
                  stroke-dasharray="4 4"
                  opacity="0.25"
                />
              ))}
            </svg>

          </div>
        </div>

      </div>
    </div>
  </section>

  {/* Stats */}
  <section class="pb-16 bg-white" aria-label="Partner statistics">
    <div class="container-wide">
      <div class="relative max-w-5xl mx-auto">
        
        {/* Horizontal connector line */}
        <div class="hidden md:block absolute top-10 left-[10%] right-[10%] h-px bg-dark/10" aria-hidden="true"></div>

        <div class="grid grid-cols-2 md:grid-cols-5 gap-6 relative">
          {[
            { value: '18', label: 'Funding Partners', icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z' },
            { value: '300+', label: 'Youth Groups & CSOs', icon: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z' },
            { value: '12', label: 'Implementing Partners', icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z' },
            { value: '20', label: 'County Governments', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
            { value: '500K+', label: 'Households Reached', icon: 'M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6' },
          ].map((stat, index) => (
            <div class="relative text-center group">
              
              {/* Icon circle on line */}
              <div class="relative z-10 w-20 h-20 mx-auto flex items-center justify-center rounded-full bg-primary text-white shadow-lg group-hover:bg-accent group-hover:text-dark transition-colors">
                <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={stat.icon} />
                </svg>
              </div>

              {/* Value */}
              <span class="block mt-5 font-heading font-bold text-dark" style="font-size: var(--text-heading-md); line-height: 1;">
                {stat.value}
              </span>

              {/* Label */}
              <span class="block mt-2 text-dark/50 text-xs font-medium tracking-wide uppercase leading-relaxed">
                {stat.label}
              </span>

            </div>
          ))}
        </div>

      </div>
    </div>
  </section>

  {/* Funding Partners — Grouped by Category */}
  <section class="section-padding-sm bg-white" aria-labelledby="funding-heading">
    <div class="container-wide">
      
      <div class="text-center mb-12">
        <h2
          id="funding-heading"
          class="font-heading font-bold text-dark"
          style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
        >
          Funding Partners
        </h2>
        <p
          class="mt-4 text-dark/60 max-w-xl mx-auto"
          style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
        >
          We are grateful to the organisations that invest in our mission to transform youth and women enterprises across Kenya.
        </p>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
      </div>

      <div class="space-y-10 max-w-4xl mx-auto">
        
        <div>
          <p class="text-xs font-semibold text-dark/40 uppercase tracking-wider mb-4 text-center">Multilateral Organisations</p>
          <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6">
            {[
              { name: 'IFAD', logo: getUrl('/images/partners/ifad.svg') },
              { name: 'ILO', logo: getUrl('/images/partners/ilo.svg') },
              { name: 'European Union', logo: getUrl('/images/partners/eu.svg') },
              { name: 'USAID', logo: getUrl('/images/partners/usaid.svg') },
              { name: 'CTA', logo: getUrl('/images/partners/cta.svg') },
              { name: 'Procasur', logo: getUrl('/images/partners/procasur.svg') },
            ].map((partner) => (
              <img src={partner.logo} alt={partner.name} class="h-8 md:h-10 w-auto opacity-90" loading="lazy" />
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-semibold text-dark/40 uppercase tracking-wider mb-4 text-center">Foundations & Bilateral Agencies</p>
          <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6">
            {[
              { name: 'Visa Foundation', logo: getUrl('/images/partners/visa-foundation.svg') },
              { name: 'Mastercard Foundation', logo: getUrl('/images/partners/mastercard-foundation.svg') },
              { name: 'Safaricom Foundation', logo: getUrl('/images/partners/safaricom-foundation.svg') },
              { name: 'GIZ', logo: getUrl('/images/partners/giz.svg') },
              { name: 'USADF', logo: getUrl('/images/partners/usadf.svg') },
              { name: 'KALRO', logo: getUrl('/images/partners/kalro.svg') },
            ].map((partner) => (
              <img src={partner.logo} alt={partner.name} class="h-8 md:h-10 w-auto opacity-90" loading="lazy" />
            ))}
          </div>
        </div>

        <div>
          <p class="text-xs font-semibold text-dark/40 uppercase tracking-wider mb-4 text-center">NGO & Private Sector Partners</p>
          <div class="flex flex-wrap justify-center items-center gap-x-12 gap-y-6">
            {[
              { name: 'SNV', logo: getUrl('/images/partners/snv.svg') },
              { name: 'HIVOS', logo: getUrl('/images/partners/hivos.svg') },
              { name: 'Pathfinder International', logo: getUrl('/images/partners/pathfinder.svg') },
              { name: 'ChildFund', logo: getUrl('/images/partners/childfund.svg') },
              { name: 'Self Help Africa', logo: getUrl('/images/partners/self-help-africa.svg') },
              { name: "Land O'Lakes", logo: getUrl('/images/partners/landolakes.svg') },
            ].map((partner) => (
              <img src={partner.logo} alt={partner.name} class="h-8 md:h-10 w-auto opacity-90" loading="lazy" />
            ))}
          </div>
        </div>

      </div>

    </div>
  </section>

  {/* Implementing Partners */}
  <section class="section-padding bg-cream" aria-labelledby="implementing-heading">
    <div class="container-wide relative">
      
      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="text-center mb-12 relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Delivery Network
        </p>
        <h2
          id="implementing-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
        >
          Implementing Partners
        </h2>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-4 text-dark/60 max-w-xl mx-auto"
          style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
        >
          Trusted organisations and institutions that deliver programmes alongside our teams on the ground.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6 max-w-4xl mx-auto relative z-10">
        {implementingPartners.map((partner) => (
          <div class="group bg-white rounded-3xl p-8 text-center shadow-card hover:shadow-card-hover transition-all duration-300">
            <div class="w-20 h-20 mx-auto flex items-center justify-center rounded-2xl bg-cream group-hover:bg-primary/5 transition-colors">
              <img
                src={partner.logo}
                alt={partner.name}
                class="h-10 w-auto opacity-80 group-hover:opacity-100 transition-opacity"
                loading="lazy"
              />
            </div>
            <h3 class="mt-5 font-heading font-bold text-dark" style="font-size: 1.125rem;">
              {partner.name.split(' — ')[0]}
            </h3>
            {partner.name.includes(' — ') && (
              <p class="mt-1 text-dark/40 text-xs font-medium tracking-wide uppercase">{partner.name.split(' — ')[1]}</p>
            )}
            <p class="mt-3 text-dark/50 text-sm leading-relaxed">{partner.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  {/* Private Sector Partners */}
  <section class="section-padding-sm bg-white" aria-labelledby="private-heading">
    <div class="container-wide">
      <h2
        id="private-heading"
        class="text-center font-heading font-bold text-dark"
        style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
      >
        Private Sector Partners
      </h2>
      <p
        class="mt-3 text-center text-dark/60 max-w-lg mx-auto"
        style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
      >
        Strategic alliances that connect youth enterprises to markets, finance, and opportunities.
      </p>

      <div class="mt-10 flex flex-wrap justify-center items-center gap-x-12 gap-y-8 opacity-90">
        {privateSectorPartners.map((partner) => (
          <img
            src={partner.logo}
            alt={partner.name}
            class="h-8 md:h-10 w-auto"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </section>

  {/* County Governments */}
  <section class="section-padding bg-cream" aria-labelledby="counties-heading">
    <div class="container-wide relative">
      
      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />

      <div class="text-center mb-12 relative z-10">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Local Governance
        </p>
        <h2
          id="counties-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
        >
          County Government Partners
        </h2>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
        <p
          class="mt-4 text-dark/60 max-w-xl mx-auto"
          style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
        >
          USTADI collaborates with county governments to align programmes with local development priorities and ensure sustainable impact.
        </p>
      </div>

      <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto relative z-10">
        {countyPartners.map((county) => (
          <div class="group inline-flex items-center gap-2.5 bg-white rounded-full px-5 py-3 hover:bg-primary hover:shadow-card transition-all duration-300 cursor-default">
            <div class="w-7 h-7 flex items-center justify-center rounded-full bg-primary/10 text-primary group-hover:bg-white/20 group-hover:text-white transition-colors shadow-sm shrink-0" aria-hidden="true">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
            </div>
            <span class="font-medium text-dark/70 group-hover:text-white transition-colors text-sm">
              {county.name}
            </span>
            <span class="text-dark/30 group-hover:text-white/50 text-xs transition-colors">
              {county.region}
            </span>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* Ways to Partner */}
  <section class="section-padding bg-white" aria-labelledby="ways-heading">
    <div class="container-wide relative">

      <ScribbleCircle
        size={200}
        opacity={0.45}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />
      
      <div class="text-center mb-12">
        <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
          Collaboration Models
        </p>
        <h2
          id="ways-heading"
          class="mt-4 font-heading font-bold text-dark"
          style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
        >
          Ways to Partner
        </h2>
        <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
      </div>

      <div class="grid md:grid-cols-3 gap-6 max-w-5xl mx-auto">
        {[
          {
            title: 'Fund a Project',
            description: 'Invest in demand-driven capacity development programmes that deliver measurable impact for youth and women across Kenya.',
            icon: 'M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
          },
          {
            title: 'Implement Together',
            description: 'Become an implementing partner and help drive sustainable change through your technical expertise, institutional networks, or local presence.',
            icon: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
          },
          {
            title: 'Government Collaboration',
            description: 'Partner with us at the county level to align programmes with local development priorities and scale proven solutions.',
            icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
          },
        ].map((way) => (
          <div class="bg-cream rounded-3xl p-8 text-center shadow-card hover:shadow-card-hover transition-all duration-300 group">
            <div class="w-14 h-14 mx-auto flex items-center justify-center rounded-2xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors mb-5">
              <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={way.icon} />
              </svg>
            </div>
            <h3 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);">
              {way.title}
            </h3>
            <p class="mt-3 text-dark/60 text-sm leading-relaxed">{way.description}</p>
          </div>
        ))}
      </div>

    </div>
  </section>

  {/* Become a Partner CTA */}
  <section class="section-padding bg-primary relative overflow-hidden" aria-labelledby="partner-cta-heading">
    <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/5" aria-hidden="true"></div>
    <div class="absolute -bottom-8 -left-8 w-32 h-32 rounded-full bg-accent/10" aria-hidden="true"></div>
    
    <div class="container-tight text-center relative">
      <div class="w-16 h-16 mx-auto flex items-center justify-center rounded-2xl bg-accent text-dark mb-6 shadow-lg">
        <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
        </svg>
      </div>
      <h2
        id="partner-cta-heading"
        class="font-heading font-bold text-white"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        Partner with us
      </h2>
      <p
        class="mt-5 text-white/70 max-w-lg mx-auto"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        We are always open to new partnerships that advance youth and women enterprise development in Kenya. Reach out to explore collaboration opportunities.
      </p>
      <a
        href={getUrl('/contact')}
        class="inline-flex items-center justify-center px-8 py-4 mt-8 font-semibold text-dark bg-accent rounded-lg hover:bg-accent/90 no-underline shadow-lg"
        style="font-size: var(--text-body-base);"
