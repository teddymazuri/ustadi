---
// NavDropdown.astro — Multi-column desktop dropdown menu
// Refined design: accent column titles, arrow on hover, gradient dividers
export interface DropdownColumn {
  title: string;
  links: {
    label: string;
    href: string;
  }[];
}

export interface Props {
  label: string;
  id: string;
  columns: DropdownColumn[];
  intro?: {
    description: string;
  };
}

const { label, id, columns, intro } = Astro.props;
const totalColumns = intro ? columns.length + 1 : columns.length;
---

<div class="relative group" data-dropdown={id}>
  <button
    type="button"
    class="flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg text-dark/70 group-hover:text-primary group-hover:bg-gray-light/50 cursor-pointer"
    aria-expanded="false"
    aria-controls={`dropdown-${id}`}
  >
    {label}
    <svg
      class="w-4 h-4 transition-transform duration-200 pointer-events-none group-hover:rotate-180"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  {/* Invisible bridge to keep hover active between button and dropdown */}
  <div class="absolute top-full left-0 w-full h-4 hidden group-hover:block" aria-hidden="true"></div>

  <div
    id={`dropdown-${id}`}
    class="absolute top-[calc(100%+1rem)] mt-0 bg-white rounded-xl shadow-soft-lg border border-dark/5 z-50 hidden group-hover:block opacity-0 group-hover:opacity-100 translate-y-[-4px] group-hover:translate-y-0 transition-all duration-200 ease-out"
    style={`left: ${intro ? '-15rem' : '0'}; min-width: ${totalColumns * 240}px;`}
    role="menu"
  >
    <div class="flex flex-row">
      
      {/* Intro column */}
      {intro && (
        <div class="w-56 shrink-0 m-4 p-4 flex items-center bg-accent/5 border-2 border-dark/10">
          <p class="text-sm text-dark/70 leading-relaxed font-bold">
            {intro.description}
          </p>
        </div>
      )}

      {/* Divider between intro and first column — gradient fade */}
      {intro && (
        <div class="w-px self-stretch bg-gradient-to-b from-transparent via-dark/10 to-transparent" aria-hidden="true"></div>
      )}

      {/* Link columns */}
      {columns.map((column, index) => (
        <>
          {/* Divider between columns — gradient fade */}
          {index > 0 && (
            <div class="w-px self-stretch bg-gradient-to-b from-transparent via-dark/10 to-transparent" aria-hidden="true"></div>
          )}
          
          <div class="flex-1 min-w-[200px] p-6">
            {/* Column title with accent left bar */}
            <p class="text-xs font-semibold text-dark/50 uppercase tracking-wider mb-3 pl-2.5 border-l-2 border-accent">
              {column.title}
            </p>
            
            <div class="space-y-0.5 mt-1">
              {column.links.map((link) => (
                <a
                  href={link.href}
                  class="group/link flex items-center px-3 py-2 -mx-1 text-sm font-medium text-dark/60 hover:text-primary rounded-lg no-underline transition-all duration-200 hover:bg-primary/5"
                  role="menuitem"
                >
                  <span class="transition-transform duration-200 group-hover/link:translate-x-0.5">
                    {link.label}
                  </span>
                  <svg
                    class="w-3.5 h-3.5 ml-auto opacity-0 group-hover/link:opacity-100 transition-opacity duration-200 text-accent"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                  >
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
              ))}
            </div>
          </div>
        </>
      ))}
    </div>
  </div>
</div>