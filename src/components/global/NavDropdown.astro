---
// NavDropdown.astro — Desktop dropdown menu
export interface Props {
  label: string;
  id: string;
  items: {
    label: string;
    href: string;
  }[];
}

const { label, id, items } = Astro.props;
---

<div class="relative" data-dropdown={id}>
  <button
    type="button"
    class="flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg text-dark/70 hover:text-primary hover:bg-gray-light/50 cursor-pointer"
    aria-expanded="false"
    aria-controls={`dropdown-${id}`}
  >
    {label}
    <svg
      class="w-4 h-4 transition-transform duration-200 pointer-events-none"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  <div
    id={`dropdown-${id}`}
    class="absolute top-full left-0 mt-1 min-w-[200px] bg-white rounded-lg shadow-soft-lg border border-gray-light py-1 z-50 hidden"
    role="menu"
  >
    {items.map((item) => (
      <a
        href={item.href}
        class="block px-4 py-2.5 text-sm font-medium text-dark/60 hover:text-primary hover:bg-gray-light/50 no-underline"
        role="menuitem"
      >
        {item.label}
      </a>
    ))}
  </div>
</div>

<script>
  function initDropdowns() {
    document.querySelectorAll('[data-dropdown]').forEach((container) => {
      const btn = container.querySelector('button');
      const menu = container.querySelector('[role="menu"]');
      const arrow = btn?.querySelector('svg');
      if (!btn || !menu) return;

      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const isOpen = btn.getAttribute('aria-expanded') === 'true';
        
        // Close all other dropdowns first
        document.querySelectorAll('[data-dropdown]').forEach((other) => {
          const otherBtn = other.querySelector('button');
          const otherMenu = other.querySelector('[role="menu"]');
          const otherArrow = otherBtn?.querySelector('svg');
          if (otherBtn && otherMenu && otherBtn !== btn) {
            otherBtn.setAttribute('aria-expanded', 'false');
            otherMenu.classList.add('hidden');
            if (otherArrow) otherArrow.style.transform = 'rotate(0deg)';
          }
        });

        btn.setAttribute('aria-expanded', String(!isOpen));
        menu.classList.toggle('hidden', isOpen);
        if (arrow) arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
      });
    });

    // Close all dropdowns when clicking outside
    document.addEventListener('click', () => {
      document.querySelectorAll('[data-dropdown]').forEach((container) => {
        const btn = container.querySelector('button');
        const menu = container.querySelector('[role="menu"]');
        const arrow = btn?.querySelector('svg');
        if (btn && menu) {
          btn.setAttribute('aria-expanded', 'false');
          menu.classList.add('hidden');
          if (arrow) arrow.style.transform = 'rotate(0deg)';
        }
      });
    });

    // Close all on Escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        document.querySelectorAll('[data-dropdown]').forEach((container) => {
          const btn = container.querySelector('button');
          const menu = container.querySelector('[role="menu"]');
          const arrow = btn?.querySelector('svg');
          if (btn && menu) {
            btn.setAttribute('aria-expanded', 'false');
            menu.classList.add('hidden');
            if (arrow) arrow.style.transform = 'rotate(0deg)';
          }
        });
      }
    });
  }

  initDropdowns();
  document.addEventListener('astro:page-load', initDropdowns);
</script>