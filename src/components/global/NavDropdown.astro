---
// NavDropdown.astro — Multi-column desktop dropdown menu
// One row, multiple columns, each with a title and links
// Optional intro column on the left with description
// Hover to open, close on mouse leave
// Dropdown positions so the second column aligns under the button
export interface DropdownColumn {
  title: string;
  links: {
    label: string;
    href: string;
  }[];
}

export interface Props {
  label: string;
  id: string;
  columns: DropdownColumn[];
  intro?: {
    description: string;
  };
}

const { label, id, columns, intro } = Astro.props;
const totalColumns = intro ? columns.length + 1 : columns.length;
---

<div class="relative group" data-dropdown={id}>
  <button
    type="button"
    class="flex items-center gap-1 px-3 py-2 text-sm font-medium rounded-lg text-dark/70 group-hover:text-primary group-hover:bg-gray-light/50 cursor-pointer"
    aria-expanded="false"
    aria-controls={`dropdown-${id}`}
  >
    {label}
    <svg
      class="w-4 h-4 transition-transform duration-200 pointer-events-none group-hover:rotate-180"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
      aria-hidden="true"
    >
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </button>

  {/* Invisible bridge to keep hover active between button and dropdown */}
  <div class="absolute top-full left-0 w-full h-4 hidden group-hover:block" aria-hidden="true"></div>

  <div
    id={`dropdown-${id}`}
    class="absolute top-[calc(100%+1rem)] mt-0 bg-white rounded-lg shadow-soft-lg border border-gray-light z-50 hidden group-hover:block"
    style={`left: ${intro ? '-16rem' : '0'}; min-width: ${totalColumns * 220}px;`}
    role="menu"
  >
    <div class="flex flex-row p-6 gap-6">
      
      {/* Intro column */}
      {intro && (
        <div class="w-56 shrink-0 pr-6 border-r border-gray-light">
          <p class="text-sm text-dark/60 leading-relaxed">
            {intro.description}
          </p>
        </div>
      )}

      {/* Link columns */}
      {columns.map((column, index) => (
        <div class={`flex-1 ${index > 0 || intro ? 'pl-6 border-l border-gray-light' : ''}`}>
          <p class="text-xs font-semibold text-dark/40 uppercase tracking-wider mb-3">
            {column.title}
          </p>
          <div class="space-y-1">
            {column.links.map((link) => (
              <a
                href={link.href}
                class="block px-3 py-2 text-sm font-medium text-dark/60 hover:text-primary hover:bg-gray-light/50 rounded-lg no-underline"
                role="menuitem"
              >
                {link.label}
              </a>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</div>