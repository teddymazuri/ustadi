---
// Footer.astro — Site footer shell
// Pure presentation. Zero business content.
// Grid layout adapts to column content passed via slot.
---

<footer class="bg-cream text-dark" aria-labelledby="footer-heading" role="contentinfo">
  <h2 id="footer-heading" class="sr-only">Site footer</h2>

  <div class="container-wide section-padding">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-12 gap-12 lg:gap-8">
      <slot name="columns" />
    </div>

    <div class="mt-12 pt-8 border-t border-dark/10 flex flex-col sm:flex-row justify-between items-center gap-3">
      <slot name="copyright">
        <p class="text-sm text-dark/50" style="font-size: var(--text-body-sm);">
          &copy; {new Date().getFullYear()} USTADI Foundation. All rights reserved.
        </p>
      </slot>
      <div class="flex gap-6">
        <slot name="legal-links" />
      </div>
    </div>
  </div>
</footer>