---
// ApproachSection.astro — Three-pillar model recap
// Visual: Three numbered columns with icons
export interface Pillar {
  number: string;
  title: string;
  description: string;
}

export interface Props {
  heading: string;
  subheading: string;
  pillars: [Pillar, Pillar, Pillar];
}

const { heading, subheading, pillars } = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="approach-heading">
  <div class="container-wide">
    
    <div class="text-center mb-14">
      <h2
        id="approach-heading"
        class="font-heading font-bold text-dark"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        {heading}
      </h2>
      <p
        class="mt-4 max-w-2xl mx-auto text-dark/70"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {subheading}
      </p>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 lg:gap-12">
      {pillars.map((pillar) => (
        <div class="relative bg-white rounded-2xl p-8 shadow-card">
          <span
            class="block font-heading font-bold text-accent/20"
            style="font-size: 4rem; line-height: 1;"
            aria-hidden="true"
          >
            {pillar.number}
          </span>
          <div class="-mt-4">
            <h3
              class="font-heading font-bold text-dark"
              style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
            >
              {pillar.title}
            </h3>
            <p
              class="mt-3 text-dark/70"
              style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
            >
              {pillar.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>