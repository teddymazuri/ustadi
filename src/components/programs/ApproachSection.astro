---
// ApproachSection.astro — Three-pillar connected process flow
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Pillar {
  number: string;
  title: string;
  description: string;
}

export interface Props {
  heading: string;
  subheading: string;
  pillars: [Pillar, Pillar, Pillar];
}

const { heading, subheading, pillars } = Astro.props;
---

<section class="section-padding bg-white" aria-labelledby="approach-heading">
  <div class="container-wide relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="text-center mb-16 relative z-10">
      <h2
        id="approach-heading"
        class="font-heading font-bold text-dark"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        {heading}
      </h2>
      <p
        class="mt-4 max-w-2xl mx-auto text-dark/70"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {subheading}
      </p>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="relative z-10">
      
      {/* Connecting line */}
      <div class="hidden md:block absolute top-10 left-[16.67%] right-[16.67%] h-0.5 bg-dark/10" aria-hidden="true"></div>

      <div class="grid md:grid-cols-3 gap-10 lg:gap-12 relative">
        {pillars.map((pillar, index) => (
          <div class="relative text-center group">
            
            {/* Connector arrow */}
            {index < pillars.length - 1 && (
              <div class="hidden md:block absolute top-10 left-[calc(50%+2.5rem)] w-[calc(100%-5rem)] h-px bg-dark/10" aria-hidden="true"></div>
            )}

            {/* Number circle */}
            <div class="relative z-10 w-20 h-20 mx-auto flex items-center justify-center rounded-full bg-primary text-white font-heading font-bold shadow-lg group-hover:bg-accent group-hover:text-dark transition-colors" style="font-size: var(--text-heading-sm);">
              {pillar.number}
            </div>

            {/* Title */}
            <h3
              class="mt-6 font-heading font-bold text-dark"
              style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
            >
              {pillar.title}
            </h3>

            {/* Gold underline */}
            <div class="mt-3 w-10 h-0.5 bg-accent rounded-full mx-auto" aria-hidden="true"></div>

            {/* Description */}
            <p
              class="mt-4 text-dark/70 leading-relaxed"
              style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
            >
              {pillar.description}
            </p>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>