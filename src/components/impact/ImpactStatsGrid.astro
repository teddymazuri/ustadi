---
// ImpactStatsGrid.astro — Tree diagram of impact numbers
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  heading: string;
  stats: Stat[];
}

const { heading, stats } = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="impact-stats-heading">
  <div class="container-wide relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.4}
      rotation={15}
      class="absolute -top-12 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="relative z-10">
      <h2
        id="impact-stats-heading"
        class="text-center font-heading font-bold text-dark"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        {heading}
      </h2>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>

      <div class="mt-16 max-w-4xl mx-auto">
        
        {/* Root node */}
        <div class="flex justify-center mb-12">
          <div class="bg-primary text-white rounded-2xl px-8 py-4 text-center shadow-lg">
            <p class="font-heading font-bold" style="font-size: var(--text-heading-sm); line-height: 1;">
              USTADI Impact
            </p>
            <p class="mt-1 text-white/60 text-xs tracking-wider uppercase">Since 2010</p>
          </div>
        </div>

        {/* Vertical line from root */}
        <div class="w-px h-8 bg-dark/20 mx-auto" aria-hidden="true"></div>

        {/* Horizontal spread line */}
        <div class="hidden md:block h-px bg-dark/20 mx-24 mb-8" aria-hidden="true"></div>

        {/* Level 1 — first 3 stats */}
        <div class="grid md:grid-cols-3 gap-10 mb-10">
          {stats.slice(0, 3).map((stat, index) => (
            <div class="relative text-center">
              
              {/* Vertical line up */}
              <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mb-4" aria-hidden="true"></div>

              <div class="bg-white rounded-2xl p-6 shadow-card hover:shadow-card-hover transition-shadow">
                <p class="font-heading font-bold text-primary" style="font-size: var(--text-heading-lg); line-height: 1;">
                  {stat.value}
                </p>
                <p class="mt-2 text-dark/50 text-xs leading-relaxed">{stat.label}</p>
              </div>

              {/* Vertical line down to next level */}
              {index === 0 && (
                <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mt-4" aria-hidden="true"></div>
              )}
            </div>
          ))}
        </div>

        {/* Horizontal line for second level */}
        <div class="hidden md:block h-px bg-dark/20 mx-16 mb-8" aria-hidden="true"></div>

        {/* Level 2 — next 3 stats */}
        <div class="grid md:grid-cols-3 gap-10 mb-10">
          {stats.slice(3, 6).map((stat) => (
            <div class="text-center">
              <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mb-4" aria-hidden="true"></div>
              <div class="bg-white rounded-2xl p-6 shadow-card hover:shadow-card-hover transition-shadow">
                <p class="font-heading font-bold text-primary" style="font-size: var(--text-heading-lg); line-height: 1;">
                  {stat.value}
                </p>
                <p class="mt-2 text-dark/50 text-xs leading-relaxed">{stat.label}</p>
              </div>
            </div>
          ))}
        </div>

        {/* Horizontal line for third level */}
        <div class="hidden md:block h-px bg-dark/20 mx-16 mb-8" aria-hidden="true"></div>

        {/* Level 3 — last 2 stats */}
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-10 max-w-2xl mx-auto">
          {stats.slice(6).map((stat) => (
            <div class="text-center">
              <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mb-4" aria-hidden="true"></div>
              <div class="bg-white rounded-2xl p-6 shadow-card hover:shadow-card-hover transition-shadow">
                <p class="font-heading font-bold text-primary" style="font-size: var(--text-heading-lg); line-height: 1;">
                  {stat.value}
                </p>
                <p class="mt-2 text-dark/50 text-xs leading-relaxed">{stat.label}</p>
              </div>
            </div>
          ))}
        </div>

      </div>
    </div>

  </div>
</section>