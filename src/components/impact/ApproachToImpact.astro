---
// ApproachToImpact.astro — Connected process cards
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Props {
  heading: string;
  body: string;
  pillars: {
    title: string;
    description: string;
  }[];
}

const { heading, body, pillars } = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="approach-impact-heading">
  <div class="container-tight relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="relative z-10">
      <h2
        id="approach-impact-heading"
        class="text-center font-heading font-bold text-dark"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        {heading}
      </h2>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
      
      <p
        class="mt-8 text-dark/70 text-center max-w-2xl mx-auto"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {body}
      </p>

      <div class="mt-14 relative">
        
        {/* Connecting line */}
        <div class="hidden md:block absolute top-8 left-[16.67%] right-[16.67%] h-px bg-dark/10" aria-hidden="true"></div>

        <div class="grid md:grid-cols-3 gap-8 lg:gap-10 relative">
          {pillars.map((pillar, index) => (
            <div class="relative text-center group">
              
              {/* Number circle */}
              <div class="relative z-10 w-16 h-16 mx-auto flex items-center justify-center rounded-full bg-primary text-white font-heading font-bold shadow-lg group-hover:bg-accent group-hover:text-dark transition-colors" style="font-size: var(--text-heading-sm);">
                {index + 1}
              </div>

              {/* Title */}
              <h3
                class="mt-5 font-heading font-bold text-dark"
                style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
              >
                {pillar.title}
              </h3>

              {/* Gold underline */}
              <div class="mt-3 w-10 h-0.5 bg-accent rounded-full mx-auto" aria-hidden="true"></div>

              {/* Description */}
              <p
                class="mt-4 text-dark/70 leading-relaxed"
                style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
              >
                {pillar.description}
              </p>

            </div>
          ))}
        </div>

      </div>
    </div>

  </div>
</section>