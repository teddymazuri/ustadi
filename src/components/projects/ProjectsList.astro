---
// ProjectsList.astro — Timeline of projects
import ScribbleCircle from '../shared/ScribbleCircle.astro';
import ProjectCard from './ProjectCard.astro';
import Lightbox from './Lightbox.astro';

export interface Project {
  title: string;
  donor: string;
  duration: string;
  value: string;
  description: string;
  image: {
    src: string;
    alt: string;
  };
  reportsHref?: string;
  mediaHref?: string;
  year: string;
  slug?: string;
  gallery?: { src: string; alt: string }[];
}

export interface Props {
  heading: string;
  subheading: string;
  projects: Project[];
}

const { heading, subheading, projects } = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="projects-list-heading">
  <div class="container-wide relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="text-center mb-16 relative z-10">
      <h2
        id="projects-list-heading"
        class="font-heading font-bold text-dark"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        {heading}
      </h2>
      <p
        class="mt-4 max-w-2xl mx-auto text-dark/70"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {subheading}
      </p>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="relative z-10">
      {/* Center line */}
      <div class="absolute left-1/2 top-0 bottom-0 w-px bg-dark/10 -translate-x-1/2 hidden md:block" aria-hidden="true"></div>

      <div class="space-y-12 md:space-y-16">
        {projects.map((project, index) => (
          <ProjectCard
            title={project.title}
            donor={project.donor}
            duration={project.duration}
            value={project.value}
            description={project.description}
            image={project.image}
            index={index}
            year={project.year}
            reportsHref={project.reportsHref}
            mediaHref={project.mediaHref}
            slug={project.slug}
            gallery={project.gallery}
          />
        ))}
      </div>
    </div>

  </div>

  <Lightbox title="Project Photos" images={[]} />
</section>