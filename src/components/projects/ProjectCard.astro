---
// ProjectCard.astro — Timeline entry for project
export interface Props {
  title: string;
  donor: string;
  duration: string;
  value: string;
  description: string;
  image: {
    src: string;
    alt: string;
  };
  index: number;
  year: string;
  reportsHref?: string;
  mediaHref?: string;
  slug?: string;
  gallery?: { src: string; alt: string }[];
}

const { title, donor, duration, value, description, image, index, year, reportsHref, mediaHref, slug, gallery = [] } = Astro.props;
const isEven = index % 2 === 0;
const allImages = gallery.length > 0 ? gallery : [image];
const galleryJson = JSON.stringify(allImages);
const titleJson = JSON.stringify(title);
---

<div id={slug ? `project-${slug}` : undefined} class={`flex scroll-mt-24 ${isEven ? 'md:flex-row' : 'md:flex-row-reverse'}`}>
  
  {/* Card */}
  <div class="md:w-1/2">
    <div class={`bg-white rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300 ${isEven ? 'md:mr-10' : 'md:ml-10'}`}>
      
      {/* Thumbnail */}
      <div class="relative h-44 overflow-hidden group">
        <img
          src={image.src}
          alt={image.alt}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-dark/40 to-transparent" aria-hidden="true"></div>
        <div class="absolute bottom-3 left-4">
          <p class="text-white/80 text-xs font-medium tracking-wider uppercase">{duration}</p>
        </div>

        {/* Gallery trigger */}
        <button
          type="button"
          class="absolute top-3 right-3 inline-flex items-center gap-1.5 bg-dark/50 backdrop-blur-sm text-white text-xs font-semibold px-3 py-1.5 rounded-full hover:bg-dark/70 transition-colors"
          aria-label={`View ${allImages.length} photos of ${title}`}
          onclick={`window.openProjectLightbox && window.openProjectLightbox(${galleryJson}, ${titleJson})`}
        >
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
          </svg>
          {allImages.length} Photos
        </button>
      </div>

      {/* Content */}
      <div class="p-6">
        <h2 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);">
          {title}
        </h2>

        {/* Meta */}
        <div class="mt-3 flex flex-wrap gap-3" style="font-size: var(--text-body-sm);">
          <div class="flex items-center gap-1.5 text-dark/50">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
            </svg>
            {donor}
          </div>
          <div class="flex items-center gap-1.5 text-accent font-semibold">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            {value}
          </div>
        </div>

        <p class="mt-4 text-dark/60 text-sm leading-relaxed">
          {description}
        </p>

        {/* Reports + Media buttons */}
        <div class="mt-5 flex flex-wrap gap-3">
          {reportsHref && (
            <a
              href={reportsHref}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent/80 no-underline"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              Reports
            </a>
          )}
          {mediaHref && (
            <a
              href={mediaHref}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-accent hover:text-accent/80 no-underline"
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
              </svg>
              Media
            </a>
          )}
        </div>
      </div>
    </div>
  </div>

  {/* Center spacer */}
  <div class="hidden md:flex items-start justify-center w-10 shrink-0 relative">
    <span
      class="bg-accent text-white text-xs font-bold px-2 py-1 rounded-full sticky top-24"
    >
      {year}
    </span>
  </div>

  {/* Empty side */}
  <div class="hidden md:block md:w-1/2"></div>

</div>