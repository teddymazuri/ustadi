---
// FeaturedProjectSection.astro — Magazine-style deep dive with project metadata
export interface Props {
  overline: string;
  heading: string;
  description: string;
  quote: string;
  quoteAttribution: string;
  image: {
    src: string;
    alt: string;
  };
  cta: {
    label: string;
    href: string;
  };
  duration?: string;
  value?: string;
}

const { overline, heading, description, quote, quoteAttribution, image, cta, duration, value } = Astro.props;
---

<section class="section-padding bg-white" aria-labelledby="project-heading">
  <div class="container-wide">
    
    <p
      class="text-accent font-semibold tracking-wider uppercase"
      style="font-size: var(--text-body-sm);"
    >
      {overline}
    </p>

    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 mt-8">
      
      <div>
        <img
          src={image.src}
          alt={image.alt}
          class="w-full rounded-2xl shadow-card object-cover aspect-[4/3]"
          loading="lazy"
        />
      </div>

      <div class="flex flex-col justify-center">
        <h2
          id="project-heading"
          class="font-heading font-bold text-dark text-balance"
          style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
        >
          {heading}
        </h2>

        {/* Project metadata */}
        {(duration || value) && (
          <div class="mt-5 flex flex-wrap gap-4">
            {duration && (
              <div class="flex items-center gap-2 text-dark/50 text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                </svg>
                {duration}
              </div>
            )}
            {value && (
              <div class="flex items-center gap-2 text-accent font-semibold text-sm">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                {value}
              </div>
            )}
          </div>
        )}

        <p
          class="mt-6 text-dark/70"
          style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
        >
          {description}
        </p>

        <blockquote class="mt-8 pl-6 border-l-4 border-accent">
          <p
            class="font-heading italic text-dark/80"
            style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
          >
            "{quote}"
          </p>
          <footer
            class="mt-3 text-dark/50"
            style="font-size: var(--text-body-sm);"
          >
            — {quoteAttribution}
          </footer>
        </blockquote>

        <a
          href={cta.href}
          class="inline-flex items-center justify-center px-6 py-3 mt-8 font-semibold text-white bg-primary rounded-lg hover:bg-primary-light no-underline shadow-sm self-start"
          style="font-size: var(--text-body-base);"
        >
          {cta.label}
        </a>
      </div>

    </div>
  </div>
</section>