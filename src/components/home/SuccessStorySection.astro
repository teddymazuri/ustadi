---
// SuccessStorySection.astro — Editorial testimonial with large portrait (William Otwane)
export interface Props {
  sectionTitle?: string;
  quote: string;
  name: string;
  role: string;
  narrative: string;
  portrait: {
    src: string;
    alt: string;
  };
  cta: {
    label: string;
    href: string;
  };
}

const { 
  sectionTitle = "Featured Success Story", 
  quote, 
  name, 
  role, 
  narrative, 
  portrait, 
  cta 
} = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="story-heading">
  <div class="container-wide">

    <!-- Section Title -->
    <div class="text-center mb-12">
      <p class="text-accent font-semibold tracking-wider uppercase text-sm" style="font-size: var(--text-body-sm);">
        {sectionTitle}
      </p>
      <h2 id="story-heading" class="sr-only">Success story</h2>
    </div>

    <div class="grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
      
      <!-- Portrait Column - Expanded -->
      <div class="relative">
        <img
          src={portrait.src}
          alt={portrait.alt}
          class="w-full rounded-2xl shadow-card object-cover aspect-[4/5]"
          loading="lazy"
        />
        <div class="absolute -top-4 -right-4 w-32 h-32 bg-accent/20 rounded-2xl -z-10 hidden md:block" aria-hidden="true"></div>
      </div>

      <!-- Content Column -->
      <div>
        <!-- Narrative text -->
        <p
          class="text-dark/70 leading-relaxed mb-6"
          style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
        >
          {narrative}
        </p>

        <!-- Quote with attribution -->
        <blockquote>
          <p
            class="font-heading font-medium italic text-dark text-balance"
            style="font-size: clamp(1.25rem, 3vw, var(--text-heading-md)); line-height: 1.4;"
          >
            "{quote}"
          </p>
        </blockquote>

        <div class="mt-6 flex items-center gap-3">
          <div class="w-px h-10 bg-accent" aria-hidden="true"></div>
          <div>
            <p class="font-semibold text-dark" style="font-size: var(--text-body-base);">
              {name}
            </p>
            <p class="text-dark/50" style="font-size: var(--text-body-sm);">
              {role}
            </p>
          </div>
        </div>

        <a
          href={cta.href}
          class="inline-flex items-center gap-2 mt-8 font-semibold text-primary hover:text-primary-light no-underline"
          style="font-size: var(--text-body-base);"
        >
          {cta.label}
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>

    </div>
  </div>
</section>