---
// ProgramsSection.astro — Featured first program + alternating rows
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface FocusArea {
  title: string;
  description: string;
  image: {
    src: string;
    alt: string;
  };
  href: string;
  icon: string;
}

export interface Props {
  heading: string;
  subheading: string;
  programs: [FocusArea, FocusArea, FocusArea];
}

const { heading, subheading, programs } = Astro.props;

// Separate the featured and remaining programs in frontmatter
const featuredProgram = programs[0];
const remainingPrograms = programs.slice(1);

const iconPaths: Record<string, string> = {
  briefcase: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  chart: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  leaf: 'M4 16c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2h2l2-2h8l2 2h2c1.1 0 2 .9 2 2v8c0 1.1-.9 2-2 2h-2l-2 2H8l-2-2H4z M12 10m-3 0a3 3 0 1 0 6 0 3 3 0 1 0-6 0 M10 17l4-4 M14 17l-4-4',
};

const defaultIcon = 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z';
---

<section class="section-padding bg-cream" aria-labelledby="programs-heading">
  <div class="container-wide relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="text-center mb-16 relative z-10">
      <h2
        id="programs-heading"
        class="font-heading font-bold text-dark text-balance"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        {heading}
      </h2>
      <p
        class="mt-4 max-w-xl mx-auto text-dark/70 text-balance"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {subheading}
      </p>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    {/* Featured program — full width */}
    <div class="relative z-10 mb-20 md:mb-28">
      <div class="bg-white rounded-3xl overflow-hidden shadow-card hover:shadow-card-hover transition-all duration-300">
        <div class="grid md:grid-cols-2 items-center">
          <div class="relative h-64 md:h-full overflow-hidden">
            <img
              src={featuredProgram.image.src}
              alt={featuredProgram.image.alt}
              class="w-full h-full object-cover"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-dark/30 to-transparent md:bg-gradient-to-r" aria-hidden="true"></div>
          </div>
          <div class="p-8 lg:p-12">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-primary/10 text-primary">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[featuredProgram.icon] || defaultIcon} />
                </svg>
              </div>
              <span class="text-xs font-semibold text-accent uppercase tracking-wider">Featured Focus</span>
            </div>
            <h3 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);">
              {featuredProgram.title}
            </h3>
            <p class="mt-4 text-dark/70 leading-relaxed" style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);">
              {featuredProgram.description}
            </p>
            <a
              href={featuredProgram.href}
              class="inline-flex items-center gap-2 mt-6 font-semibold text-primary hover:text-primary-light no-underline"
              style="font-size: var(--text-body-base);"
            >
              Learn more
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>

    {/* Remaining programs — alternating rows */}
    <div class="space-y-20 md:space-y-28 relative z-10">
      {remainingPrograms.map((program) => {
        const index = remainingPrograms.indexOf(program);
        const isEven = index % 2 === 0;
        return (
          <div class="grid md:grid-cols-2 gap-8 lg:gap-12 items-center">
            <div class={isEven ? 'md:order-1' : 'md:order-2'}>
              <img
                src={program.image.src}
                alt={program.image.alt}
                class="w-full rounded-2xl shadow-card object-cover aspect-[4/3]"
                loading="lazy"
              />
            </div>
            <div class={isEven ? 'md:order-2' : 'md:order-1'}>
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-primary/10 text-primary">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[program.icon] || defaultIcon} />
                  </svg>
                </div>
              </div>
              <h3 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);">
                {program.title}
              </h3>
              <p class="mt-4 text-dark/70" style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);">
                {program.description}
              </p>
              <a
                href={program.href}
                class="inline-flex items-center gap-2 mt-5 font-semibold text-primary hover:text-primary-light no-underline"
                style="font-size: var(--text-body-base);"
              >
                Learn more
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>