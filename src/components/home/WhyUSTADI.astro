---
// WhyUSTADI.astro — Six reasons USTADI delivers, connected box cards
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Props {
  heading: string;
  subheading: string;
  reasons: {
    title: string;
    description: string;
    icon: string;
  }[];
}

const { heading, subheading, reasons } = Astro.props;

const iconPaths: Record<string, string> = {
  local: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  market: 'M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z',
  enterprise: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  green: 'M4 16c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2h2l2-2h8l2 2h2c1.1 0 2 .9 2 2v8c0 1.1-.9 2-2 2h-2l-2 2H8l-2-2H4z M12 10m-3 0a3 3 0 1 0 6 0 3 3 0 1 0-6 0',
  partnership: 'M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z',
  evidence: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
};

const defaultIcon = 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z';
---

<section class="section-padding bg-white overflow-hidden" aria-labelledby="why-ustadi-heading">
  <div class="container-wide relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="text-center mb-14 relative z-10">
      <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
        Why USTADI?
      </p>
      <h2
        id="why-ustadi-heading"
        class="mt-4 font-heading font-bold text-dark"
        style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
      >
        {heading}
      </h2>
      <p
        class="mt-4 max-w-2xl mx-auto text-dark/70"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {subheading}
      </p>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="relative z-10">
      
      {/* Desktop: 3×2 grid with arrows between cards */}
      <div class="hidden lg:grid grid-cols-3 gap-x-16 gap-y-12 relative max-w-5xl mx-auto">
        
        {reasons.map((reason, index) => (
          <div class="relative">
            
            {/* Arrow to next card (right) */}
            {index % 3 !== 2 && index < reasons.length - 1 && (
              <div class="absolute top-1/2 -right-14 -translate-y-1/2 z-10" aria-hidden="true">
                <svg class="w-8 h-8 text-accent/40" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            )}

            {/* Arrow down to card below (for first row) */}
            {index < 3 && (
              <div class="absolute -bottom-9 left-1/2 -translate-x-1/2 z-10" aria-hidden="true">
                <svg class="w-6 h-6 text-accent/30 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            )}

            {/* Arrow up from card below (for second row) */}
            {index >= 3 && (
              <div class="absolute -top-9 left-1/2 -translate-x-1/2 z-10" aria-hidden="true">
                <svg class="w-6 h-6 text-accent/30 -rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            )}

            {/* Card */}
            <div class="bg-cream rounded-2xl p-8 shadow-card hover:shadow-card-hover transition-shadow group h-full">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-11 h-11 flex items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[reason.icon] || defaultIcon} />
                  </svg>
                </div>
                <span
                  class="font-heading font-bold text-primary/15 select-none"
                  style="font-size: 2rem; line-height: 1;"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>

              <h3 class="font-heading font-bold text-dark" style="font-size: 1.125rem; line-height: 1.4;">
                {reason.title}
              </h3>
              <p class="mt-3 text-dark/60 text-sm leading-relaxed">
                {reason.description}
              </p>
            </div>

          </div>
        ))}
      </div>

      {/* Mobile: stacked cards with arrows */}
      <div class="lg:hidden space-y-6 max-w-md mx-auto">
        {reasons.map((reason, index) => (
          <div class="relative">
            
            {/* Arrow down between cards */}
            {index < reasons.length - 1 && (
              <div class="flex justify-center -mb-2 mt-2" aria-hidden="true">
                <svg class="w-5 h-5 text-accent/40 rotate-90" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            )}

            {/* Card */}
            <div class="bg-cream rounded-2xl p-6 shadow-card group">
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 flex items-center justify-center rounded-xl bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors shrink-0">
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[reason.icon] || defaultIcon} />
                  </svg>
                </div>
                <span
                  class="font-heading font-bold text-primary/15 select-none"
                  style="font-size: 1.75rem; line-height: 1;"
                  aria-hidden="true"
                >
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>

              <h3 class="font-heading font-bold text-dark" style="font-size: 1.125rem; line-height: 1.4;">
                {reason.title}
              </h3>
              <p class="mt-2 text-dark/60 text-sm leading-relaxed">
                {reason.description}
              </p>
            </div>

          </div>
        ))}
      </div>

    </div>

  </div>
</section>