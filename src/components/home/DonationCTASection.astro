---
// DonationCTASection.astro — Bold ask on dark green
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Props {
  heading: string;
  body: string;
  cta: {
    label: string;
    href: string;
  };
}

const { heading, body, cta } = Astro.props;
---

<section class="section-padding bg-primary" aria-labelledby="donate-heading">
  <div class="container-tight text-center relative">
    <ScribbleCircle
      size={200}
      opacity={0.2}
      rotation={10}
      class="absolute top-0 right-0 z-0"
    />
    <div class="relative z-10">
      <h2
        id="donate-heading"
        class="font-heading font-bold text-white text-balance"
        style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
      >
        {heading}
      </h2>

      <p
        class="mt-6 text-white/70 max-w-lg mx-auto text-balance"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {body}
      </p>

      <a
        href={cta.href}
        class="inline-flex items-center justify-center px-8 py-4 mt-8 font-semibold text-dark bg-accent rounded-lg hover:bg-accent/90 no-underline shadow-lg"
        style="font-size: var(--text-body-lg);"
      >
        {cta.label}
        <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
        </svg>
      </a>
    </div>
  </div>
</section>