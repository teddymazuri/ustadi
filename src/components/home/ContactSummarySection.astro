---
// ContactSummarySection.astro — Practical contact row
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface ContactMethod {
  icon: 'email' | 'location' | 'phone';
  label: string;
  value: string;
  href: string;
}

export interface Props {
  heading: string;
  methods: ContactMethod[];
}

const { heading, methods } = Astro.props;

const icons: Record<string, string> = {
  email: 'M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  location: 'M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z M15 11a3 3 0 11-6 0 3 3 0 016 0z',
  phone: 'M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z',
};
---

<section class="section-padding-sm bg-white" aria-labelledby="contact-summary-heading">
  <div class="container-wide relative">
    <ScribbleCircle
      size={180}
      opacity={0.4}
      rotation={25}
      class="absolute top-0 left-1/2 -translate-x-1/2 z-0"
    />
    <div class="relative z-10">
      <h2
        id="contact-summary-heading"
        class="text-center font-heading font-bold text-dark"
        style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
      >
        {heading}
      </h2>

      <div class="mt-10 grid grid-cols-1 sm:grid-cols-3 gap-8 max-w-2xl mx-auto">
        {methods.map((method) => (
          <a
            href={method.href}
            class="flex flex-col items-center text-center p-6 rounded-xl hover:bg-gray-light/50 transition-colors no-underline group"
          >
            <div class="w-12 h-12 flex items-center justify-center rounded-full bg-primary/10 text-primary group-hover:bg-primary group-hover:text-white transition-colors">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={icons[method.icon]} />
              </svg>
            </div>
            <p class="mt-4 font-semibold text-dark" style="font-size: var(--text-body-sm);">
              {method.label}
            </p>
            <p class="mt-1 text-dark/60" style="font-size: var(--text-body-sm); line-height: var(--text-body-sm--line-height);">
              {method.value}
            </p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>