---
// VolunteerCTASection.astro — Warm invitation, centered
// Visual: Soft cream background, centered text, single button
// Purpose: Open door — warm, not urgent
export interface Props {
  heading: string;
  body: string;
  cta: {
    label: string;
    href: string;
  };
}

const { heading, body, cta } = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="volunteer-heading">
  <div class="container-tight text-center">
    
    <h2
      id="volunteer-heading"
      class="font-heading font-bold text-dark text-balance"
      style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
    >
      {heading}
    </h2>

    <p
      class="mt-6 text-dark/70 max-w-lg mx-auto text-balance"
      style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
    >
      {body}
    </p>

    <a
      href={cta.href}
      class="inline-flex items-center justify-center px-8 py-4 mt-8 font-semibold text-white bg-primary rounded-lg hover:bg-primary-light no-underline shadow-sm"
      style="font-size: var(--text-body-lg);"
    >
      {cta.label}
      <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
      </svg>
    </a>

  </div>
</section>