---
// PartnersSection.astro — Understated logo strip
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Partner {
  name: string;
  logo: string;
}

export interface Props {
  heading: string;
  partners: Partner[];
}

const { heading, partners } = Astro.props;
---

<section class="section-padding-sm bg-white" aria-labelledby="partners-heading">
  <div class="container-wide relative">
    <ScribbleCircle
      size={180}
      opacity={0.4}
      rotation={20}
      class="absolute top-0 left-1/2 -translate-x-1/2 z-0"
    />
    <div class="relative z-10">
      <h2
        id="partners-heading"
        class="text-center font-heading font-bold text-dark"
        style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
      >
        {heading}
      </h2>

      <div class="mt-10 flex flex-wrap justify-center items-center gap-x-12 gap-y-8 opacity-90">
        {partners.map((partner) => (
          <img
            src={partner.logo}
            alt={partner.name}
            class="h-8 md:h-10 w-auto"
            loading="lazy"
          />
        ))}
      </div>
    </div>
  </div>
</section>