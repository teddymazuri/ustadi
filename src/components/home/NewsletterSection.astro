---
// NewsletterSection.astro — Simple email capture with JS intercept
export interface Props {
  heading: string;
  subheading: string;
  formAction: string;
}

const { heading, subheading, formAction } = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="newsletter-heading">
  <div class="container-tight text-center">
    <h2
      id="newsletter-heading"
      class="font-heading font-bold text-dark"
      style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
    >
      {heading}
    </h2>

    <p
      class="mt-3 text-dark/60 max-w-md mx-auto"
      style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
    >
      {subheading}
    </p>

    <!-- Success message -->
    <div id="newsletter-success" class="hidden mt-6 bg-green-50 border-2 border-green-200 rounded-xl px-6 py-3 max-w-md mx-auto">
      <p class="text-green-700 font-semibold text-sm">Subscribed! You're on the list.</p>
    </div>

    <!-- Error message -->
    <div id="newsletter-error" class="hidden mt-6 bg-red-50 border-2 border-red-200 rounded-xl px-6 py-3 max-w-md mx-auto">
      <p class="text-red-700 font-semibold text-sm">Something went wrong. Please try again.</p>
    </div>

    <form
      class="mt-8 flex flex-col sm:flex-row gap-3 max-w-md mx-auto"
      action={formAction}
      method="POST"
      id="newsletter-form"
    >
      <label for="newsletter-email" class="sr-only">Email address</label>
      <input
        type="email"
        name="email"
        id="newsletter-email"
        placeholder="your@email.com"
        required
        autocomplete="email"
        class="flex-1 px-5 py-3 bg-white border border-gray-200 rounded-lg text-dark placeholder:text-dark/40 focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent"
        style="font-size: var(--text-body-base);"
      />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />
      <button
        type="submit"
        id="newsletter-submit-btn"
        class="px-6 py-3 font-semibold text-white bg-primary rounded-lg hover:bg-primary-light shadow-sm shrink-0"
        style="font-size: var(--text-body-base);"
      >
        Subscribe
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById('newsletter-form');
  const successMsg = document.getElementById('newsletter-success');
  const errorMsg = document.getElementById('newsletter-error');
  const submitBtn = document.getElementById('newsletter-submit-btn');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    successMsg?.classList.add('hidden');
    errorMsg?.classList.add('hidden');
    
    const originalText = submitBtn?.textContent;
    submitBtn!.textContent = 'Subscribing...';
    submitBtn!.disabled = true;

    const formData = new FormData(form);

    try {
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: {
          'Accept': 'application/json'
        }
      });

      if (response.ok) {
        form.reset();
        successMsg?.classList.remove('hidden');
      } else {
        errorMsg?.classList.remove('hidden');
      }
    } catch (err) {
      errorMsg?.classList.remove('hidden');
    } finally {
      submitBtn!.textContent = originalText;
      submitBtn!.disabled = false;
    }
  });
</script>