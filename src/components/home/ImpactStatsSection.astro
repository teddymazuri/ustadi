---
// ImpactStatsSection.astro — Cream band with large numbers
export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;

// Give each stat a unique ID for the script to target
const statsWithIds = stats.map((stat, i) => ({
  ...stat,
  id: `impact-stat-${i}`,
}));
---

<section class="section-padding bg-cream" aria-label="Our impact in numbers">
  <div class="container-wide">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 text-center">
      {statsWithIds.map((stat) => (
        <div>
          <p
            id={stat.id}
            class="font-heading font-bold text-primary"
            style="font-size: clamp(3rem, 6vw, 4.5rem); line-height: 1;"
            data-target={stat.value}
          >
            0
          </p>
          <p
            class="mt-3 text-dark/70 max-w-xs mx-auto"
            style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
          >
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function animateStats() {
    const statElements = document.querySelectorAll('[data-target]');
    
    statElements.forEach((el) => {
      const target = el.getAttribute('data-target') || '';
      // Extract the number from strings like "500,000+" or "300+"
      const numMatch = target.match(/[\d,]+/);
      if (!numMatch) return;
      
      const targetNum = parseInt(numMatch[0].replace(/,/g, ''));
      const suffix = target.replace(numMatch[0], '');
      const duration = 2000;
      const startTime = performance.now();
      
      function update(currentTime: number) {
        const elapsed = currentTime - startTime;
        const progress = Math.min(elapsed / duration, 1);
        // Ease out quad
        const eased = 1 - (1 - progress) * (1 - progress);
        const current = Math.floor(eased * targetNum);
        
        el.textContent = current.toLocaleString() + suffix;
        
        if (progress < 1) {
          requestAnimationFrame(update);
        }
      }
      
      requestAnimationFrame(update);
    });
  }

  // Use IntersectionObserver to trigger when stats come into view
  const observer = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (entry.isIntersecting) {
        animateStats();
        observer.disconnect();
      }
    });
  }, { threshold: 0.3 });

  const container = document.querySelector('[data-target]')?.closest('section');
  if (container) {
    observer.observe(container);
  } else {
    // Fallback: animate immediately
    animateStats();
  }
</script>