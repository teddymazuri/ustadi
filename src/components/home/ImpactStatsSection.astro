---
// ImpactStatsSection.astro — Cream band with large numbers
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  stats: Stat[];
}

const { stats } = Astro.props;
---

<section class="section-padding bg-cream" aria-label="Our impact in numbers">
  <div class="container-wide relative">
    <ScribbleCircle
      size={180}
      opacity={0.4}
      rotation={-25}
      class="absolute top-0 left-1/2 -translate-x-1/2 z-0"
    />
    <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 text-center relative z-10">
      {stats.map((stat) => (
        <div>
          <p
            class="font-heading font-bold text-primary"
            style="font-size: clamp(3rem, 6vw, 4.5rem); line-height: 1;"
          >
            {stat.value}
          </p>
          <p
            class="mt-3 text-dark/70 max-w-xs mx-auto"
            style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
          >
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>