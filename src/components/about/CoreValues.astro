---
// CoreValues.astro — EQUIP values arranged in a circular flow with arrows
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Value {
  letter: string;
  title: string;
  description: string;
}

export interface Props {
  heading: string;
  subheading: string;
  values: Value[];
}

const { heading, subheading, values } = Astro.props;

const getPosition = (index: number, total: number) => {
  const angle = (index / total) * 2 * Math.PI - Math.PI / 2;
  const radius = 42;
  const x = 50 + radius * Math.cos(angle);
  const y = 50 + radius * Math.sin(angle);
  return { x, y };
};

const getArrowStart = (index: number, total: number) => {
  const angle = (index / total) * 2 * Math.PI - Math.PI / 2 + Math.PI / total * 0.7;
  const radius = 42;
  const x = 50 + radius * Math.cos(angle);
  const y = 50 + radius * Math.sin(angle);
  return { x, y };
};

const getArrowEnd = (index: number, total: number) => {
  const angle = (index / total) * 2 * Math.PI - Math.PI / 2 + Math.PI / total * 1.3;
  const radius = 42;
  const x = 50 + radius * Math.cos(angle);
  const y = 50 + radius * Math.sin(angle);
  return { x, y };
};
---

<section class="section-padding bg-cream" aria-labelledby="values-heading">
  <div class="container-wide relative">
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />
    
    <div class="text-center mb-14 relative z-10">
      <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
        EQUIP Framework
      </p>
      <h2
        id="values-heading"
        class="mt-4 font-heading font-bold text-dark"
        style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
      >
        {heading}
      </h2>
      <p
        class="mt-4 max-w-xl mx-auto text-dark/70"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {subheading}
      </p>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="relative z-10">
      
      {/* Mobile: stacked list */}
      <div class="lg:hidden space-y-4">
        {values.map((value) => (
          <div class="flex gap-6 py-4 border-b border-dark/10 last:border-0">
            <span class="font-heading font-bold text-primary shrink-0" style="font-size: 2.5rem; line-height: 1;" aria-hidden="true">
              {value.letter}
            </span>
            <div>
              <h3 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm);">
                {value.title}
              </h3>
              <p class="mt-1 text-dark/60 text-sm leading-relaxed">{value.description}</p>
            </div>
          </div>
        ))}
      </div>

      {/* Desktop: circular flow */}
      <div class="hidden lg:block relative aspect-square max-w-3xl mx-auto">
        
        {/* Center label */}
        <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-36 h-36 bg-primary rounded-full flex items-center justify-center text-center z-10 shadow-xl">
          <p class="text-white font-heading font-bold text-sm px-6">EQUIP Values</p>
        </div>

        {/* Arrows between cards */}
        {values.map((value, index) => {
          const start = getArrowStart(index, values.length);
          const end = getArrowEnd(index, values.length);
          
          return (
            <svg class="absolute inset-0 w-full h-full pointer-events-none" aria-hidden="true">
              <defs>
                <marker
                  id={`arrowhead-${index}`}
                  markerWidth="12"
                  markerHeight="12"
                  refX="10"
                  refY="6"
                  orient="auto"
                  markerUnits="userSpaceOnUse"
                >
                  <path d="M 0,0 L 12,6 L 0,12 Z" fill="#F47322" />
                </marker>
              </defs>
              <line
                x1={`${start.x}%`}
                y1={`${start.y}%`}
                x2={`${end.x}%`}
                y2={`${end.y}%`}
                stroke="#F47322"
                stroke-width="2"
                stroke-linecap="round"
                marker-end={`url(#arrowhead-${index})`}
              />
            </svg>
          );
        })}

        {/* Value cards */}
        {values.map((value, index) => {
          const pos = getPosition(index, values.length);
          return (
            <div
              class="absolute w-56 text-center"
              style={`top: ${pos.y}%; left: ${pos.x}%; transform: translate(-50%, -50%);`}
            >
              <div class="bg-white rounded-2xl p-5 shadow-card hover:shadow-card-hover transition-all duration-300 group">
                <span
                  class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-primary/10 text-primary font-heading font-bold group-hover:bg-primary group-hover:text-white transition-colors"
                  style="font-size: var(--text-heading-sm);"
                >
                  {value.letter}
                </span>
                <h3 class="mt-3 font-heading font-bold text-dark" style="font-size: 1.125rem;">
                  {value.title}
                </h3>
                <p class="mt-2 text-dark/50 text-xs leading-relaxed line-clamp-2">{value.description}</p>
              </div>
            </div>
          );
        })}

      </div>

    </div>

  </div>
</section>