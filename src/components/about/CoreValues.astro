---
// CoreValues.astro — EQUIP values with large letters and hover effects
export interface Value {
  letter: string;
  title: string;
  description: string;
}

export interface Props {
  heading: string;
  subheading: string;
  values: Value[];
}

const { heading, subheading, values } = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="values-heading">
  <div class="container-wide">
    
    <div class="text-center mb-14">
      <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
        EQUIP Framework
      </p>
      <h2
        id="values-heading"
        class="mt-4 font-heading font-bold text-dark"
        style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
      >
        {heading}
      </h2>
      <p
        class="mt-4 max-w-xl mx-auto text-dark/70"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {subheading}
      </p>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-6">
      {values.map((value) => (
        <div class="relative bg-white rounded-3xl p-6 text-center shadow-card hover:shadow-card-hover transition-all duration-300 group overflow-hidden">
          {/* Decorative background letter */}
          <div class="absolute -top-4 -right-4 text-8xl font-heading font-bold text-cream select-none pointer-events-none" aria-hidden="true">
            {value.letter}
          </div>
          
          <div class="relative">
            <div class="w-14 h-14 mx-auto flex items-center justify-center rounded-2xl bg-primary/10 text-primary font-heading font-bold group-hover:bg-primary group-hover:text-white transition-colors" style="font-size: var(--text-heading-sm);">
              {value.letter}
            </div>
            <h3 class="mt-5 font-heading font-bold text-dark" style="font-size: 1.125rem;">
              {value.title}
            </h3>
            <p class="mt-3 text-dark/60" style="font-size: var(--text-body-sm); line-height: var(--text-body-sm--line-height);">
              {value.description}
            </p>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>