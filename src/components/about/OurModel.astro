---
// OurModel.astro — Three pillars with numbered steps
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Pillar {
  number: string;
  title: string;
  description: string;
}

export interface Props {
  heading: string;
  subheading: string;
  pillars: [Pillar, Pillar, Pillar];
}

const { heading, subheading, pillars } = Astro.props;
---

<section class="section-padding bg-white" aria-labelledby="model-heading">
  <div class="container-wide relative">
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-20}
      class="absolute -top-8 left-0 z-0"
    />
    
    <div class="text-center mb-14 relative z-10">
      <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
        How We Work
      </p>
      <h2
        id="model-heading"
        class="mt-4 font-heading font-bold text-dark"
        style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
      >
        {heading}
      </h2>
      <p
        class="mt-4 max-w-2xl mx-auto text-dark/70"
        style="font-size: var(--text-body-lg); line-height: var(--text-body-lg--line-height);"
      >
        {subheading}
      </p>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="grid md:grid-cols-3 gap-8 lg:gap-10 relative z-10">
      {pillars.map((pillar, index) => (
        <div class="relative group">
          {index < pillars.length - 1 && (
            <div class="hidden md:block absolute top-12 left-[calc(100%-0.5rem)] w-10 h-px bg-accent/40" aria-hidden="true"></div>
          )}

          <div class="relative bg-cream rounded-3xl p-8 h-full overflow-hidden shadow-card hover:shadow-card-hover transition-shadow">
            <span
              class="absolute -bottom-4 -right-2 text-9xl font-heading font-bold text-primary/5 select-none pointer-events-none leading-none"
              aria-hidden="true"
            >
              {pillar.number}
            </span>
            
            <div class="relative">
              <div class="w-12 h-12 flex items-center justify-center rounded-2xl bg-primary text-white mb-5 font-heading font-bold" style="font-size: var(--text-heading-sm);">
                {pillar.number}
              </div>
              
              <h3
                class="font-heading font-bold text-dark"
                style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
              >
                {pillar.title}
              </h3>
              <p
                class="mt-4 text-dark/70 leading-relaxed"
                style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
              >
                {pillar.description}
              </p>
            </div>
          </div>
        </div>
      ))}
    </div>

  </div>
</section>