---
// DonorRecognition.astro — Donor logo grid with acknowledgement
// Visual: Muted logo grid with introductory text
export interface Donor {
  name: string;
  logo: string;
}

export interface Props {
  heading: string;
  subheading: string;
  donors: Donor[];
}

const { heading, subheading, donors } = Astro.props;
---

<section class="section-padding-sm bg-white" aria-labelledby="donors-heading">
  <div class="container-wide">
    
    <h2
      id="donors-heading"
      class="text-center font-heading font-bold text-dark"
      style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
    >
      {heading}
    </h2>
    <p
      class="mt-3 text-center text-dark/60 max-w-lg mx-auto"
      style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
    >
      {subheading}
    </p>

    <div class="mt-10 flex flex-wrap justify-center items-center gap-x-10 gap-y-6 opacity-50">
      {donors.map((donor) => (
        <img
          src={donor.logo}
          alt={donor.name}
          class="h-8 md:h-10 w-auto grayscale"
          loading="lazy"
        />
      ))}
    </div>

  </div>
</section>