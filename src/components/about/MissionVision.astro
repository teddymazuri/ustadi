---
// MissionVision.astro — Vision and Mission with visual distinction
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Props {
  vision: {
    heading: string;
    body: string;
  };
  mission: {
    heading: string;
    body: string;
  };
}

const { vision, mission } = Astro.props;
---

<section class="section-padding bg-white" aria-label="Vision and Mission">
  <div class="container-wide">
    
    <div class="text-center mb-16 relative">
      <ScribbleCircle
        size={200}
        opacity={0.4}
        rotation={-10}
        class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
      />
      <p class="text-accent font-semibold tracking-wider uppercase relative z-10" style="font-size: var(--text-body-sm);">
        Our Purpose
      </p>
      <h2 class="mt-4 font-heading font-bold text-dark relative z-10" style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);">
        Why We Exist
      </h2>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto relative z-10" aria-hidden="true"></div>
    </div>

    <div class="grid md:grid-cols-2 gap-8 lg:gap-12">
      
      {/* Vision */}
      <div class="relative bg-cream rounded-3xl p-8 lg:p-10 overflow-hidden group">
        <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-primary/5 group-hover:bg-primary/10 transition-colors" aria-hidden="true"></div>
        <div class="absolute -bottom-6 -left-6 w-24 h-24 rounded-full bg-accent/10" aria-hidden="true"></div>
        
        <div class="relative">
          <div class="w-14 h-14 flex items-center justify-center rounded-2xl bg-primary/10 text-primary mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z" />
            </svg>
          </div>

          <h3 class="font-heading font-bold text-dark" style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);">
            {vision.heading}
          </h3>
          <div class="mt-4 w-12 h-0.5 bg-accent rounded-full" aria-hidden="true"></div>
          <p class="mt-5 text-dark/70 leading-relaxed" style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);">
            {vision.body}
          </p>
        </div>
      </div>

      {/* Mission */}
      <div class="relative bg-primary rounded-3xl p-8 lg:p-10 overflow-hidden group">
        <div class="absolute -top-10 -right-10 w-40 h-40 rounded-full bg-white/5 group-hover:bg-white/10 transition-colors" aria-hidden="true"></div>
        <div class="absolute -bottom-6 -left-6 w-24 h-24 rounded-full bg-accent/20" aria-hidden="true"></div>

        <div class="relative">
          <div class="w-14 h-14 flex items-center justify-center rounded-2xl bg-accent text-dark mb-6">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
            </svg>
          </div>

          <h3 class="font-heading font-bold text-white" style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);">
            {mission.heading}
          </h3>
          <div class="mt-4 w-12 h-0.5 bg-accent rounded-full" aria-hidden="true"></div>
          <p class="mt-5 text-white/80 leading-relaxed" style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);">
            {mission.body}
          </p>
        </div>
      </div>

    </div>

  </div>
</section>