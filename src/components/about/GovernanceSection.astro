---
// GovernanceSection.astro — Corporate org chart
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Props {
  heading: string;
  board: {
    heading: string;
    description: string;
    members: string;
  };
  management: {
    heading: string;
    description: string;
    roles: string[];
  };
}

const { heading, board, management } = Astro.props;

// Extract CEO from roles — assumed first role is CEO
const ceo = management.roles[0] || 'Chief Executive Officer and Team Leader';
const heads = management.roles.slice(1);
---

<section class="section-padding bg-white" aria-labelledby="governance-heading">
  <div class="container-wide relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="text-center mb-16 relative z-10">
      <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
        Our Structure
      </p>
      <h2
        id="governance-heading"
        class="mt-4 font-heading font-bold text-dark"
        style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
      >
        {heading}
      </h2>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto">
      
      {/* Board of Directors */}
      <div class="flex justify-center">
        <div class="bg-primary rounded-2xl px-10 py-6 text-center shadow-lg w-72">
          <div class="w-12 h-12 mx-auto flex items-center justify-center rounded-full bg-white/20 text-white mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="font-heading font-bold text-white" style="font-size: var(--text-heading-sm); line-height: 1.3;">
            {board.heading}
          </p>
          <p class="mt-2 text-white/60 text-sm">{board.members}</p>
        </div>
      </div>

      {/* Vertical line Board → CEO */}
      <div class="flex justify-center py-4">
        <div class="w-px h-10 bg-dark/20" aria-hidden="true"></div>
      </div>

      {/* CEO */}
      <div class="flex justify-center">
        <div class="bg-cream rounded-2xl px-10 py-5 text-center shadow-card border-2 border-accent/30 w-80">
          <p class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: 1.3;">
            {ceo}
          </p>
          <p class="mt-1 text-dark/50 text-xs tracking-wide uppercase">Chief Executive Officer</p>
        </div>
      </div>

      {/* Vertical line CEO → Heads */}
      <div class="flex justify-center py-4">
        <div class="w-px h-10 bg-dark/20" aria-hidden="true"></div>
      </div>

      {/* Horizontal spread line */}
      <div class="hidden md:block h-px bg-dark/20 mx-24" aria-hidden="true"></div>

      {/* Department Heads */}
      <div class="grid md:grid-cols-3 gap-6 mt-8 md:mt-0">
        {heads.map((head) => (
          <div class="text-center">
            {/* Vertical line up */}
            <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mb-4" aria-hidden="true"></div>
            <div class="bg-white rounded-2xl px-6 py-5 shadow-card hover:shadow-card-hover transition-shadow h-full">
              <div class="w-10 h-10 mx-auto flex items-center justify-center rounded-full bg-accent/10 text-accent mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <p class="text-dark/80 text-sm font-semibold leading-snug">{head}</p>
            </div>
          </div>
        ))}
      </div>

        {/* Management description */}
        <div class="mt-16 text-center">
            <div class="max-w-xl mx-auto bg-cream rounded-2xl px-8 py-6">
            <p class="text-dark/50 text-sm leading-relaxed">
                {management.description}
            </p>
            </div>
        </div>

    </div>

  </div>
</section>