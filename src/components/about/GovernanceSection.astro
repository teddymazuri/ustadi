---
// GovernanceSection.astro — Board and management structure
// Visual: Clean layout with distinct sections for board and management
export interface Props {
  heading: string;
  board: {
    heading: string;
    description: string;
    members: string;
  };
  management: {
    heading: string;
    description: string;
    roles: string[];
  };
}

const { heading, board, management } = Astro.props;
---

<section class="section-padding bg-cream" aria-labelledby="governance-heading">
  <div class="container-tight">
    
    <h2
      id="governance-heading"
      class="text-center font-heading font-bold text-dark"
      style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
    >
      {heading}
    </h2>
    <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>

    <div class="mt-14 grid md:grid-cols-2 gap-10">
      
      {/* Board */}
      <div class="bg-white rounded-2xl p-8 shadow-card">
        <div class="w-10 h-10 flex items-center justify-center rounded-full bg-accent/10 text-accent mb-5" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>
        </div>
        <h3
          class="font-heading font-bold text-dark"
          style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
        >
          {board.heading}
        </h3>
        <p
          class="mt-3 text-dark/70"
          style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
        >
          {board.description}
        </p>
        <div class="mt-5 pt-5 border-t border-gray-light">
          <p
            class="font-semibold text-dark"
            style="font-size: var(--text-body-sm);"
          >
            Current composition
          </p>
          <p
            class="mt-1 text-dark/60"
            style="font-size: var(--text-body-sm); line-height: var(--text-body-sm--line-height);"
          >
            {board.members}
          </p>
        </div>
      </div>

      {/* Management */}
      <div class="bg-white rounded-2xl p-8 shadow-card">
        <div class="w-10 h-10 flex items-center justify-center rounded-full bg-primary/10 text-primary mb-5" aria-hidden="true">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
          </svg>
        </div>
        <h3
          class="font-heading font-bold text-dark"
          style="font-size: var(--text-heading-sm); line-height: var(--text-heading-sm--line-height);"
        >
          {management.heading}
        </h3>
        <p
          class="mt-3 text-dark/70"
          style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
        >
          {management.description}
        </p>
        <div class="mt-5 pt-5 border-t border-gray-light">
          <p
            class="font-semibold text-dark"
            style="font-size: var(--text-body-sm);"
          >
            Key roles
          </p>
          <ul class="mt-1 space-y-1" role="list">
            {management.roles.map((role) => (
              <li
                class="text-dark/60"
                style="font-size: var(--text-body-sm); line-height: var(--text-body-sm--line-height);"
              >
                {role}
              </li>
            ))}
          </ul>
        </div>
      </div>

    </div>

  </div>
</section>