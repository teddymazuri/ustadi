---
// GovernanceSection.astro — Corporate org chart with photos and bio modals
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Person {
  name: string;
  title?: string;
  photo?: string;
  bio?: string;
  slug?: string;
}

export interface Props {
  heading: string;
  board: {
    heading: string;
    description: string;
    members: Person[];
  };
  management: {
    heading: string;
    description: string;
    ceo: Person;
    heads: Person[];
  };
}

const { heading, board, management } = Astro.props;

const allPeople = [
  ...board.members,
  management.ceo,
  ...management.heads,
];

const peopleJson = JSON.stringify(allPeople);
---

<section class="section-padding bg-white" aria-labelledby="governance-heading">
  <div class="container-wide relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="text-center mb-16 relative z-10">
      <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
        Our Structure
      </p>
      <h2
        id="governance-heading"
        class="mt-4 font-heading font-bold text-dark"
        style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
      >
        {heading}
      </h2>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 max-w-5xl mx-auto">
      
      {/* Board of Directors */}
      <div class="flex justify-center">
        <div class="bg-primary rounded-2xl px-8 py-8 text-center shadow-lg w-full">
          <div class="w-12 h-12 mx-auto flex items-center justify-center rounded-full bg-white/20 text-white mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="font-heading font-bold text-white" style="font-size: var(--text-heading-sm); line-height: 1.3;">
            {board.heading}
          </p>

          {/* Board members as clickable photo cards */}
          <div class="mt-6 grid grid-cols-2 md:grid-cols-4 gap-4">
            {board.members.map((member, idx) => (
              <button
                type="button"
                class="group bg-white/10 hover:bg-white/20 rounded-2xl p-4 transition-colors cursor-pointer text-center border border-white/10"
                onclick={`window.openPersonModal && window.openPersonModal(${idx})`}
                aria-label={`View bio for ${member.name}`}
              >
                <div class="relative w-20 h-20 mx-auto mb-3 rounded-full overflow-hidden ring-2 ring-white/30 group-hover:ring-accent transition-all">
                  {member.photo ? (
                    <img
                      src={member.photo}
                      alt={member.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-white/20 flex items-center justify-center text-white text-xl font-heading font-bold">
                      {member.name.charAt(0)}
                    </div>
                  )}
                </div>
                <p class="text-white text-sm font-semibold leading-tight">{member.name}</p>
                {member.title && (
                  <p class="text-white/50 text-xs mt-1">{member.title}</p>
                )}
              </button>
            ))}
          </div>
        </div>
      </div>

      {/* Vertical line Board → CEO */}
      <div class="flex justify-center py-4">
        <div class="w-px h-10 bg-dark/20" aria-hidden="true"></div>
      </div>

      {/* CEO */}
      <div class="flex justify-center">
        <button
          type="button"
          class="bg-cream rounded-2xl px-8 py-6 text-center shadow-card border-2 border-accent/30 w-full max-w-sm cursor-pointer hover:shadow-card-hover hover:border-accent transition-all group"
          onclick={`window.openPersonModal && window.openPersonModal(${board.members.length})`}
          aria-label={`View bio for ${management.ceo.name}`}
        >
          <div class="relative w-24 h-24 mx-auto mb-3 rounded-full overflow-hidden ring-2 ring-accent/30 group-hover:ring-accent transition-all">
            {management.ceo.photo ? (
              <img
                src={management.ceo.photo}
                alt={management.ceo.name}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full bg-accent/20 flex items-center justify-center text-dark text-2xl font-heading font-bold">
                {management.ceo.name.charAt(0)}
              </div>
            )}
          </div>
          <p class="text-dark/50 text-xs tracking-wide uppercase mb-1">Chief Executive Officer & Team Leader</p>
          <p class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: 1.3;">
            {management.ceo.name}
          </p>
        </button>
      </div>

      {/* Vertical line CEO → Heads */}
      <div class="flex justify-center py-4">
        <div class="w-px h-10 bg-dark/20" aria-hidden="true"></div>
      </div>

      {/* Horizontal spread line */}
      <div class="hidden md:block h-px bg-dark/20 mx-16" aria-hidden="true"></div>

      {/* Department Heads */}
      <div class="grid md:grid-cols-3 gap-6 mt-8 md:mt-0">
        {management.heads.slice(0, 3).map((head, i) => {
          const personIndex = board.members.length + 1 + i;
          return (
            <div class="text-center">
              <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mb-4" aria-hidden="true"></div>
              <button
                type="button"
                class="w-full bg-white rounded-2xl px-6 py-5 shadow-card hover:shadow-card-hover transition-shadow h-full cursor-pointer group"
                onclick={`window.openPersonModal && window.openPersonModal(${personIndex})`}
                aria-label={`View bio for ${head.name}`}
              >
                <div class="relative w-20 h-20 mx-auto mb-3 rounded-full overflow-hidden ring-2 ring-accent/20 group-hover:ring-accent transition-all">
                  {head.photo ? (
                    <img
                      src={head.photo}
                      alt={head.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-accent/10 flex items-center justify-center text-accent text-xl font-heading font-bold">
                      {head.name.charAt(0)}
                    </div>
                  )}
                </div>
                <p class="text-dark/50 text-xs tracking-wide uppercase mb-2">{head.title}</p>
                <p class="text-dark/80 text-sm font-semibold leading-snug">{head.name}</p>
              </button>
            </div>
          );
        })}
      </div>

      {/* Regional Coordinators */}
      <div class="grid md:grid-cols-2 gap-6 max-w-2xl mx-auto mt-8">
        {management.heads.slice(3).map((head, i) => {
          const personIndex = board.members.length + 4 + i;
          return (
            <div class="text-center">
              <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mb-4" aria-hidden="true"></div>
              <button
                type="button"
                class="w-full bg-white rounded-2xl px-6 py-5 shadow-card hover:shadow-card-hover transition-shadow h-full cursor-pointer group"
                onclick={`window.openPersonModal && window.openPersonModal(${personIndex})`}
                aria-label={`View bio for ${head.name}`}
              >
                <div class="relative w-20 h-20 mx-auto mb-3 rounded-full overflow-hidden ring-2 ring-accent/20 group-hover:ring-accent transition-all">
                  {head.photo ? (
                    <img
                      src={head.photo}
                      alt={head.name}
                      class="w-full h-full object-cover"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-accent/10 flex items-center justify-center text-accent text-xl font-heading font-bold">
                      {head.name.charAt(0)}
                    </div>
                  )}
                </div>
                <p class="text-dark/50 text-xs tracking-wide uppercase mb-2">{head.title}</p>
                <p class="text-dark/80 text-sm font-semibold leading-snug">{head.name}</p>
              </button>
            </div>
          );
        })}
      </div>

      {/* Management description */}
      <div class="mt-16 text-center">
        <div class="max-w-xl mx-auto bg-cream rounded-2xl px-8 py-6">
          <p class="text-dark/50 text-sm leading-relaxed">
            {management.description}
          </p>
        </div>
      </div>

    </div>

  </div>

  <!-- Person Bio Modal -->
  <dialog
    id="person-modal"
    class="fixed inset-0 z-50 w-full h-full max-w-none max-h-none m-0 p-0 bg-dark/95 backdrop-blur-sm"
    aria-label="Team member biography"
  >
    <div class="flex flex-col h-full relative">
      <!-- Header -->
      <div class="flex items-center justify-between px-6 py-4 bg-dark/50 shrink-0">
        <p class="text-accent text-xs font-semibold tracking-wider uppercase">Team Member</p>
        <button
          type="button"
          id="person-modal-close"
          class="w-10 h-10 flex items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 transition-colors"
          aria-label="Close bio"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>
      </div>

      <!-- Content -->
      <div class="flex-1 overflow-y-auto">
        <div class="max-w-2xl mx-auto px-6 py-8 md:py-12">
          <!-- Photo -->
          <div class="w-40 h-40 md:w-48 md:h-48 mx-auto rounded-full overflow-hidden ring-4 ring-accent/30 shadow-2xl">
            <img id="person-modal-photo" src="" alt="" class="w-full h-full object-cover" />
          </div>

          <!-- Name + Title -->
          <h2
            id="person-modal-name"
            class="mt-8 font-heading font-bold text-white text-center"
            style="font-size: var(--text-heading-md); line-height: var(--text-heading-md--line-height);"
          ></h2>
          <p id="person-modal-title" class="mt-2 text-accent text-center text-sm font-semibold tracking-wider uppercase"></p>

          <!-- Bio -->
          <div
            id="person-modal-bio"
            class="mt-8 text-white/80 leading-relaxed space-y-4 text-center"
            style="font-size: var(--text-body-base); line-height: var(--text-body-base--line-height);"
          ></div>
        </div>
      </div>
    </div>
  </dialog>

  <script set:html={`window.__people = ${peopleJson};`} />

  <script>
    const peopleData = window.__people;

    function openPersonModal(index: number) {
      const person = peopleData[index];
      if (!person) return;

      const photoEl = document.getElementById('person-modal-photo');
      const nameEl = document.getElementById('person-modal-name');
      const titleEl = document.getElementById('person-modal-title');
      const bioEl = document.getElementById('person-modal-bio');

      // Photo — fallback to initial if no photo
      if (person.photo) {
        photoEl.src = person.photo;
        photoEl.alt = person.name;
        photoEl.style.display = 'block';
        photoEl.parentElement.querySelector('.initial-fallback')?.remove();
      } else {
        photoEl.style.display = 'none';
        // Create fallback initial
        const parent = photoEl.parentElement;
        if (!parent.querySelector('.initial-fallback')) {
          const fallback = document.createElement('div');
          fallback.className = 'initial-fallback w-full h-full bg-accent/20 flex items-center justify-center text-white text-5xl font-heading font-bold';
          fallback.textContent = person.name.charAt(0);
          parent.appendChild(fallback);
        }
      }

      nameEl.textContent = person.name;
      titleEl.textContent = person.title || '';

      // Bio
      bioEl.innerHTML = '';
      if (person.bio) {
        person.bio.split('\n\n').forEach((paragraph) => {
          const p = document.createElement('p');
          p.textContent = paragraph;
          bioEl.appendChild(p);
        });
      } else {
        const p = document.createElement('p');
        p.textContent = 'Biography coming soon.';
        p.className = 'italic text-white/50';
        bioEl.appendChild(p);
      }

      document.getElementById('person-modal').showModal();
      document.body.style.overflow = 'hidden';
    }

    function closePersonModal() {
      document.getElementById('person-modal').close();
      document.body.style.overflow = '';
    }

    document.addEventListener('DOMContentLoaded', () => {
      document.getElementById('person-modal-close').addEventListener('click', closePersonModal);

      document.addEventListener('keydown', (e) => {
        const dialog = document.getElementById('person-modal');
        if (!dialog || !dialog.open) return;
        if (e.key === 'Escape') closePersonModal();
      });

      document.getElementById('person-modal').addEventListener('click', (e) => {
        if (e.target === e.currentTarget) closePersonModal();
      });

      window.openPersonModal = openPersonModal;
    });
  </script>
</section>