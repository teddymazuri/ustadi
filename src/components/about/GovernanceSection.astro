---
// GovernanceSection.astro — Corporate org chart with named individuals
import ScribbleCircle from '../shared/ScribbleCircle.astro';

export interface Props {
  heading: string;
  board: {
    heading: string;
    description: string;
    members: {
      name: string;
      title?: string;
    }[];
  };
  management: {
    heading: string;
    description: string;
    ceo: {
      name: string;
    };
    heads: {
      title: string;
      name: string;
    }[];
  };
}

const { heading, board, management } = Astro.props;
---

<section class="section-padding bg-white" aria-labelledby="governance-heading">
  <div class="container-wide relative">
    
    <ScribbleCircle
      size={200}
      opacity={0.45}
      rotation={-10}
      class="absolute -top-10 left-1/2 -translate-x-1/2 z-0"
    />

    <div class="text-center mb-16 relative z-10">
      <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
        Our Structure
      </p>
      <h2
        id="governance-heading"
        class="mt-4 font-heading font-bold text-dark"
        style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
      >
        {heading}
      </h2>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="relative z-10 max-w-4xl mx-auto">
      
      {/* Board of Directors */}
      <div class="flex justify-center">
        <div class="bg-primary rounded-2xl px-10 py-6 text-center shadow-lg w-full max-w-lg">
          <div class="w-12 h-12 mx-auto flex items-center justify-center rounded-full bg-white/20 text-white mb-3">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <p class="font-heading font-bold text-white" style="font-size: var(--text-heading-sm); line-height: 1.3;">
            {board.heading}
          </p>
          <div class="mt-4 space-y-2">
            {board.members.map((member) => (
              <div class="bg-white/10 rounded-lg px-4 py-2">
                <p class="text-white/90 text-sm font-semibold">{member.name}</p>
                {member.title && (
                  <p class="text-white/50 text-xs mt-0.5">{member.title}</p>
                )}
              </div>
            ))}
          </div>
        </div>
      </div>

      {/* Vertical line Board → CEO */}
      <div class="flex justify-center py-4">
        <div class="w-px h-10 bg-dark/20" aria-hidden="true"></div>
      </div>

      {/* CEO */}
      <div class="flex justify-center">
        <div class="bg-cream rounded-2xl px-10 py-5 text-center shadow-card border-2 border-accent/30 w-full max-w-sm">
          <p class="text-dark/50 text-xs tracking-wide uppercase mb-2">Chief Executive Officer & Team Leader</p>
          <p class="font-heading font-bold text-dark" style="font-size: var(--text-heading-sm); line-height: 1.3;">
            {management.ceo.name}
          </p>
        </div>
      </div>

      {/* Vertical line CEO → Heads */}
      <div class="flex justify-center py-4">
        <div class="w-px h-10 bg-dark/20" aria-hidden="true"></div>
      </div>

      {/* Horizontal spread line */}
      <div class="hidden md:block h-px bg-dark/20 mx-16" aria-hidden="true"></div>

      {/* Department Heads */}
      <div class="grid md:grid-cols-3 gap-6 mt-8 md:mt-0">
        {management.heads.slice(0, 3).map((head) => (
          <div class="text-center">
            <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mb-4" aria-hidden="true"></div>
            <div class="bg-white rounded-2xl px-6 py-5 shadow-card hover:shadow-card-hover transition-shadow h-full">
              <div class="w-10 h-10 mx-auto flex items-center justify-center rounded-full bg-accent/10 text-accent mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
              </div>
              <p class="text-dark/50 text-xs tracking-wide uppercase mb-2">{head.title}</p>
              <p class="text-dark/80 text-sm font-semibold leading-snug">{head.name}</p>
            </div>
          </div>
        ))}
      </div>

      {/* Regional Coordinators */}
      <div class="grid md:grid-cols-2 gap-6 max-w-2xl mx-auto mt-8">
        {management.heads.slice(3).map((head) => (
          <div class="text-center">
            <div class="hidden md:block w-px h-8 bg-dark/20 mx-auto mb-4" aria-hidden="true"></div>
            <div class="bg-white rounded-2xl px-6 py-5 shadow-card hover:shadow-card-hover transition-shadow h-full">
              <div class="w-10 h-10 mx-auto flex items-center justify-center rounded-full bg-accent/10 text-accent mb-3">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                </svg>
              </div>
              <p class="text-dark/50 text-xs tracking-wide uppercase mb-2">{head.title}</p>
              <p class="text-dark/80 text-sm font-semibold leading-snug">{head.name}</p>
            </div>
          </div>
        ))}
      </div>

      {/* Management description */}
      <div class="mt-16 text-center">
        <div class="max-w-xl mx-auto bg-cream rounded-2xl px-8 py-6">
          <p class="text-dark/50 text-sm leading-relaxed">
            {management.description}
          </p>
        </div>
      </div>

    </div>

  </div>
</section>