---
// TargetGroups.astro — Beneficiary groups with icons and hover effects
export interface Group {
  title: string;
  icon: string;
}

export interface Props {
  heading: string;
  groups: Group[];
}

const { heading, groups } = Astro.props;

const iconPaths: Record<string, string> = {
  users: 'M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z',
  building: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  briefcase: 'M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z',
  academic: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14zm-4 6v-7.5l4-2.222',
  globe: 'M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  office: 'M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z',
  heart: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
};

const defaultIcon = 'M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z';
---

<section class="section-padding bg-white" aria-labelledby="target-heading">
  <div class="container-wide">
    
    <div class="text-center mb-14">
      <p class="text-accent font-semibold tracking-wider uppercase" style="font-size: var(--text-body-sm);">
        Our Reach
      </p>
      <h2
        id="target-heading"
        class="mt-4 font-heading font-bold text-dark"
        style="font-size: var(--text-heading-lg); line-height: var(--text-heading-lg--line-height);"
      >
        {heading}
      </h2>
      <div class="mt-6 w-16 h-1 bg-accent rounded-full mx-auto" aria-hidden="true"></div>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-4 max-w-5xl mx-auto">
      {groups.map((group) => (
        <div class="flex items-center gap-4 bg-cream rounded-2xl p-5 hover:bg-white hover:shadow-card transition-all duration-300 group cursor-default">
          <div class="w-12 h-12 flex items-center justify-center rounded-xl bg-white text-primary group-hover:bg-primary group-hover:text-white transition-colors shadow-sm shrink-0" aria-hidden="true">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={iconPaths[group.icon] || defaultIcon} />
            </svg>
          </div>
          <span class="font-medium text-dark group-hover:text-primary transition-colors" style="font-size: var(--text-body-base);">
            {group.title}
          </span>
        </div>
      ))}
    </div>

  </div>
</section>